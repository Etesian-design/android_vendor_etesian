<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The N9 light page; no dynamic colour, no night variant on purpose. -->
    <style name="Theme.EtesianFeeds" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">etesian-text</item>
        <item name="android:colorPrimary">#FFFF8600</item>
        <item name="android:colorAccent">#FFFF8600</item>
        <item name="android:colorControlActivated">#FFFF8600</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <!-- The pages Feeds shows over Etesian settings (ConnectionsActivity, IgnoredActivity): black, as Settings is. -->
    <style name="Theme.EtesianFeeds.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">etesian-text</item>
        <item name="android:colorPrimary">#FF00A5E5</item>
        <item name="android:colorAccent">#FF00A5E5</item>
        <item name="android:colorControlActivated">#FF00A5E5</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
