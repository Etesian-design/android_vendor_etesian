                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_service" />
        </service>



        <activity
            android:name=".ToolbarSettingsActivity"
            android:exported="false"
            android:label="Toolbar buttons"
            android:theme="@style/Theme.EtesianSettings" />

        <!-- Runs the user's toolbar buttons when SystemUI (and only SystemUI) asks. -->
        <!-- Device tests only (am broadcast -n as root): posts silent sample notifications. -->
        <!-- Android extras → share sheet: the chooser while its switch is on (ShareActivity.sync). -->
        <!-- Android extras → Share network: the Wi-Fi QR sheet. -->
        <activity
            android:name=".PrivateCodeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".WifiShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Share network"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Android extras → Emergency information: the card over the lock screen (SystemUI opens it). -->
        <activity
            android:name=".EmergencyCardActivity"
            android:exported="true"
            android:showWhenLocked="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.bompotis.etesian.launcher.emergency"
            android:label="Emergency information"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Android extras → Keep dismissed notifications: the Earlier page. -->
        <activity
            android:name=".EarlierActivity"
            android:exported="false"
            android:label="Earlier"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity
            android:name=".ShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:finishOnCloseSystemDialogs="true"
            android:documentLaunchMode="never"
            android:relinquishTaskIdentity="true"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity-alias
            android:name=".ShareChooser"
            android:targetActivity=".ShareActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter android:priority="600">
                <action android:name="android.intent.action.CHOOSER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.VOICE" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ModeSettingsActivity"
            android:exported="false"
            android:label="Mode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <receiver
            android:name=".TestNotifyReceiver"
            android:exported="false" />
        <receiver
            android:name=".ToolbarRunReceiver"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR_SERVICE">
            <intent-filter>
                <action android:name="com.bompotis.etesian.launcher.TOOLBAR_RUN" />
            </intent-filter>
        </receiver>

        <!-- The processed background wallpapers, for the other apps to show (read-only). -->
        <provider
            android:name=".BackgroundsProvider"
            android:authorities="com.bompotis.etesian.launcher.backgrounds"
            android:exported="true" />


        <service
            android:name=".EventsService"
            android:exported="false"
