<?xml version="1.0" encoding="utf-8"?>
<!-- N9 switch knob (mock 20): a white disc inset in the track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="30dp" android:height="30dp">
        <shape android:shape="oval"><solid android:color="#00000000"/></shape>
    </item>
    <item android:width="26dp" android:height="26dp" android:gravity="center">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF"/><stroke android:width="1dp" android:color="#FF9A9A9A"/></shape>
    </item>
</layer-list>
