<?xml version="1.0" encoding="utf-8"?>
<!-- Belle flip clock tile: black, lit from the top, a dark rim and a soft drop below. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp"><shape><solid android:color="#66000000"/><corners android:radius="16dp"/></shape></item>
    <item android:bottom="3dp"><shape>
        <gradient android:angle="270" android:startColor="#FF2C2D31" android:centerColor="#FF111214" android:endColor="#FF000000"/>
        <corners android:radius="16dp"/><stroke android:width="1.5dp" android:color="#FF000000"/></shape></item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="40dp"><shape>
        <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF"/>
        <corners android:topLeftRadius="14dp" android:topRightRadius="14dp"/></shape></item>
</layer-list>
