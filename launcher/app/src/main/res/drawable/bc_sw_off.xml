<?xml version="1.0" encoding="utf-8"?>
<!-- Belle 1×1 switch, off (belle-ref7/9): brushed grey squircle in a dark rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp"><shape><solid android:color="#99000000"/><corners android:radius="24dp"/></shape></item>
    <item android:bottom="3dp"><shape><gradient android:angle="270" android:startColor="#FF6C6E73" android:endColor="#FF2E2F33"/>
        <corners android:radius="24dp"/></shape></item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="8dp"><shape>
        <gradient android:angle="270" android:startColor="#FFC4C6CB" android:centerColor="#FF9C9EA3" android:endColor="#FF7E8085"/>
        <corners android:radius="20dp"/><stroke android:width="1dp" android:color="#FFDADCE0"/></shape></item>
</layer-list>
