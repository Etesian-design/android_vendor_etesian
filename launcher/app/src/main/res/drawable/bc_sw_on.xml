<?xml version="1.0" encoding="utf-8"?>
<!-- Belle 1×1 switch, on: the same squircle with the blue glow under its rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><gradient android:angle="270" android:startColor="#FF1C4F8E" android:centerColor="#FF2F7FD6" android:endColor="#FF6FB8FF"/>
        <corners android:radius="24dp"/></shape></item>
    <item android:left="2dp" android:top="1dp" android:right="2dp" android:bottom="6dp"><shape>
        <gradient android:angle="270" android:startColor="#FF6C6E73" android:endColor="#FF2E2F33"/><corners android:radius="22dp"/></shape></item>
    <item android:left="5dp" android:top="4dp" android:right="5dp" android:bottom="10dp"><shape>
        <gradient android:angle="270" android:startColor="#FFC4C6CB" android:centerColor="#FF9C9EA3" android:endColor="#FF7E8085"/>
        <corners android:radius="19dp"/><stroke android:width="1dp" android:color="#FFDADCE0"/></shape></item>
</layer-list>
