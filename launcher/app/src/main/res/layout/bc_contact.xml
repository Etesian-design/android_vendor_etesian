<?xml version="1.0" encoding="utf-8"?>
<!-- Belle contact shortcut (belle-ref3.jpg): the photo, the name on a dark strip at the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bc_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bc_photo_frame">
    <ImageView android:id="@+id/bc_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <TextView android:id="@+id/bc_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:background="@drawable/bc_name_strip" android:ellipsize="end" android:maxLines="1" android:paddingStart="10dp"
        android:paddingTop="6dp" android:paddingBottom="7dp" android:text="Contact" android:textColor="#FFFFFFFF" android:textSize="18sp" android:fontFamily="etesian-text"/>
</FrameLayout>
