<?xml version="1.0" encoding="utf-8"?>
<!-- One post in the Feeds widget's list: the title, then the feed and how long ago. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/belle_item"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <TextView
        android:id="@+id/belle_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="etesian-text"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/belle_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="etesian-text"
        android:maxLines="1"
        android:textColor="#FF8C8C8C"
        android:textSize="12sp" />
</LinearLayout>
