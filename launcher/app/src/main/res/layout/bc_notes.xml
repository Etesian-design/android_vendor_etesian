<?xml version="1.0" encoding="utf-8"?>
<!-- Belle Notes (belle-ref9.jpg): yellow paper, title and time, the note; ▲ ▼ + 🗑 under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bc_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/bc_paper" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/bc_note_paper" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Notes"
                android:textColor="#FF1A1A1A" android:textSize="22sp" android:textStyle="bold" android:fontFamily="etesian-text"/>
            <TextView android:id="@+id/bc_when" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFE07A12" android:textSize="15sp" android:fontFamily="etesian-text"/>
        </LinearLayout>
        <TextView android:id="@+id/bc_text" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="6dp"
            android:ellipsize="end" android:lineSpacingExtra="2dp" android:textColor="#FF3A3A3A" android:textSize="18sp" android:fontFamily="etesian-text"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        android:background="@drawable/bc_note_bar" android:orientation="horizontal">
        <ImageView android:id="@+id/bc_up" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="10dp"
            android:src="@drawable/bc_glyph_up" android:tint="#FF8A8B90" android:contentDescription="Previous note"/>
        <ImageView android:id="@+id/bc_down" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="10dp"
            android:src="@drawable/bc_glyph_down" android:tint="#FF8A8B90" android:contentDescription="Next note"/>
        <ImageView android:id="@+id/bc_add" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="9dp"
            android:src="@drawable/bc_glyph_plus" android:contentDescription="New note"/>
        <ImageView android:id="@+id/bc_delete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="9dp"
            android:src="@drawable/bc_glyph_trash" android:contentDescription="Delete note"/>
    </LinearLayout>
</LinearLayout>
