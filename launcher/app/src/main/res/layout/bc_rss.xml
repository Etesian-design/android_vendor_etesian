<?xml version="1.0" encoding="utf-8"?>
<!-- Belle RSS widget for one site (belle-ref8.jpg): orange header with the site name and time,
     a round refresh arrow; white rows with orange dot bullets and thin rules, up to 20 posts that scroll (as Belle's rsswidget3; bc_rss_item). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bc_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/bc_header" android:layout_width="match_parent" android:layout_height="52dp" android:background="@drawable/bc_rss_header"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/bc_site" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end"
                android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:fontFamily="etesian-text"
                android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="1"/>
            <TextView android:id="@+id/bc_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF" android:textSize="13sp" android:fontFamily="etesian-text"/>
        </LinearLayout>
        <ImageView android:id="@+id/bc_refresh" android:layout_width="52dp" android:layout_height="match_parent" android:padding="12dp"
            android:src="@drawable/bc_glyph_refresh" android:contentDescription="Refresh"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bc_white_body"
        android:paddingBottom="4dp">
        <TextView android:id="@+id/bc_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:text="No posts yet" android:textColor="#FF6E6E73" android:textSize="16sp" android:fontFamily="etesian-text"/>
        <ListView android:id="@+id/bc_items" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@drawable/bc_rss_rule" android:dividerHeight="1dp" android:scrollbarSize="3dp" android:scrollbarStyle="insideOverlay"
            android:fadeScrollbars="false" android:scrollbarThumbVertical="@drawable/bc_scroll_thumb" android:listSelector="#22000000"/>
    </FrameLayout>
</LinearLayout>
