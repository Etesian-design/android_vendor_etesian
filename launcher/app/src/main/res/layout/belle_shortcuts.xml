<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/belle_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/belle_slot0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/belle_slot"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/belle_slot_icon0"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/belle_add" />

        <TextView
            android:id="@+id/belle_slot_label0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/belle_slot1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/belle_slot"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/belle_slot_icon1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/belle_add" />

        <TextView
            android:id="@+id/belle_slot_label1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/belle_slot2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/belle_slot"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/belle_slot_icon2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/belle_add" />

        <TextView
            android:id="@+id/belle_slot_label2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/belle_slot3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        android:layout_weight="1"
        android:background="@drawable/belle_slot"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/belle_slot_icon3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/belle_add" />

        <TextView
            android:id="@+id/belle_slot_label3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
