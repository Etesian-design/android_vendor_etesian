<?xml version="1.0" encoding="utf-8"?>
<!-- One event in the Belle agenda: people glyph, the calendar's cyan bar, the title, then the time or organiser. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bc_item" android:layout_width="match_parent" android:layout_height="60dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
    <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/bc_glyph_people" android:tint="#FF77777B"/>
    <ImageView android:layout_width="4dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
        android:layout_marginTop="9dp" android:layout_marginBottom="9dp" android:background="#FF19D3E6"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/bc_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end"
            android:maxLines="1" android:textColor="#FF1A1A1A" android:textSize="17sp" android:fontFamily="etesian-text"/>
        <TextView android:id="@+id/bc_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end"
            android:maxLines="1" android:textColor="#FF6E6E73" android:textSize="15sp" android:fontFamily="etesian-text"/>
    </LinearLayout>
</LinearLayout>
