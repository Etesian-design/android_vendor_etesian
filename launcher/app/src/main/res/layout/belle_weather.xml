<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/belle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/belle_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/belle_icon"
        android:layout_width="56dp"
        android:layout_height="56dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/belle_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:maxLines="1"
            android:text="Weather"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/belle_condition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:maxLines="1"
            android:text="Updating…"
            android:textColor="#FF8C8C8C"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/belle_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="etesian-text"
        android:includeFontPadding="false"
        android:text="--°"
        android:textColor="#FFFFFFFF"
        android:textFontWeight="300"
        android:textSize="44sp" />
</LinearLayout>
