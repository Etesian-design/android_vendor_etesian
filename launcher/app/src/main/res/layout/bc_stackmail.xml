<?xml version="1.0" encoding="utf-8"?>
<!-- Belle Latest mail (stackemail): the Email widget's blue header and badge, one new mail at a time (sender, time, three lines
     of subject) and a dark bar with ▲ ▼ and "1 of 12" (BelleStackMailWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bc_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bc_mail_header">
        <TextView android:id="@+id/bc_account" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:paddingStart="48dp" android:paddingEnd="48dp" android:ellipsize="end" android:maxLines="1" android:text="Mail"
            android:textColor="#FFFFFFFF" android:textSize="18sp" android:fontFamily="etesian-text" android:shadowColor="#80000000" android:shadowDy="1" android:shadowRadius="1"/>
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="6dp"
            android:background="@drawable/bc_mail_badge">
            <ImageView android:id="@+id/bc_glyph" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:src="@drawable/bc_glyph_mail"/>
            <TextView android:id="@+id/bc_count" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                android:textColor="#FF0E5E9E" android:textSize="15sp" android:textStyle="bold" android:fontFamily="etesian-text" android:visibility="gone"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout android:id="@+id/bc_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#FFFFFFFF" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/bc_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="No new mail" android:textColor="#FF6E6E73" android:textSize="16sp" android:fontFamily="etesian-text"/>
        <LinearLayout android:id="@+id/bc_item" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/bc_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:ellipsize="end" android:maxLines="1" android:textColor="#FF1A1A1A" android:textSize="18sp" android:textStyle="bold" android:fontFamily="etesian-text"/>
                <TextView android:id="@+id/bc_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textColor="#FF0E70C0" android:textSize="15sp" android:fontFamily="etesian-text"/>
            </LinearLayout>
            <TextView android:id="@+id/bc_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:ellipsize="end" android:maxLines="3" android:lineSpacingExtra="2dp" android:textColor="#FF55565B" android:textSize="16sp" android:fontFamily="etesian-text"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:background="@drawable/bc_note_bar"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/bc_up" android:layout_width="64dp" android:layout_height="match_parent" android:padding="10dp"
            android:src="@drawable/bc_glyph_up" android:tint="#FF8A8B90" android:contentDescription="Newer mail"/>
        <TextView android:id="@+id/bc_position" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
            android:textColor="#FFD0D1D5" android:textSize="14sp" android:fontFamily="etesian-text"/>
        <ImageView android:id="@+id/bc_down" android:layout_width="64dp" android:layout_height="match_parent" android:padding="10dp"
            android:src="@drawable/bc_glyph_down" android:tint="#FF8A8B90" android:contentDescription="Older mail"/>
    </LinearLayout>
</LinearLayout>
