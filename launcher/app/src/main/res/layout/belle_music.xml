<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/belle_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/belle_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/belle_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/belle_art_tile"
        android:padding="14dp"
        android:scaleType="centerCrop"
        android:src="@drawable/belle_music" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/belle_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:maxLines="1"
            android:text="Music"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/belle_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="etesian-text"
            android:maxLines="1"
            android:text="Nothing playing"
            android:textColor="#FF8C8C8C"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/belle_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="8dp"
                android:src="@drawable/belle_previous" />

            <ImageView
                android:id="@+id/belle_play"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="6dp"
                android:src="@drawable/belle_play" />

            <ImageView
                android:id="@+id/belle_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="8dp"
                android:src="@drawable/belle_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
