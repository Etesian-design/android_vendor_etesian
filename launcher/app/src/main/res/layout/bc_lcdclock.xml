<?xml version="1.0" encoding="utf-8"?>
<!-- Belle LCD clock (belle-ref10.jpg): green digits on two dark tiles, the date in a small box beside
     the minutes, all in a compact frame that hugs them (transparent round it, not a big dark box). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bc_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
        android:background="@drawable/bc_lcd_frame" android:gravity="bottom" android:orientation="horizontal"
        android:paddingStart="14dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bc_lcd_tile"
            android:format12Hour="hh" android:format24Hour="HH" android:gravity="center" android:includeFontPadding="false"
            android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textColor="#FF23B14D" android:textSize="52sp" android:fontFamily="etesian-text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
            android:text=":" android:textColor="#FF23B14D" android:textSize="26sp" android:paddingStart="2dp" android:paddingEnd="2dp"/>
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bc_lcd_tile"
            android:format12Hour="mm" android:format24Hour="mm" android:gravity="center" android:includeFontPadding="false"
            android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp"
            android:textColor="#FF23B14D" android:textSize="52sp" android:fontFamily="etesian-text"/>
        <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:layout_marginBottom="4dp" android:background="@drawable/bc_lcd_box" android:format12Hour="dd/MM/yyyy"
            android:format24Hour="dd/MM/yyyy" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="1dp"
            android:paddingBottom="1dp" android:textColor="#FF23B14D" android:textSize="13sp" android:fontFamily="etesian-text"/>
    </LinearLayout>
</FrameLayout>
