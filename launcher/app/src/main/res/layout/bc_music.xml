<?xml version="1.0" encoding="utf-8"?>
<!-- Belle music player (belle-ref7.jpg): album art left on a dark panel, "Title - Artist",
     round previous / play-pause (bigger) / next buttons. Ids shared with belle_music. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/belle_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bc_glass" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
    <ImageView android:id="@+id/belle_art" android:layout_width="104dp" android:layout_height="104dp" android:background="#FF1A1A1C"
        android:scaleType="centerCrop"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="10dp"
        android:gravity="center_horizontal" android:orientation="vertical">
        <TextView android:id="@+id/belle_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFFFF" android:textSize="17sp" android:fontFamily="etesian-text"/>
        <TextView android:id="@+id/belle_artist" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
            android:orientation="horizontal">
            <ImageView android:id="@+id/belle_prev" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bc_round_btn"
                android:padding="13dp" android:src="@drawable/bc_glyph_prev" android:contentDescription="Previous"/>
            <ImageView android:id="@+id/belle_play" android:layout_width="58dp" android:layout_height="58dp" android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" android:background="@drawable/bc_round_btn" android:padding="16dp" android:src="@drawable/bc_glyph_play"
                android:contentDescription="Play"/>
            <ImageView android:id="@+id/belle_next" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bc_round_btn"
                android:padding="13dp" android:src="@drawable/bc_glyph_next" android:contentDescription="Next"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
