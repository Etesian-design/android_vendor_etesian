diff --git a/NOTICE b/NOTICE
index a415c81..2782ecd 100644
--- a/NOTICE
+++ b/NOTICE
@@ -1,3 +1,17 @@
 K-9 Mail
 Copyright 2008-2016, K-9 Mail Developers
 Copyright 2005-2016, The Android Open Source Project
+
+----------------------------------------------------------------------
+Modifications for the Etesian (N9) LineageOS ROM ("Mail")
+
+This build was modified from Thunderbird for Android (tag THUNDERBIRD_24_0).
+It is not an official Mozilla product and does not use the Thunderbird name or
+logo. Modified files: app-thunderbird (application id, name, launcher icon),
+components/ui/bolt (theme colours, Nokia Pure typography, shapes, logo),
+core/ui/legacy/theme2 (View theme colours, fonts, logo), core/preference/api
+(defaults), feature/mail/message/list/api (row colours), legacy/ui/legacy
+(message list rows, message header, compose fields, Etesian system toolbar
+integration; adds com/bompotis/etesian/toolbar/EtesianToolbar.java, Apache-2.0,
+The LineageOS Project). The full list is in the patch
+vendor/etesian/mail/patches/0001-N9-mail.patch.
diff --git a/app-thunderbird/build.gradle.kts b/app-thunderbird/build.gradle.kts
index efe1e94..273ddcb 100644
--- a/app-thunderbird/build.gradle.kts
+++ b/app-thunderbird/build.gradle.kts
@@ -213,6 +213,16 @@ androidComponents {
     }
 }
 
+// N9 Mail (Etesian ROM): the foss release build is a rebranded app with its own package name, so it does not
+// clash with (or claim to be) Mozilla's Thunderbird. Other variants keep the upstream ids.
+androidComponents {
+    onVariants(selector().withBuildType("release")) { variant ->
+        if (variant.flavorName == "foss") {
+            variant.applicationId.set("com.bompotis.etesian.mail")
+        }
+    }
+}
+
 // Initialize placeholders for the product flavor and build type combinations needed for dependency declarations.
 // They are required to avoid "Unresolved configuration" errors.
 val fullDebugImplementation = configurations.create("fullDebugImplementation")
