diff --git a/legacy/ui/legacy/src/main/java/com/bompotis/etesian/toolbar/EtesianToolbar.java b/legacy/ui/legacy/src/main/java/com/bompotis/etesian/toolbar/EtesianToolbar.java
new file mode 100644
index 0000000..8a2b3b9
--- /dev/null
+++ b/legacy/ui/legacy/src/main/java/com/bompotis/etesian/toolbar/EtesianToolbar.java
@@ -0,0 +1,285 @@
+/*
