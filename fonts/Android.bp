// Free fonts offered in Settings > Display > Font when no N9 files were imported (and
// alongside Nokia Pure when they were): Fira Sans (OFL) and Ubuntu Sans (Ubuntu Font Licence).

license {
    name: "vendor_etesian_fonts_license",
    license_kinds: ["SPDX-license-identifier-OFL"],
    license_text: ["OFL-FiraSans.txt", "LICENCE-UbuntuSans.txt"],
}

prebuilt_font { name: "FiraSans-Light.ttf", src: "FiraSans-Light.ttf", product_specific: true, licenses: ["vendor_etesian_fonts_license"] }
prebuilt_font { name: "FiraSans-Regular.ttf", src: "FiraSans-Regular.ttf", product_specific: true, licenses: ["vendor_etesian_fonts_license"] }
prebuilt_font { name: "FiraSans-Medium.ttf", src: "FiraSans-Medium.ttf", product_specific: true, licenses: ["vendor_etesian_fonts_license"] }
prebuilt_font { name: "FiraSans-Bold.ttf", src: "FiraSans-Bold.ttf", product_specific: true, licenses: ["vendor_etesian_fonts_license"] }
prebuilt_font { name: "UbuntuSans-VF.ttf", src: "UbuntuSans-VF.ttf", product_specific: true, licenses: ["vendor_etesian_fonts_license"] }

runtime_resource_overlay {
    name: "FontFiraSansOverlay",
    resource_dirs: ["fira/res"],
    manifest: "fira/AndroidManifest.xml",
    product_specific: true,
}

runtime_resource_overlay {
    name: "FontUbuntuSansOverlay",
    resource_dirs: ["ubuntu/res"],
    manifest: "ubuntu/AndroidManifest.xml",
    product_specific: true,
}
