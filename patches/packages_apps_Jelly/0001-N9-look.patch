+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.jelly.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Color
+import android.graphics.Matrix
+import android.graphics.Outline
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.net.Uri
+import android.provider.Settings
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewOutlineProvider
+import androidx.core.graphics.PathParser
+import android.view.inputmethod.EditorInfo
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.GridLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.lineageos.jelly.R
+import org.lineageos.jelly.model.Favorite
+import org.lineageos.jelly.model.History
+import java.io.File
+import java.io.FileOutputStream
+
+/**
+ * N9: the browser start page shown for new tabs / home in Etesian mode. A native overlay
+ * placed over the WebView: address field, "Top sites" grid and "Bookmarks" list.
+ */
+class StartPageView(context: Context) : ScrollView(context) {
+    var onOpenUrl: ((String) -> Unit)? = null
+
+    // The Jelly N9 restyle pins the static light palette (no dark mode), so mirror it
+    private val dark = false
+    private val bgColor = if (dark) Color.BLACK else Color.parseColor("#E6E7E8")
+    private val cardColor = if (dark) Color.parseColor("#262626") else Color.WHITE
+    private val textColor = if (dark) Color.WHITE else context.getColor(R.color.n9_text)
+    private val secondaryColor = context.getColor(R.color.n9_text_secondary)
+
+    private val content = LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        setPadding(dp(16), dp(16), dp(16), dp(24))
+    }
+    private val addressField = EditText(context).apply {
+        hint = context.getString(R.string.n9_start_address_hint)
+        setSingleLine()
+        textSize = 18f
+        setTextColor(textColor)
+        setHintTextColor(secondaryColor)
+        inputType = android.text.InputType.TYPE_TEXT_VARIATION_URI or
+                android.text.InputType.TYPE_CLASS_TEXT
+        imeOptions = EditorInfo.IME_ACTION_GO
+        background = rounded(cardColor, dp(24).toFloat(), stroke = true)
+        setPadding(dp(18), 0, dp(18), 0)
+        setOnEditorActionListener { v, actionId, event ->
+            if (actionId == EditorInfo.IME_ACTION_GO ||
+                event?.keyCode == KeyEvent.KEYCODE_ENTER
+            ) {
+                v.text.toString().trim().takeIf { it.isNotEmpty() }?.let { onOpenUrl?.invoke(it) }
+                true
+            } else false
+        }
+    }
+    private val topSitesTitle = sectionTitle(R.string.n9_start_top_sites)
+    private val grid = GridLayout(context).apply { columnCount = 2 }
+    private val bookmarksTitle = sectionTitle(R.string.n9_start_bookmarks)
+    private val bookmarksList = LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        background = rounded(cardColor, dp(8).toFloat())
+    }
+
+    private var history: List<History> = emptyList()
+    private var favorites: List<Favorite> = emptyList()
+
+    init {
+        setBackgroundColor(bgColor)
+        isFillViewport = true
+        // The browser's own address bar is already above the page: no second field here.
+        content.addView(topSitesTitle)
+        content.addView(grid, LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))
+        content.addView(bookmarksTitle)
+        content.addView(bookmarksList, LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))
+        addView(content)
+    }
+
+    fun setHistory(items: List<History>) {
+        history = items
+        rebuild()
+    }
+
+    fun setFavorites(items: List<Favorite>) {
+        favorites = items
+        rebuild()
+    }
+
+    fun reset() {
+        addressField.setText("")
+        scrollTo(0, 0)
+    }
+
+    private fun rebuild() {
+        // Top sites: bookmarks first, then the most frequently visited hosts
+        val seen = HashSet<String>()
+        val sites = ArrayList<Pair<String, String>>()
+        favorites.forEach { if (seen.add(it.url)) sites.add(it.title to it.url) }
+        history.groupBy { Uri.parse(it.url).host ?: it.url }
+            .entries.sortedByDescending { it.value.size }
+            .forEach { (_, visits) ->
+                val latest = visits.first()
+                if (seen.add(latest.url)) sites.add(latest.title to latest.url)
+            }
+
+        grid.removeAllViews()
+        sites.take(MAX_TOP_SITES).forEachIndexed { i, (title, url) ->
+            grid.addView(siteCard(title, url), GridLayout.LayoutParams(
+                GridLayout.spec(i / 2), GridLayout.spec(i % 2, 1f)
+            ).apply {
+                width = 0
+                setMargins(if (i % 2 == 0) 0 else dp(6), dp(6), if (i % 2 == 0) dp(6) else 0, dp(6))
+            })
+        }
+        topSitesTitle.visibility = if (grid.childCount > 0) View.VISIBLE else View.GONE
+
+        bookmarksList.removeAllViews()
+        favorites.forEachIndexed { i, fav ->
+            if (i > 0) bookmarksList.addView(View(context).apply {
+                setBackgroundColor(context.getColor(R.color.n9_separator))
+            }, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, 1))
+            bookmarksList.addView(bookmarkRow(fav))
+        }
+        val hasBookmarks = favorites.isNotEmpty()
+        bookmarksTitle.visibility = if (hasBookmarks) View.VISIBLE else View.GONE
+        bookmarksList.visibility = if (hasBookmarks) View.VISIBLE else View.GONE
+    }
+
+    private fun siteCard(title: String, url: String): View {
+        val card = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setOnClickListener { onOpenUrl?.invoke(url) }
+        }
+        val thumb = FrameLayout(context).apply {
+            background = rounded(cardColor, dp(8).toFloat(), stroke = true)
+            clipToOutline = true
+        }
+        thumb.addView(iconView(url, dp(48)), FrameLayout.LayoutParams(
+            dp(48), dp(48), Gravity.CENTER))
+        card.addView(thumb, LinearLayout.LayoutParams(
+            LinearLayout.LayoutParams.MATCH_PARENT, dp(110)))
+        card.addView(TextView(context).apply {
+            text = title.ifBlank { Uri.parse(url).host ?: url }
+            textSize = 15f
+            setTextColor(textColor)
+            setSingleLine()
+            ellipsize = TextUtils.TruncateAt.END
+            gravity = Gravity.CENTER_HORIZONTAL
+            setPadding(0, dp(6), 0, 0)
+        })
+        return card
+    }
+
+    private fun bookmarkRow(fav: Favorite): View = LinearLayout(context).apply {
+        orientation = LinearLayout.HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        minimumHeight = dp(64)
+        setPadding(dp(16), dp(8), dp(16), dp(8))
+        setOnClickListener { onOpenUrl?.invoke(fav.url) }
+        addView(iconView(fav.url, dp(32), fav.color), LinearLayout.LayoutParams(dp(32), dp(32)))
+        addView(LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(16), 0, 0, 0)
+            addView(TextView(context).apply {
+                text = fav.title
+                textSize = 18f
+                setTextColor(textColor)
+                setSingleLine()
+                ellipsize = TextUtils.TruncateAt.END
+            })
+            addView(TextView(context).apply {
+                text = fav.url
+                textSize = 14f
+                setTextColor(secondaryColor)
+                setSingleLine()
+                ellipsize = TextUtils.TruncateAt.END
+            })
+        }, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f))
+    }
+
+    /** Cached favicon if we have one, otherwise the host's initial on a coloured N9 squircle. */
+    private fun iconView(url: String, size: Int, color: Int = 0): View {
+        loadFavicon(context, url)?.let { bmp ->
+            return ImageView(context).apply {
+                setImageBitmap(bmp)
+                scaleType = ImageView.ScaleType.CENTER_CROP
+                clipToSquircle(this)
+            }
+        }
+        val host = Uri.parse(url).host?.removePrefix("www.") ?: url
+        return TextView(context).apply {
+            text = host.take(1).uppercase()
+            gravity = Gravity.CENTER
+            setTextColor(Color.WHITE)
+            setTextSize(TypedValue.COMPLEX_UNIT_PX, size * 0.5f)
+            typeface = Typeface.DEFAULT_BOLD
+            setBackgroundColor(if (color != 0 && color != Color.TRANSPARENT) color
+                else context.getColor(R.color.n9_blue))
+            clipToSquircle(this)
+        }
+    }
+
+    /** N9: every thumb-sized icon is the AOSP squircle (100x100 path, scaled and centred). */
+    private fun clipToSquircle(v: View) {
+        v.outlineProvider = object : ViewOutlineProvider() {
+            override fun getOutline(view: View, outline: Outline) {
+                val size = minOf(view.width, view.height).toFloat()
+                if (size <= 0f) return
+                outline.setPath(PathParser.createPathFromPathData(SQUIRCLE).apply {
+                    transform(Matrix().apply {
+                        setScale(size / 100f, size / 100f)
+                        postTranslate((view.width - size) / 2f, (view.height - size) / 2f)
+                    })
+                })
+            }
+        }
+        v.clipToOutline = true
+    }
+
+    private fun sectionTitle(res: Int) = TextView(context).apply {
+        setText(res)
+        textSize = 22f
+        typeface = Typeface.create("sans-serif-light", Typeface.NORMAL)
+        setTextColor(secondaryColor)
+        setPadding(dp(4), dp(20), 0, dp(8))
+    }
+
+    private fun rounded(color: Int, radius: Float, stroke: Boolean = false) =
+        GradientDrawable().apply {
+            setColor(color)
+            cornerRadius = radius
+            if (stroke && !dark) setStroke(1, context.getColor(R.color.n9_separator))
+        }
+
+    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
+
+    companion object {
+        private const val SQUIRCLE =
+            "M100.00 50.00L99.92 57.13L99.69 61.68L99.31 65.56L98.78 69.04L98.09 72.23L97.25 75.18L96.26 77.92L95.12 80.48L93.82 82.86L92.38 85.08L90.78 87.13L89.04 89.04L87.13 90.78L85.08 92.38L82.86 93.82L80.48 95.12L77.92 96.26L75.18 97.25L72.23 98.09L69.04 98.78L65.56 99.31L61.68 99.69L57.13 99.92L50.00 100.00L42.87 99.92L38.32 99.69L34.44 99.31L30.96 98.78L27.77 98.09L24.82 97.25L22.08 96.26L19.52 95.12L17.14 93.82L14.92 92.38L12.87 90.78L10.96 89.04L9.22 87.13L7.62 85.08L6.18 82.86L4.88 80.48L3.74 77.92L2.75 75.18L1.91 72.23L1.22 69.04L0.69 65.56L0.31 61.68L0.08 57.13L0.00 50.00L0.08 42.87L0.31 38.32L0.69 34.44L1.22 30.96L1.91 27.77L2.75 24.82L3.74 22.08L4.88 19.52L6.18 17.14L7.62 14.92L9.22 12.87L10.96 10.96L12.87 9.22L14.92 7.62L17.14 6.18L19.52 4.88L22.08 3.74L24.82 2.75L27.77 1.91L30.96 1.22L34.44 0.69L38.32 0.31L42.87 0.08L50.00 0.00L57.13 0.08L61.68 0.31L65.56 0.69L69.04 1.22L72.23 1.91L75.18 2.75L77.92 3.74L80.48 4.88L82.86 6.18L85.08 7.62L87.13 9.22L89.04 10.96L90.78 12.87L92.38 14.92L93.82 17.14L95.12 19.52L96.26 22.08L97.25 24.82L98.09 27.77L98.78 30.96L99.31 34.44L99.69 38.32L99.92 42.87Z"
+        private const val MAX_TOP_SITES = 8
+        private const val FAVICON_DIR = "n9_favicons"
+
+        fun isEnabled(context: Context) = Settings.Secure.getInt(
+            context.contentResolver, "etesian_gestures", 0
+        ) == 1
+
+        fun isStartUrl(url: String?) = url.isNullOrEmpty() || url == "about:blank"
+
+        private fun faviconFile(context: Context, url: String): File? {
+            val host = Uri.parse(url).host ?: return null
+            return File(File(context.cacheDir, FAVICON_DIR), "$host.png")
+        }
+
+        fun saveFavicon(context: Context, url: String?, icon: Bitmap) {
+            if (url == null) return
+            val file = faviconFile(context, url) ?: return
+            runCatching {
+                file.parentFile?.mkdirs()
+                FileOutputStream(file).use { icon.compress(Bitmap.CompressFormat.PNG, 100, it) }
+            }
+        }
+
+        fun loadFavicon(context: Context, url: String): Bitmap? {
+            val file = faviconFile(context, url) ?: return null
+            if (!file.exists()) return null
+            return runCatching { BitmapFactory.decodeFile(file.path) }.getOrNull()
+        }
+    }
+}
