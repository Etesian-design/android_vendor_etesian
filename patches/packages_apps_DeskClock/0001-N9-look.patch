diff --git a/src/com/android/deskclock/alarms/N9AlarmDialView.java b/src/com/android/deskclock/alarms/N9AlarmDialView.java
new file mode 100644
index 000000000..ab515ff89
--- /dev/null
+++ b/src/com/android/deskclock/alarms/N9AlarmDialView.java
@@ -0,0 +1,199 @@
+/*
+ * N9 (Etesian) style alarm time dial: outer silver ring carries the minute knob,
+ * inner black disc carries the hour knob.
+ */
+package com.android.deskclock.alarms;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.View;
+
+import com.android.deskclock.R;
+
+public class N9AlarmDialView extends View {
+
+    public interface OnTimeChangedListener {
+        void onTimeChanged(int hourOfDay, int minute);
+    }
+
+    private static final int DRAG_NONE = 0;
+    private static final int DRAG_MINUTE = 1;
+    private static final int DRAG_HOUR = 2;
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final float mDp;
+
+    private int mHour;
+    private int mMinute;
+    private boolean m24Hour = true;
+    private int mDrag = DRAG_NONE;
+    private OnTimeChangedListener mListener;
+
+    private float mCx, mCy, mOuterR, mInnerR, mKnobR;
+    private RadialGradient mOuterShader, mInnerShader;
+
+    public N9AlarmDialView(Context context) {
+        this(context, null);
+    }
+
+    public N9AlarmDialView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mDp = getResources().getDisplayMetrics().density;
+        mText.setTextAlign(Paint.Align.CENTER);
+        mText.setTypeface(Typeface.create("sans-serif", Typeface.BOLD));
+    }
+
+    public void setOnTimeChangedListener(OnTimeChangedListener l) {
+        mListener = l;
+    }
+
+    public void set24Hour(boolean is24) {
+        m24Hour = is24;
+        invalidate();
+    }
+
+    public void setTime(int hourOfDay, int minute) {
+        mHour = ((hourOfDay % 24) + 24) % 24;
+        mMinute = ((minute % 60) + 60) % 60;
+        invalidate();
+    }
+
+    public int getHour() { return mHour; }
+    public int getMinute() { return mMinute; }
+
+    @Override
+    protected void onMeasure(int widthSpec, int heightSpec) {
+        int w = MeasureSpec.getSize(widthSpec);
+        int h = MeasureSpec.getMode(heightSpec) == MeasureSpec.UNSPECIFIED
+                ? w : MeasureSpec.getSize(heightSpec);
+        int s = Math.min(w, h);
+        setMeasuredDimension(w, s);
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int ow, int oh) {
+        mCx = w / 2f;
+        mCy = h / 2f;
+        mOuterR = Math.min(w, h) / 2f - 4 * mDp;
+        mInnerR = mOuterR * 0.58f;
+        mKnobR = mOuterR * 0.13f;
+        mOuterShader = new RadialGradient(mCx, mCy - mOuterR * 0.3f, mOuterR * 1.3f,
+                getContext().getColor(R.color.n9_editor_ring_top),
+                getContext().getColor(R.color.n9_editor_ring_bottom), Shader.TileMode.CLAMP);
+        mInnerShader = new RadialGradient(mCx, mCy - mInnerR * 0.3f, mInnerR * 1.3f,
+                0xFF3A3A3A, 0xFF141414, Shader.TileMode.CLAMP);
+    }
+
+    private float minuteTrackR() { return (mOuterR + mInnerR) / 2f; }
+    private float hourTrackR() { return mInnerR - mKnobR - 6 * mDp; }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        if (mOuterR <= 0) return;
+        mPaint.setStyle(Paint.Style.FILL);
+        mPaint.setShader(null);
+        // soft shadow + white rim
+        mPaint.setColor(0x33000000);
+        c.drawCircle(mCx, mCy + 2 * mDp, mOuterR + 2 * mDp, mPaint);
+        mPaint.setColor(getContext().getColor(R.color.n9_editor_ring_rim));
+        c.drawCircle(mCx, mCy, mOuterR + 1.5f * mDp, mPaint);
+        mPaint.setShader(mOuterShader);
+        c.drawCircle(mCx, mCy, mOuterR, mPaint);
+        mPaint.setShader(mInnerShader);
+        c.drawCircle(mCx, mCy, mInnerR, mPaint);
+        mPaint.setShader(null);
+
+        // minute ticks on silver ring
+        mPaint.setColor(getContext().getColor(R.color.n9_editor_ring_tick));
+        mPaint.setStrokeWidth(1.5f * mDp);
+        for (int i = 0; i < 60; i += 5) {
+            double a = Math.toRadians(i * 6 - 90);
+            float r1 = mOuterR - 3 * mDp, r2 = mOuterR - 8 * mDp;
+            c.drawLine(mCx + (float) Math.cos(a) * r1, mCy + (float) Math.sin(a) * r1,
+                    mCx + (float) Math.cos(a) * r2, mCy + (float) Math.sin(a) * r2, mPaint);
+        }
+
+        // minute knob
+        double ma = Math.toRadians(mMinute * 6 - 90);
+        float mx = mCx + (float) Math.cos(ma) * minuteTrackR();
+        float my = mCy + (float) Math.sin(ma) * minuteTrackR();
+        drawKnob(c, mx, my, 0xFF2A1E18, 0xFF0A0706, Color.WHITE,
+                String.format(java.util.Locale.US, "%02d", mMinute));
+
+        // hour knob
+        int positions = m24Hour ? 24 : 12;
+        int hourPos = mHour % positions;
+        double ha = Math.toRadians(hourPos * (360.0 / positions) - 90);
+        float hx = mCx + (float) Math.cos(ha) * hourTrackR();
+        float hy = mCy + (float) Math.sin(ha) * hourTrackR();
+        int shown = m24Hour ? mHour : (mHour % 12 == 0 ? 12 : mHour % 12);
+        drawKnob(c, hx, hy, 0xFFF2F2F2, 0xFFBEBEBE, 0xFF2A2A2A,
+                String.format(java.util.Locale.US, m24Hour ? "%02d" : "%d", shown));
+    }
+
+    private void drawKnob(Canvas c, float x, float y, int top, int bottom, int textColor,
+            String label) {
+        mPaint.setShader(null);
+        mPaint.setColor(0x55000000);
+        c.drawCircle(x, y + 1.5f * mDp, mKnobR, mPaint);
+        mPaint.setShader(new RadialGradient(x, y - mKnobR * 0.4f, mKnobR * 1.4f,
+                top, bottom, Shader.TileMode.CLAMP));
+        c.drawCircle(x, y, mKnobR, mPaint);
+        mPaint.setShader(null);
+        mText.setColor(textColor);
+        mText.setTextSize(mKnobR * 0.85f);
+        c.drawText(label, x, y - (mText.descent() + mText.ascent()) / 2f, mText);
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent e) {
+        float dx = e.getX() - mCx, dy = e.getY() - mCy;
+        float dist = (float) Math.hypot(dx, dy);
+        switch (e.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                if (dist > mOuterR + mKnobR) return false;
+                mDrag = dist > mInnerR ? DRAG_MINUTE : DRAG_HOUR;
+                getParent().requestDisallowInterceptTouchEvent(true);
+                // fall through
+            case MotionEvent.ACTION_MOVE:
+                if (mDrag == DRAG_NONE) return false;
+                double deg = Math.toDegrees(Math.atan2(dy, dx)) + 90;
+                if (deg < 0) deg += 360;
+                if (mDrag == DRAG_MINUTE) {
+                    int m = (int) Math.round(deg / 6.0) % 60;
+                    if (m != mMinute) { mMinute = m; changed(); }
+                } else {
+                    int positions = m24Hour ? 24 : 12;
+                    int p = (int) Math.round(deg / (360.0 / positions)) % positions;
+                    int h = m24Hour ? p : (mHour >= 12 ? p + 12 : p);
+                    if (h != mHour) { mHour = h; changed(); }
+                }
+                return true;
+            case MotionEvent.ACTION_UP:
+                if (mDrag != DRAG_NONE) performClick();
+                // fall through
+            case MotionEvent.ACTION_CANCEL:
+                mDrag = DRAG_NONE;
+                return true;
+        }
+        return super.onTouchEvent(e);
+    }
+
+    @Override
+    public boolean performClick() {
+        return super.performClick();
+    }
+
+    private void changed() {
+        invalidate();
+        if (mListener != null) mListener.onTimeChanged(mHour, mMinute);
+    }
+}
