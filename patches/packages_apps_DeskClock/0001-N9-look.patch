+    <color name="n9_chevron">#FFFFFFFF</color>
+    <color name="n9_pill_light_top">#33FFFFFF</color>
+    <color name="n9_pill_light_bottom">#1FFFFFFF</color>
+    <color name="n9_pill_light_stroke">#40FFFFFF</color>
+    <color name="n9_key_top">#33FFFFFF</color>
