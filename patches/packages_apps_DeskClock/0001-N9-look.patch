diff --git a/res/anim/n9_editor_enter.xml b/res/anim/n9_editor_enter.xml
new file mode 100644
index 000000000..3d9afd5ef
--- /dev/null
+++ b/res/anim/n9_editor_enter.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9: the alarm editor slides up from the bottom of the screen. -->
+<translate xmlns:android="http://schemas.android.com/apk/res/android"
+    android:duration="320"
+    android:fromYDelta="100%p"
+    android:interpolator="@android:interpolator/decelerate_cubic"
+    android:toYDelta="0" />
diff --git a/res/anim/n9_editor_exit.xml b/res/anim/n9_editor_exit.xml
new file mode 100644
index 000000000..6a9a8067f
--- /dev/null
+++ b/res/anim/n9_editor_exit.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9: the alarm editor slides back down, revealing the clock behind it. -->
+<translate xmlns:android="http://schemas.android.com/apk/res/android"
+    android:duration="280"
+    android:fromYDelta="0"
+    android:interpolator="@android:interpolator/accelerate_cubic"
+    android:toYDelta="100%p" />
