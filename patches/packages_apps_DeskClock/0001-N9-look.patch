+
+package com.android.deskclock.widget;
+
+import android.content.Context;
+import android.graphics.BlurMaskFilter;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+
+import com.android.deskclock.R;
+
+import java.text.SimpleDateFormat;
+import java.util.Calendar;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/**
+ * The N9 Clock application's analog clock: a brushed light-grey dial, white hour and minute
+ * hands, a thin orange second hand, the weekday and date on the left, and the home time zone
+ * ("London GMT+1:00") above it.
+ */
+public class N9AnalogClock extends View {
+
+    private static final int ORANGE = 0xFFF26B1D;
+
+    // Night-aware palette (values-night for the dark Etesian backgrounds).
+    private final int mBackground;
+    private final int mLabelColor;
+    private final int mDayColor;
+    private final int mDateColor;
+    private final int[] mDialColors;
+    private final int mDialHighlight;
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mShadow = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mText = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Calendar mTime = Calendar.getInstance();
+
+    private final Runnable mTick = new Runnable() {
+        @Override
+        public void run() {
+            invalidate();
+            final long now = System.currentTimeMillis();
+            postDelayed(this, 1000 - (now % 1000));
+        }
+    };
+
+    public N9AnalogClock(Context context) {
+        this(context, null);
+    }
+
+    public N9AnalogClock(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        mBackground = context.getColor(R.color.n9_clock_page);
+        mLabelColor = context.getColor(R.color.n9_aclock_label);
+        mDayColor = context.getColor(R.color.n9_aclock_day);
+        mDateColor = context.getColor(R.color.n9_aclock_date);
+        mDialColors = new int[] {context.getColor(R.color.n9_aclock_dial_top),
+                context.getColor(R.color.n9_aclock_dial_mid),
+                context.getColor(R.color.n9_aclock_dial_bottom)};
+        mDialHighlight = context.getColor(R.color.n9_aclock_dial_highlight);
+        mShadow.setColor(0x40000000);
+        mShadow.setMaskFilter(new BlurMaskFilter(dp(3), BlurMaskFilter.Blur.NORMAL));
+        setLayerType(LAYER_TYPE_SOFTWARE, null); // for the blurred shadows
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        post(mTick);
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        removeCallbacks(mTick);
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    protected void onDraw(@NonNull Canvas canvas) {
+        final int w = getWidth();
+        final int h = getHeight();
+        canvas.drawColor(mBackground);
+
+        // Home time zone label.
+        final TimeZone tz = TimeZone.getDefault();
+        mText.setTypeface(Typeface.DEFAULT);
+        mText.setColor(mLabelColor);
+        mText.setTextSize(sp(15));
+        mText.setTextAlign(Paint.Align.CENTER);
+        final float labelY = dp(14) - mText.ascent();
+        canvas.drawText(zoneLabel(tz), w / 2f, labelY, mText);
+
+        // Dial.
+        final float top = labelY + dp(14);
+        final float r = Math.min(w * 0.40f, (h - top - dp(14)) / 2f);
+        if (r <= 0) {
+            return;
+        }
+        final float cx = w / 2f;
+        final float cy = top + r;
+        canvas.drawCircle(cx, cy + dp(2), r + dp(1), mShadow);
+        mPaint.setShader(new RadialGradient(cx, cy - r * 0.5f, r * 1.6f,
+                mDialColors, new float[] {0f, 0.6f, 1f},
+                Shader.TileMode.CLAMP));
+        canvas.drawCircle(cx, cy, r, mPaint);
+        mPaint.setShader(null);
+        mPaint.setStyle(Paint.Style.STROKE);
+        mPaint.setStrokeWidth(dp(1));
+        mPaint.setColor(mDialHighlight);
+        canvas.drawCircle(cx, cy, r - dp(1), mPaint);
+        mPaint.setStyle(Paint.Style.FILL);
+
+        mTime.setTimeInMillis(System.currentTimeMillis());
+        mTime.setTimeZone(tz);
+
+        // Weekday and date on the left of the dial.
+        mText.setTextAlign(Paint.Align.LEFT);
+        mText.setColor(mDayColor);
+        mText.setTextSize(r * 0.085f);
+        final String day = new SimpleDateFormat("EEE", Locale.getDefault())
+                .format(mTime.getTime()).toUpperCase(Locale.getDefault());
+        final float textX = cx - r * 0.85f;
+        canvas.drawText(day, textX, cy - r * 0.27f, mText);
+        mText.setTypeface(Typeface.create("sans-serif-light", Typeface.NORMAL));
+        mText.setColor(mDateColor);
+        mText.setTextSize(r * 0.23f);
+        canvas.drawText(String.valueOf(mTime.get(Calendar.DAY_OF_MONTH)), textX,
+                cy - r * 0.02f, mText);
+
+        final float seconds = mTime.get(Calendar.SECOND);
+        final float minutes = mTime.get(Calendar.MINUTE) + seconds / 60f;
+        final float hours = mTime.get(Calendar.HOUR) + minutes / 60f;
+
+        // Minute hand: long, slim, a slightly greyer white.
+        hand(canvas, cx, cy, minutes * 6f, r * 0.80f, r * 0.045f, 0xFFF1F1F1, 0xFFB4B4B4);
+        // Hour hand: shorter and wider, bright white.
+        hand(canvas, cx, cy, hours * 30f, r * 0.62f, r * 0.075f, 0xFFFFFFFF, 0xFFC4C4C4);
+
+        // Second hand: thin orange line with a short tail.
+        canvas.save();
+        canvas.rotate(seconds * 6f, cx, cy);
+        mPaint.setColor(ORANGE);
+        mPaint.setStrokeWidth(Math.max(dp(1), r * 0.012f));
+        mPaint.setStrokeCap(Paint.Cap.ROUND);
+        canvas.drawLine(cx, cy + r * 0.12f, cx, cy - r * 0.92f, mPaint);
+        canvas.restore();
+    }
+
+    /** A rounded hand pointing at {@code degrees} (0 = 12 o'clock), with a soft shadow. */
+    private void hand(Canvas canvas, float cx, float cy, float degrees, float length,
+            float width, int color, int edge) {
+        canvas.save();
+        canvas.rotate(degrees, cx, cy);
+        final float left = cx - width / 2f;
+        final float right = cx + width / 2f;
+        final float tail = width;
+        canvas.drawRoundRect(left, cy - length + dp(3), right, cy + tail + dp(3), width / 2f,
+                width / 2f, mShadow);
+        mPaint.setColor(edge);
+        canvas.drawRoundRect(left, cy - length, right, cy + tail, width / 2f, width / 2f, mPaint);
+        mPaint.setColor(color);
+        canvas.drawRoundRect(left + dp(1), cy - length + dp(1), right - dp(1), cy + tail - dp(1),
+                width / 2f, width / 2f, mPaint);
+        canvas.restore();
+    }
+
+    /** "London GMT+1:00": the city of the time zone and its current offset. */
+    private static String zoneLabel(TimeZone tz) {
+        final String id = tz.getID();
+        final int slash = id.lastIndexOf('/');
+        final String city = (slash >= 0 ? id.substring(slash + 1) : id).replace('_', ' ');
+        final int offset = tz.getOffset(System.currentTimeMillis()) / 60000;
+        final String sign = offset < 0 ? "-" : "+";
+        final int abs = Math.abs(offset);
+        return String.format(Locale.getDefault(), "%s GMT%s%d:%02d", city, sign, abs / 60,
+                abs % 60);
+    }
+
+    private float dp(float value) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value,
+                getResources().getDisplayMetrics());
+    }
+
+    private float sp(float value) {
+        return TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, value,
+                getResources().getDisplayMetrics());
+    }
+}
