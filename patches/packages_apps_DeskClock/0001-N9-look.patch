+
+package com.android.deskclock.widget;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Shader;
+import android.graphics.drawable.GradientDrawable;
+import android.provider.Settings;
+import android.util.AttributeSet;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+
+import androidx.annotation.DrawableRes;
+import androidx.annotation.IdRes;
+import androidx.annotation.NonNull;
+import androidx.annotation.StringRes;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * The N9 (Etesian) application toolbar: icon-only tabs on a grey gradient, a rounded back
+ * button first, the selected tab drawn as a lighter block. As in the N9 Store.
+ *
+ * <p>Colours follow Settings.Secure {@code etesian_toolbar_style}: 0 light (default), 1 dark.
+ */
+public class N9TabBar extends LinearLayout {
+
+    public static final String SETTING_STYLE = "etesian_toolbar_style";
+
+    /** One colour set for the bar. */
+    private static final class Palette {
+        final int top, bottom, highlight, edge, selected, icon, buttonTop, buttonBottom,
+                buttonStroke;
+
+        Palette(int top, int bottom, int highlight, int edge, int selected, int icon,
+                int buttonTop, int buttonBottom, int buttonStroke) {
+            this.top = top;
+            this.bottom = bottom;
+            this.highlight = highlight;
+            this.edge = edge;
+            this.selected = selected;
+            this.icon = icon;
+            this.buttonTop = buttonTop;
+            this.buttonBottom = buttonBottom;
+            this.buttonStroke = buttonStroke;
+        }
+    }
+
+    private static final Palette LIGHT = new Palette(0xFFD6D6D8, 0xFFADADB0, 0xFFF4F4F4,
+            0xFF8E8E90, 0x66FFFFFF, 0xFF262626, 0xFFF2F2F2, 0xFFCDCDCF, 0xFF9C9C9E);
+    /** Symbian Belle: charcoal gradient, white glyphs. */
+    private static final Palette DARK = new Palette(0xFF3C3D40, 0xFF141416, 0xFF5C5E62,
+            0xFF000000, 0x30FFFFFF, 0xFFFFFFFF, 0xFF4A4B4F, 0xFF26272A, 0xFF66686C);
+
+    /** Called when a tab (not the back button or an action) is chosen. */
+    public interface OnTabSelectedListener {
+        void onTabSelected(@IdRes int id);
+    }
+
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final List<View> mTabs = new ArrayList<>();
+    private Palette mPalette = LIGHT;
+    private OnTabSelectedListener mListener;
+    private int mSelectedId = View.NO_ID;
+
+    public N9TabBar(Context context) {
+        this(context, null);
+    }
+
+    public N9TabBar(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setOrientation(HORIZONTAL);
+        setWillNotDraw(false);
+        setMinimumHeight(dp(64));
+        readStyle();
+    }
+
+    private void readStyle() {
+        mPalette = Settings.Secure.getInt(getContext().getContentResolver(), SETTING_STYLE, 0)
+                == 1 ? DARK : LIGHT;
+    }
+
+    public void setOnTabSelectedListener(OnTabSelectedListener listener) {
+        mListener = listener;
+    }
+
+    /** The rounded back button, always first. */
+    public void addBackButton(@NonNull OnClickListener onClick) {
+        final FrameLayout cell = new FrameLayout(getContext());
+        final ImageView button = new ImageView(getContext());
+        button.setImageResource(com.android.deskclock.R.drawable.ic_n9_back);
+        button.setScaleType(ImageView.ScaleType.CENTER);
+        button.setContentDescription(getResources().getString(
+                com.android.deskclock.R.string.n9_back));
+        final GradientDrawable bg = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                new int[] {mPalette.buttonTop, mPalette.buttonBottom});
+        bg.setCornerRadius(dp(14));
+        bg.setStroke(dp(1), mPalette.buttonStroke);
+        button.setBackground(bg);
+        button.setImageTintList(ColorStateList.valueOf(mPalette.icon));
+        button.setOnClickListener(onClick);
+        cell.addView(button, new FrameLayout.LayoutParams(dp(50), dp(50), Gravity.CENTER));
+        addView(cell, new LayoutParams(dp(72), LayoutParams.MATCH_PARENT));
+    }
+
+    /** A selectable tab. */
+    public void addTab(@IdRes int id, @DrawableRes int icon, @StringRes int label) {
+        final ImageView tab = cell(icon, label);
+        tab.setId(id);
+        tab.setOnClickListener(v -> {
+            setSelectedTab(id);
+            if (mListener != null) {
+                mListener.onTabSelected(id);
+            }
+        });
+        mTabs.add(tab);
+        addView(tab, new LayoutParams(0, LayoutParams.MATCH_PARENT, 1f));
+    }
+
+    /** A button that runs an action without becoming selected (e.g. settings). */
+    public void addAction(@DrawableRes int icon, @StringRes int label, OnClickListener onClick) {
+        final ImageView action = cell(icon, label);
+        action.setOnClickListener(onClick);
+        addView(action, new LayoutParams(0, LayoutParams.MATCH_PARENT, 1f));
+    }
+
+    private ImageView cell(@DrawableRes int icon, @StringRes int label) {
+        final ImageView view = new ImageView(getContext());
+        view.setImageResource(icon);
+        view.setScaleType(ImageView.ScaleType.CENTER);
+        view.setImageTintList(ColorStateList.valueOf(mPalette.icon));
+        view.setContentDescription(getResources().getString(label));
+        final TypedValue ripple = new TypedValue();
+        getContext().getTheme().resolveAttribute(
+                android.R.attr.selectableItemBackground, ripple, true);
+        view.setForeground(getContext().getDrawable(ripple.resourceId));
+        return view;
+    }
+
+    public void setSelectedTab(@IdRes int id) {
+        mSelectedId = id;
+        for (View tab : mTabs) {
+            tab.setSelected(tab.getId() == id);
+            tab.setBackgroundColor(tab.getId() == id ? mPalette.selected : Color.TRANSPARENT);
+        }
+    }
+
+    @Override
+    protected void onDraw(@NonNull Canvas canvas) {
+        final int w = getWidth();
+        final int h = getHeight();
+        mPaint.setShader(new LinearGradient(0, 0, 0, h, mPalette.top, mPalette.bottom,
+                Shader.TileMode.CLAMP));
+        canvas.drawRect(0, 0, w, h, mPaint);
+        mPaint.setShader(null);
+        // A dark edge with a light line under it, as at the top of the N9 toolbar.
+        mPaint.setColor(mPalette.edge);
+        canvas.drawRect(0, 0, w, dp(1), mPaint);
+        mPaint.setColor(mPalette.highlight);
+        canvas.drawRect(0, dp(1), w, dp(2), mPaint);
+        super.onDraw(canvas);
+    }
+
+    private int dp(int value) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, value,
+                getResources().getDisplayMetrics());
+    }
+}
