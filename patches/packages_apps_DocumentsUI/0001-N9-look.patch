+
+package com.android.documentsui.dirlist;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.View;
+
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.documentsui.R;
+
+import com.bompotis.etesian.fastscroll.EtesianFastScroller;
+
+import java.util.Objects;
+import java.util.function.BooleanSupplier;
+
+/**
+ * N9 (Etesian) list look: a thin engraved rule (grey line over a white line) under each
+ * document row, and the section letter small, grey and bold at the right where a new letter
+ * starts (when the list is sorted by name).
+ */
+final class EtesianRuleDecoration extends RecyclerView.ItemDecoration {
+
+    private final EtesianFastScroller.SectionProvider mSections;
+    private final BooleanSupplier mIsListMode;
+    private final Paint mRulePaint = new Paint();
+    private final Paint mHighlightPaint = new Paint();
+    private final Paint mLetterPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final int mInsetStart;
+    private final int mInsetEnd;
+    private final float mLetterGap;
+    /** The fast scroller's band (0..1): our letters fade out under it, it shows its own. */
+    private java.util.function.DoubleSupplier mBandAlpha = () -> 0;
+
+    /**
+     * @param sections section letter of an adapter position (null for none)
+     * @param isListMode whether the list (not grid) layout is showing
+     */
+    EtesianRuleDecoration(Context context, EtesianFastScroller.SectionProvider sections,
+            BooleanSupplier isListMode) {
+        mSections = sections;
+        mIsListMode = isListMode;
+        final float density = context.getResources().getDisplayMetrics().density;
+        mRulePaint.setColor(context.getColor(R.color.n9_separator));
+        mHighlightPaint.setColor(context.getColor(R.color.n9_rule_highlight));
+        mLetterPaint.setColor(context.getColor(R.color.n9_section_letter));
+        mLetterPaint.setTextAlign(Paint.Align.RIGHT);
+        mLetterPaint.setTextSize(TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, 13,
+                context.getResources().getDisplayMetrics()));
+        mLetterPaint.setTypeface(Typeface.create(
+                Typeface.create("etesian-text", Typeface.NORMAL), 700, false));
+        mInsetStart = Math.round(16 * density);
+        mInsetEnd = Math.round(16 * density);
+        mLetterGap = 3 * density;
+    }
+
+    void setBandAlpha(java.util.function.DoubleSupplier bandAlpha) {
+        mBandAlpha = bandAlpha;
+    }
+
+    @Override
+    public void onDrawOver(Canvas c, RecyclerView parent, RecyclerView.State state) {
+        if (!mIsListMode.getAsBoolean()) {
+            return;
+        }
+        final RecyclerView.Adapter<?> adapter = parent.getAdapter();
+        if (adapter == null) {
+            return;
+        }
+        final boolean rtl = parent.getLayoutDirection() == View.LAYOUT_DIRECTION_RTL;
+        final int left = parent.getPaddingLeft() + (rtl ? mInsetEnd : mInsetStart);
+        final int right = parent.getWidth() - parent.getPaddingRight()
+                - (rtl ? mInsetStart : mInsetEnd);
+        mLetterPaint.setTextAlign(rtl ? Paint.Align.LEFT : Paint.Align.RIGHT);
+        mLetterPaint.setAlpha((int) (255 * (1 - Math.min(1, mBandAlpha.getAsDouble()))));
+
+        final int count = parent.getChildCount();
+        for (int i = 0; i < count; i++) {
+            final View child = parent.getChildAt(i);
+            final int position = parent.getChildAdapterPosition(child);
+            if (position == RecyclerView.NO_POSITION) {
+                continue;
+            }
+            if (!(parent.getChildViewHolder(child) instanceof ListDocumentHolder)) {
+                continue;
+            }
+            final int bottom = Math.round(child.getY()) + child.getHeight();
+            final int top = Math.round(child.getY());
+
+            // Engraved rule: grey line with a white line under it.
+            c.drawRect(left, bottom - 2, right, bottom - 1, mRulePaint);
+            c.drawRect(left, bottom - 1, right, bottom, mHighlightPaint);
+
+            // Section letter where a new letter starts, sitting just under the rule above.
+            final String section = mSections.sectionFor(position);
+            if (section != null && (position == 0
+                    || !Objects.equals(section, mSections.sectionFor(position - 1)))) {
+                final float baseline = top - mLetterPaint.ascent() + mLetterGap;
+                c.drawText(section, rtl ? left : right, baseline, mLetterPaint);
+            }
+        }
+    }
+}
