diff --git a/res/values/n9_colors.xml b/res/values/n9_colors.xml
new file mode 100644
index 00000000000..2a180f7bbb2
--- /dev/null
+++ b/res/values/n9_colors.xml
@@ -0,0 +1,37 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Copyright (C) 2026 The LineageOS Project
+
+    Licensed under the Apache License, Version 2.0 (the "License");
+    you may not use this file except in compliance with the License.
+    You may obtain a copy of the License at
+
+         http://www.apache.org/licenses/LICENSE-2.0
+
+    Unless required by applicable law or agreed to in writing, software
+    distributed under the License is distributed on an "AS IS" BASIS,
+    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+    See the License for the specific language governing permissions and
+    limitations under the License.
+-->
+<!-- Nokia N9 (Etesian) black palette. Settings is forced to night mode
+     (SettingsApplication), so these apply in both configurations. -->
+<resources>
+    <color name="n9_window_bg">#000000</color>
+    <color name="n9_list_bg">#000000</color>
+    <color name="n9_search_bg">#1A1A1A</color>
+    <color name="n9_text_primary">#FFFFFF</color>
+    <color name="n9_text_secondary">#A0A0A0</color>
+    <color name="n9_separator">#4A4A4A</color>
+    <color name="n9_accent">#2A86D8</color>
+    <color name="n9_accent_dark">#1E5F99</color>
+    <!-- N9: plain monochrome icons, no tile behind them -->
+    <color name="n9_icon_tile_bg">#00000000</color>
+    <color name="n9_icon_tint">#FFFFFF</color>
+    <color name="n9_switch_track_off">#3A3A3A</color>
+    <!-- Engraved rule: groove and highlight -->
+    <color name="n9_rule_dark">#0F0F0F</color>
+    <color name="n9_rule_light">#333333</color>
+    <color name="n9_positive">#62AE2E</color>
+    <color name="n9_negative">#E5534F</color>
+</resources>
