+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.core;
+
+import android.app.ActionBar;
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.util.TypedValue;
+import android.view.View;
+import android.widget.TextView;
+import android.widget.Toolbar;
+
+import com.android.settings.R;
+
+import com.bompotis.etesian.theme.EtesianBackground;
+import com.bompotis.etesian.toolbar.EtesianToolbar;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Nokia N9 (Etesian) chrome for Settings: the black-screen background (black or the user's
+ * dark wallpaper, Settings.Secure {@code etesian_dark_bg}) and the system bottom toolbar.
+ */
+public final class EtesianChrome {
+
+    private EtesianChrome() {}
+
+    /** Whether the system toolbar is showing, so Settings' own Back arrows should be hidden. */
+    public static boolean useSystemToolbar(Activity activity) {
+        return EtesianToolbar.isAvailable(activity);
+    }
+
+    /**
+     * Applies the N9 black-screen background to [activity]'s window. Returns whether it is the
+     * wallpaper, in which case the caller should make its opaque bars transparent.
+     */
+    public static boolean applyBackground(Activity activity) {
+        final EtesianBackground.Style style = EtesianBackground.blackScreen(activity);
+        EtesianBackground.applyBlackScreen(activity, style);
+        return style == EtesianBackground.Style.WALLPAPER;
+    }
+
+    /** Makes [views] transparent (null entries are skipped), for the wallpaper background. */
+    public static void clearBackgrounds(View... views) {
+        for (View v : views) {
+            if (v != null) v.setBackgroundColor(Color.TRANSPARENT);
+        }
+    }
+
+    /**
+     * Puts the dark N9 toolbar on [activity]: Back on sub-pages, none on the main page, plus
+     * [items]. Hides the action bar's own Back arrow while the system toolbar shows.
+     */
+    public static void applyToolbar(Activity activity, boolean back,
+            EtesianToolbar.Listener listener, EtesianToolbar.Item... items) {
+        if (!EtesianToolbar.isAvailable(activity)) {
+            return;
+        }
+        hideBackArrow(activity, null);
+        final List<EtesianToolbar.Item> list = new ArrayList<>();
+        for (EtesianToolbar.Item i : items) list.add(i);
+        EtesianToolbar.of(activity)
+                .setBack(back)
+                .setStyle(EtesianToolbar.STYLE_DARK)
+                .setItems(list, listener != null ? listener : id -> {});
+    }
+
+    /** Hides the action bar's Back arrow (the system toolbar has Back). */
+    public static void hideBackArrow(Activity activity, Toolbar toolbar) {
+        final ActionBar actionBar = activity.getActionBar();
+        if (actionBar != null) {
+            actionBar.setDisplayHomeAsUpEnabled(false);
+            actionBar.setHomeButtonEnabled(false);
+        }
+        if (toolbar != null) {
+            toolbar.setNavigationIcon(null);
+        }
+    }
+
+    /** N9 page title: Nokia Pure Light (300), 26sp, whatever the toolbar style says. */
+    public static void styleTitle(Toolbar toolbar) {
+        final Typeface light = Typeface.create(
+                Typeface.create("etesian-text", Typeface.NORMAL), 300, false);
+        for (int i = 0; i < toolbar.getChildCount(); i++) {
+            final View child = toolbar.getChildAt(i);
+            if (child instanceof TextView) {
+                final TextView title = (TextView) child;
+                title.setTypeface(light);
+                title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 26);
+            }
+        }
+    }
+
+    /**
+     * Hides the system toolbar on this activity, as on the N9's main Settings page (sub pages
+     * have one, usually with only Back).
+     */
+    public static void hideToolbar(Activity activity) {
+        if (!EtesianToolbar.isAvailable(activity)) {
+            return;
+        }
+        EtesianToolbar.of(activity)
+                .setBack(false)
+                .setStyle(EtesianToolbar.STYLE_DARK)
+                .setHidden(true)
+                .setItems(new ArrayList<>(), id -> {});
+    }
+
+    /**
+     * Search by pulling down at the top of any Settings screen (the N9 had no search; this
+     * keeps it without a button). Feed it every touch from the activity's dispatchTouchEvent.
+     */
+    public static final class PullToSearch {
+        private static final float TRIGGER_DP = 110f;
+        private final Activity mActivity;
+        private final float mDensity;
+        private float mDownX;
+        private float mDownY;
+        private boolean mTracking;
+        private boolean mPulling;
+        private TextView mHint;
+
+        public PullToSearch(Activity activity) {
+            mActivity = activity;
+            mDensity = activity.getResources().getDisplayMetrics().density;
+        }
+
+        public void onTouch(android.view.MotionEvent ev) {
+            switch (ev.getActionMasked()) {
+                case android.view.MotionEvent.ACTION_DOWN:
+                    mDownX = ev.getRawX();
+                    mDownY = ev.getRawY();
+                    // Only from a list that is already at its top.
+                    mTracking = atTop(mActivity.findViewById(android.R.id.content), ev.getRawX(),
+                            ev.getRawY());
+                    mPulling = false;
+                    break;
+                case android.view.MotionEvent.ACTION_MOVE: {
+                    if (!mTracking) break;
+                    final float dy = ev.getRawY() - mDownY;
+                    final float dx = Math.abs(ev.getRawX() - mDownX);
+                    if (!mPulling && (dy < 0 || dx > Math.abs(dy))) {
+                        if (Math.abs(dy) > 12 * mDensity || dx > 12 * mDensity) mTracking = false;
+                        break;
+                    }
+                    if (dy > 16 * mDensity) mPulling = true;
+                    if (mPulling) showHint(dy / (TRIGGER_DP * mDensity));
+                    break;
+                }
+                case android.view.MotionEvent.ACTION_UP:
+                    if (mPulling && ev.getRawY() - mDownY >= TRIGGER_DP * mDensity) openSearch();
+                    // fall through
+                case android.view.MotionEvent.ACTION_CANCEL:
+                    mTracking = false;
+                    mPulling = false;
+                    hideHint();
+                    break;
+            }
+        }
+
+        /** True when the scrolling view under (x, y), if any, cannot scroll further up. */
+        private static boolean atTop(View v, float x, float y) {
+            if (v == null || v.getVisibility() != View.VISIBLE) return true;
+            final int[] at = new int[2];
+            v.getLocationOnScreen(at);
+            if (x < at[0] || y < at[1] || x > at[0] + v.getWidth() || y > at[1] + v.getHeight()) {
+                return true;
+            }
+            if (v.canScrollVertically(-1)) return false;
+            if (v instanceof android.view.ViewGroup) {
+                final android.view.ViewGroup g = (android.view.ViewGroup) v;
+                for (int i = 0; i < g.getChildCount(); i++) {
+                    if (!atTop(g.getChildAt(i), x, y)) return false;
+                }
+            }
+            return true;
+        }
+
+        private void showHint(float progress) {
+            if (mHint == null) {
+                mHint = new TextView(mActivity);
+                mHint.setTextColor(Color.WHITE);
+                mHint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+                mHint.setGravity(android.view.Gravity.CENTER);
+                final int pad = (int) (12 * mDensity);
+                mHint.setPadding(pad, pad, pad, pad);
+                mHint.setBackgroundColor(0xE0101010);
+                final android.widget.FrameLayout.LayoutParams lp =
+                        new android.widget.FrameLayout.LayoutParams(
+                                android.view.ViewGroup.LayoutParams.MATCH_PARENT,
+                                android.view.ViewGroup.LayoutParams.WRAP_CONTENT,
+                                android.view.Gravity.TOP);
+                ((android.view.ViewGroup) mActivity.getWindow().getDecorView()).addView(mHint, lp);
+                mHint.setOnApplyWindowInsetsListener((view, insets) -> {
+                    view.setPadding(pad, pad + insets.getInsets(
+                            android.view.WindowInsets.Type.statusBars()).top, pad, pad);
+                    return insets;
+                });
+                mHint.requestApplyInsets();
+            }
+            final float p = Math.min(1f, progress);
+            mHint.setText(progress >= 1f ? "Release to search" : "Pull down to search");
+            mHint.setAlpha(p);
+            mHint.setTranslationY(-(1f - p) * mHint.getHeight());
+        }
+
+        private void hideHint() {
+            if (mHint == null) return;
+            ((android.view.ViewGroup) mActivity.getWindow().getDecorView()).removeView(mHint);
+            mHint = null;
+        }
+
+        private void openSearch() {
+            try {
+                mActivity.startActivity(new android.content.Intent(
+                        "com.android.settings.action.SETTINGS_SEARCH")
+                        .setPackage(mActivity.getString(R.string.config_settingsintelligence_package_name)));
+            } catch (RuntimeException e) {
+                // No search app.
+            }
+        }
+    }
+}
