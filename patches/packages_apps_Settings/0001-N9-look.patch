+
+    /** N9 (Etesian): pull down at the top of the screen to search. */
+    private EtesianChrome.PullToSearch mPullToSearch;
+
+    @Override
+    public boolean dispatchTouchEvent(android.view.MotionEvent ev) {
+        if (mPullToSearch != null) mPullToSearch.onTouch(ev);
+        return super.dispatchTouchEvent(ev);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        // N9 (Etesian): black-screen background (black or dark wallpaper) and the dark
+        // system toolbar with Back, which replaces the action bar's Back arrow.
+        if (!WizardManagerHelper.isAnySetupWizard(getIntent())) {
+            if (EtesianChrome.applyBackground(this)) {
+                EtesianChrome.clearBackgrounds(mAppBarLayout, mCollapsingToolbarLayout);
+            }
+            EtesianChrome.applyToolbar(this, true /* back */, null);
+            mPullToSearch = EtesianChrome.useSystemToolbar(this)
+                    ? new EtesianChrome.PullToSearch(this) : null;
+            if (mToolbar != null) {
+                // Run after SettingsActivity and fragments have set up the action bar.
+                mToolbar.post(() -> {
+                    if (EtesianChrome.useSystemToolbar(this)) {
+                        EtesianChrome.hideBackArrow(this, mToolbar);
+                    }
+                    EtesianChrome.styleTitle(mToolbar);
+                });
+            }
+        }
+    }
+
+    /**
+     * N9 (Etesian): no large collapsing title. The app bar is a fixed one-line bar with the
+     * toolbar's own title (light, ~26sp) and a rule under it.
+     */
+    private void disableCollapsingTitle() {
+        if (mCollapsingToolbarLayout == null) {
+            return;
+        }
+        mCollapsingToolbarLayout.setTitleEnabled(false);
+        final ViewGroup.LayoutParams lp = mCollapsingToolbarLayout.getLayoutParams();
+        if (lp instanceof AppBarLayout.LayoutParams) {
+            ((AppBarLayout.LayoutParams) lp).setScrollFlags(0);
+            lp.height = ViewGroup.LayoutParams.WRAP_CONTENT;
+            mCollapsingToolbarLayout.setLayoutParams(lp);
+        }
     }
 
