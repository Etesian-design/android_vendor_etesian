diff --git a/java/res/drawable/btn_keyboard_key_n9.xml b/java/res/drawable/btn_keyboard_key_n9.xml
new file mode 100644
index 000000000..3d56bbfea
--- /dev/null
+++ b/java/res/drawable/btn_keyboard_key_n9.xml
@@ -0,0 +1,33 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    SPDX-FileCopyrightText: The LineageOS Project
+    SPDX-License-Identifier: Apache-2.0
+-->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <!-- Action keys. N9 draws them like the other functional keys. -->
+    <item android:state_active="true" android:state_pressed="true"
+          android:drawable="@drawable/btn_keyboard_key_functional_pressed_n9" />
+    <item android:state_active="true"
+          android:drawable="@drawable/btn_keyboard_key_functional_normal_n9" />
+
+    <!-- Toggle keys. Use checkable/checked state. -->
+    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true"
+          android:drawable="@drawable/btn_keyboard_key_functional_pressed_n9" />
+    <item android:state_checkable="true" android:state_pressed="true"
+          android:drawable="@drawable/btn_keyboard_key_functional_pressed_n9" />
+    <item android:state_checkable="true" android:state_checked="true"
+          android:drawable="@drawable/btn_keyboard_key_functional_pressed_n9" />
+    <item android:state_checkable="true"
+          android:drawable="@drawable/btn_keyboard_key_functional_normal_n9" />
+
+    <!-- Empty background keys. -->
+    <item android:state_empty="true" android:state_pressed="true"
+          android:drawable="@drawable/btn_keyboard_key_pressed_n9" />
+    <item android:state_empty="true"
+          android:drawable="@android:color/transparent" />
+
+    <!-- Normal keys. -->
+    <item android:state_pressed="true"
+          android:drawable="@drawable/btn_keyboard_key_pressed_n9" />
+    <item android:drawable="@drawable/btn_keyboard_key_normal_n9" />
+</selector>
