+    <color name="key_functional_background_bottom_n9">#3A3A3A</color>
+    <color name="key_functional_edge_pressed_n9">#8A8A8A</color>
+    <color name="key_functional_background_pressed_top_n9">#7A7A7A</color>
+    <color name="key_functional_background_pressed_bottom_n9">#5A5A5A</color>
+    <color name="key_preview_background_n9">#3A3A3A</color>
