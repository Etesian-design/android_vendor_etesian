 public class BaseActivity extends AppCompatActivity {
+
+    // N9 look: the Etesian background this activity was created with.
+    private EtesianBackground.Style mEtesianStyle;
+
+    @Override
+    protected void attachBaseContext(android.content.Context newBase) {
+        // Night resources hold the N9 palette for the dark Etesian backgrounds (black, dark
+        // grey, wallpaper); force the mode both ways so the system dark theme never changes the
+        // light N9 look. Set before the delegate attaches, so it applies without a recreate.
+        mEtesianStyle = EtesianBackground.content(newBase);
+        getDelegate().setLocalNightMode(mEtesianStyle.dark
+                ? AppCompatDelegate.MODE_NIGHT_YES : AppCompatDelegate.MODE_NIGHT_NO);
+        super.attachBaseContext(newBase);
+    }
+
+    @Override
+    protected void onCreate(android.os.Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (mEtesianStyle != null && mEtesianStyle.dark) {
+            EtesianBackground.apply(this, mEtesianStyle);
+        }
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        // The user changed the Etesian background while we were away: rebuild in the new look.
+        if (mEtesianStyle != null && mEtesianStyle != EtesianBackground.content(this)) {
+            recreate();
+        }
+    }
+
+    /** N9 look: the Etesian background (light N9 by default). */
+    protected EtesianBackground.Style getEtesianStyle() {
+        return mEtesianStyle;
+    }
