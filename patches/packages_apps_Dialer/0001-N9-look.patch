+        }
+        searchController.showDialpad(true);
+      }
+      return;
+    }
+    @TabIndex int tab;
+    if ("call_log".equals(id)) {
+      tab = TabIndex.CALL_LOG;
+    } else if ("contacts".equals(id)) {
