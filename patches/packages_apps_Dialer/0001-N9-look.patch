index 000000000..58fa6630e
--- /dev/null
+++ b/java/com/android/dialer/dialpadview/res/drawable/n9_dialpad_key.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 (Etesian) style dialpad key: white rounded square inset on the grey page,
+     light grey when pressed. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="@color/n9_dialpad_key_ripple">
+  <item>
+    <inset android:inset="3dp">
+      <shape android:shape="rectangle">
+        <solid android:color="@color/n9_dialpad_key"/>
+        <corners android:radius="14dp"/>
+        <stroke android:width="1dp" android:color="@color/n9_dialpad_key_stroke"/>
+      </shape>
+    </inset>
+  </item>
+</ripple>
