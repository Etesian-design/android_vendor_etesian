diff --git a/java/com/android/dialer/widget/DialerFloatingActionButton.java b/java/com/android/dialer/widget/DialerFloatingActionButton.java
index 22df64802..a3b3e489f 100644
--- a/java/com/android/dialer/widget/DialerFloatingActionButton.java
+++ b/java/com/android/dialer/widget/DialerFloatingActionButton.java
@@ -47,18 +47,35 @@ import com.google.android.material.floatingactionbutton.FloatingActionButton;
  */
 public class DialerFloatingActionButton extends FloatingActionButton {
 
+  // N9 look: hidden for good when the Etesian system toolbar offers its action instead.
+  private boolean suppressed;
+
   public DialerFloatingActionButton(Context context, AttributeSet attributeSet) {
     super(context, attributeSet);
   }
 
+  /** Hides the button and ignores later {@link #show()} calls while suppressed. */
+  public void setSuppressed(boolean suppressed) {
+    this.suppressed = suppressed;
+    if (suppressed) {
+      hide();
+    }
+  }
+
   @Override
   public void show() {
+    if (suppressed) {
+      return;
+    }
     super.show();
     setClickable(true);
   }
 
   @Override
   public void show(@Nullable OnVisibilityChangedListener onVisibilityChangedListener) {
+    if (suppressed) {
+      return;
+    }
     super.show(onVisibilityChangedListener);
     setClickable(true);
   }
