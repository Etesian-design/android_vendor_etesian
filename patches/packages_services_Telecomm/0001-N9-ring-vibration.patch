+    /**
+     * The N9's ring vibration (its Nokia tune pattern), when the user's own N9 files were built
+     * in (vendor/etesian): on/off timings in ms, comma-separated, starting with an off.
+     */
+    private static VibrationEffect loadN9RingVibration(VibrationEffectProxy proxy) {
+        return loadN9Vibration(proxy, new java.io.File("/product/etc/etesian/ring_vibration.txt"));
+    }
+
+    /**
+     * The N9 vibration made for the ringtone that is playing (each N9 ringtone has its own), or
+     * null to use the default ring vibration.
+     */
+    private VibrationEffect loadN9RingtoneVibration(Uri ringtoneUri) {
+        if (ringtoneUri == null) return null;
+        try {
+            Uri uri = ringtoneUri;
+            if (android.provider.Settings.AUTHORITY.equals(uri.getAuthority())) {
+                uri = RingtoneManager.getActualDefaultRingtoneUri(mContext,
+                        RingtoneManager.TYPE_RINGTONE);
+                if (uri == null) return null;
+            }
+            String name = null;
+            try (android.database.Cursor c = mContext.getContentResolver().query(uri,
+                    new String[] {android.provider.OpenableColumns.DISPLAY_NAME},
+                    null, null, null)) {
+                if (c != null && c.moveToFirst()) name = c.getString(0);
+            }
+            if (name == null) return null;
+            int dot = name.lastIndexOf('.');
+            if (dot > 0) name = name.substring(0, dot);
+            return loadN9Vibration(mVibrationEffectProxy, new java.io.File(
+                    "/product/etc/etesian/vibra/" + name.replace(' ', '_') + ".txt"));
+        } catch (Exception e) {
+            Log.w(TAG, "No N9 vibration for the ringtone: " + e);
+            return null;
+        }
+    }
+
+    private static VibrationEffect loadN9Vibration(VibrationEffectProxy proxy,
+            java.io.File file) {
+        if (!file.exists()) return null;
+        try {
+            String[] parts = new String(java.nio.file.Files.readAllBytes(file.toPath()))
+                    .trim().split(",");
+            long[] timings = new long[parts.length + 1];
+            int[] amplitudes = new int[parts.length + 1];
+            for (int i = 0; i < parts.length; i++) {
+                timings[i] = Long.parseLong(parts[i].trim());
+                amplitudes[i] = i % 2 == 0 ? 0 : 255;
+            }
+            // A pause before it starts over.
+            timings[parts.length] = DEFAULT_RING_VIBRATION_LOOP_DELAY_MS;
+            amplitudes[parts.length] = 0;
+            return proxy.createWaveform(timings, amplitudes, 0);
+        } catch (Exception e) {
+            Log.w(TAG, "Bad N9 ring vibration: " + e);
+            return null;
+        }
+    }
+
