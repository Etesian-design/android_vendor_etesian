+<!-- Nokia N9 (Etesian "blanco") static light palette -->
+<resources>
+    <color name="n9_window">#E9E9E9</color>
+    <color name="n9_surface">#F4F4F4</color>
+    <color name="n9_text">#191919</color>
+    <color name="n9_text_secondary">#8C8C8C</color>
