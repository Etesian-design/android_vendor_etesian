+    /** The permission's glyph in white on a lit green N9 squircle (n = 2.8). */
+    private fun harmattanIcon(glyph: android.graphics.drawable.Drawable?): android.graphics.drawable.Drawable {
+        val d = mActivity.resources.displayMetrics.density
+        val px = (88 * d).toInt()
+        val bmp = android.graphics.Bitmap.createBitmap(px, px, android.graphics.Bitmap.Config.ARGB_8888)
+        val c = android.graphics.Canvas(bmp)
+        val shape = android.graphics.Path()
+        val r = px / 2f
+        for (i in 0..128) {
+            val t = 2 * Math.PI * i / 128
+            val x = r + r * Math.signum(Math.cos(t)) * Math.pow(Math.abs(Math.cos(t)), 2.0 / 2.8)
+            val y = r + r * Math.signum(Math.sin(t)) * Math.pow(Math.abs(Math.sin(t)), 2.0 / 2.8)
+            if (i == 0) shape.moveTo(x.toFloat(), y.toFloat()) else shape.lineTo(x.toFloat(), y.toFloat())
+        }
+        shape.close()
+        val p = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
+        p.shader = android.graphics.LinearGradient(0f, 0f, 0f, px.toFloat(), 0xFF9BDB1C.toInt(), 0xFF3A9A00.toInt(),
+            android.graphics.Shader.TileMode.CLAMP)
+        c.drawPath(shape, p)
+        glyph?.mutate()?.let { g ->
+            g.setTint(0xFFFFFFFF.toInt())
+            val inset = (px * 0.27f).toInt()
+            g.setBounds(inset, inset, px - inset, px - inset)
+            g.draw(c)
+        }
+        return android.graphics.drawable.BitmapDrawable(mActivity.resources, bmp)
+    }
