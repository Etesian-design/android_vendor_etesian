+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.messaging.ui;
+
+import android.app.Activity;
+import android.view.Gravity;
+import android.view.Menu;
+import android.view.View;
+import android.widget.PopupMenu;
+
+import com.android.messaging.R;
+
+import com.bompotis.etesian.toolbar.EtesianMenu;
+import com.bompotis.etesian.toolbar.EtesianToolbar;
+
+/**
+ * Helpers for the N9 (Etesian) look: the system toolbar and the view menu that drops down
+ * from the top of the page, in place of the action bar overflow.
+ */
+public final class EtesianUi {
+
+    /** Toolbar item ids. */
+    public static final String ITEM_NEW = "new";
+    public static final String ITEM_CALL = "call";
+    public static final String ITEM_ATTACH = "attach";
+    public static final String ITEM_MENU = "menu";
+
+    /** Hides or shows items of a menu before it is shown. */
+    public interface MenuPreparer {
+        void prepare(Menu menu);
+    }
+
+    private EtesianUi() {
+    }
+
+    /** Whether the system toolbar replaces the FAB and the action bar overflow. */
+    public static boolean isToolbarAvailable(final Activity activity) {
+        return activity != null && EtesianToolbar.isAvailable(activity);
+    }
+
+    /** The "menu" toolbar item. */
+    public static EtesianToolbar.Item menuItem(final Activity activity) {
+        return EtesianToolbar.Item.action(ITEM_MENU, R.drawable.ic_n9_toolbar_menu,
+                activity.getString(R.string.n9_toolbar_menu));
+    }
+
+    /**
+     * Shows [menuRes] as the N9 toolbar menu: a card rising from the bottom over the toolbar.
+     * Taps go to [listener].
+     */
+    public static void showMenu(final Activity activity, final int menuRes,
+            final MenuPreparer preparer, final PopupMenu.OnMenuItemClickListener listener) {
+        EtesianMenu.show(activity, menuRes,
+                preparer == null ? null : preparer::prepare,
+                listener == null ? null : listener::onMenuItemClick);
+    }
+}
