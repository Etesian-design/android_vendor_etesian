new file mode 100644
index 0000000..5de5b54
--- /dev/null
+++ b/res/layout/conversation_list_search_pill.xml
@@ -0,0 +1,31 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    SPDX-FileCopyrightText: 2026 The LineageOS Project
+    SPDX-License-Identifier: Apache-2.0
+-->
+<!-- N9 look: pull-down "Search" pill at the top of the conversation list. -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:paddingStart="16dp"
+    android:paddingEnd="16dp"
+    android:paddingTop="8dp"
+    android:paddingBottom="8dp">
+
+    <EditText
+        android:id="@+id/conversation_list_search_field"
+        android:layout_width="match_parent"
+        android:layout_height="44dp"
+        android:background="@drawable/n9_search_pill"
+        android:drawableEnd="@drawable/ic_n9_search"
+        android:paddingStart="18dp"
+        android:paddingEnd="14dp"
+        android:hint="@string/n9_search_hint"
+        android:textColorHint="@color/n9_search_hint"
+        android:textColor="#191919"
+        android:textSize="16sp"
+        android:singleLine="true"
+        android:inputType="text"
+        android:imeOptions="actionSearch|flagNoExtractUi"
+        android:importantForAutofill="no" />
+</FrameLayout>
