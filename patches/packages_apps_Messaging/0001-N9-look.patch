+            final androidx.appcompat.app.ActionBar bar =
+                    ((androidx.appcompat.app.AppCompatActivity) getActivity()).getSupportActionBar();
+            if (bar != null) { if (show) bar.hide(); else bar.show(); }
+        }
+    }
