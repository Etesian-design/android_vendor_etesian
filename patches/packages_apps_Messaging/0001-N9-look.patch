@@ -0,0 +1,60 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.messaging.ui;
+
+import android.app.Activity;
+import android.view.Gravity;
+import android.view.Menu;
+import android.view.View;
+import android.widget.PopupMenu;
+
+import com.android.messaging.R;
+
+import com.bompotis.etesian.toolbar.EtesianMenu;
+import com.bompotis.etesian.toolbar.EtesianToolbar;
+
+/**
+ * Helpers for the N9 (Etesian) look: the system toolbar and the view menu that drops down
+ * from the top of the page, in place of the action bar overflow.
+ */
+public final class EtesianUi {
+
+    /** Toolbar item ids. */
+    public static final String ITEM_NEW = "new";
+    public static final String ITEM_CALL = "call";
+    public static final String ITEM_ATTACH = "attach";
+    public static final String ITEM_MENU = "menu";
+
+    /** Hides or shows items of a menu before it is shown. */
+    public interface MenuPreparer {
+        void prepare(Menu menu);
+    }
+
+    private EtesianUi() {
+    }
