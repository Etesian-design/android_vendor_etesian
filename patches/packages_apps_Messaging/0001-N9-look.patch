+-->
+<!-- N9 first run (n9-messaging-empty.png): striped charcoal, a huge light grey sentence, stacked dark buttons. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/n9_empty"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@drawable/n9_stripes"
+    android:clickable="true"
+    android:orientation="vertical"
+    android:visibility="gone">
+    <TextView
+        android:id="@+id/n9_empty_text"
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:fontFamily="etesian-text"
+        android:textFontWeight="200"
+        android:gravity="center"
+        android:lineSpacingMultiplier="0.95"
+        android:paddingStart="6dp"
