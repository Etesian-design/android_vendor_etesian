+        v.findViewById(R.id.n9_add_account).setOnClickListener(b -> {
+            final android.content.Intent i = new android.content.Intent(android.provider.Settings.ACTION_ADD_ACCOUNT);
+            try { startActivity(i); } catch (android.content.ActivityNotFoundException e) { }
+        });
+        // No header or toolbar on the first-run page.
+        if (EtesianUi.isToolbarAvailable(getActivity())) {
+            com.bompotis.etesian.toolbar.EtesianToolbar.of(getActivity()).setHidden(show);
+        }
