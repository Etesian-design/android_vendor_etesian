@@ -0,0 +1,114 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.messaging.ui.conversationlist;
+
+import android.database.Cursor;
+import android.database.CursorWrapper;
+
+import com.android.messaging.datamodel.data.ConversationListItemData;
+
+import java.util.Locale;
+
+/**
+ * N9 look: the conversation list cursor narrowed to the rows whose name or snippet contains the
+ * search text typed in the pull-down search pill.
+ */
+class FilteredConversationCursor extends CursorWrapper {
+    private final int[] mRows;
+    private int mPosition = -1;
+
+    FilteredConversationCursor(final Cursor cursor, final String query) {
+        super(cursor);
+        final String needle = query.toLowerCase(Locale.getDefault());
+        final int[] rows = new int[cursor.getCount()];
+        int count = 0;
+        final ConversationListItemData data = new ConversationListItemData();
+        for (int i = 0; i < rows.length; i++) {
+            if (!cursor.moveToPosition(i)) {
+                break;
+            }
+            data.bind(cursor);
+            if (contains(data.getName(), needle) || contains(data.getSnippetText(), needle)) {
+                rows[count++] = i;
+            }
+        }
+        mRows = new int[count];
+        System.arraycopy(rows, 0, mRows, 0, count);
+    }
+
+    private static boolean contains(final String text, final String needle) {
+        return text != null && text.toLowerCase(Locale.getDefault()).contains(needle);
+    }
+
+    @Override
+    public int getCount() {
+        return mRows.length;
+    }
+
+    @Override
+    public int getPosition() {
+        return mPosition;
+    }
+
+    @Override
+    public boolean moveToPosition(final int position) {
+        if (position < 0) {
+            mPosition = -1;
+            return false;
+        }
+        if (position >= mRows.length) {
+            mPosition = mRows.length;
+            return false;
+        }
+        mPosition = position;
+        return super.moveToPosition(mRows[position]);
+    }
+
+    @Override
+    public boolean move(final int offset) {
+        return moveToPosition(mPosition + offset);
+    }
+
+    @Override
+    public boolean moveToFirst() {
+        return moveToPosition(0);
+    }
+
+    @Override
+    public boolean moveToLast() {
+        return moveToPosition(mRows.length - 1);
+    }
+
+    @Override
+    public boolean moveToNext() {
+        return moveToPosition(mPosition + 1);
+    }
+
+    @Override
+    public boolean moveToPrevious() {
+        return moveToPosition(mPosition - 1);
+    }
+
+    @Override
+    public boolean isFirst() {
+        return mRows.length > 0 && mPosition == 0;
+    }
+
+    @Override
+    public boolean isLast() {
+        return mRows.length > 0 && mPosition == mRows.length - 1;
+    }
+
+    @Override
+    public boolean isBeforeFirst() {
+        return mRows.length == 0 || mPosition == -1;
+    }
+
+    @Override
+    public boolean isAfterLast() {
+        return mRows.length == 0 || mPosition == mRows.length;
+    }
+}
