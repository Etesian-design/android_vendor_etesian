+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.messaging.ui.conversationlist;
+
+import android.text.Editable;
+import android.text.TextWatcher;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.EditText;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.android.messaging.R;
+
+/**
+ * N9 look: the "Search" pill shown as the first row of the conversation list, just above the
+ * top so it is revealed by pulling the list down.
+ */
+class ConversationListSearchAdapter
+        extends RecyclerView.Adapter<ConversationListSearchAdapter.SearchViewHolder> {
+
+    /** Receives the search text as it is typed. */
+    interface Listener {
+        void onSearchTextChanged(String text);
+    }
+
+    private final Listener mListener;
+    private String mText = "";
+
+    ConversationListSearchAdapter(final Listener listener) {
+        mListener = listener;
+        setHasStableIds(true);
+    }
+
+    @Override
+    public int getItemCount() {
+        return 1;
+    }
+
+    @Override
+    public long getItemId(final int position) {
+        return 0;
+    }
+
+    @NonNull
+    @Override
+    public SearchViewHolder onCreateViewHolder(@NonNull final ViewGroup parent,
+            final int viewType) {
+        final View view = LayoutInflater.from(parent.getContext())
+                .inflate(R.layout.conversation_list_search_pill, parent, false);
+        return new SearchViewHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull final SearchViewHolder holder, final int position) {
+        if (!mText.equals(holder.mField.getText().toString())) {
+            holder.mField.setText(mText);
+        }
+    }
+
+    class SearchViewHolder extends RecyclerView.ViewHolder {
+        final EditText mField;
+
+        SearchViewHolder(final View itemView) {
+            super(itemView);
+            mField = itemView.findViewById(R.id.conversation_list_search_field);
+            mField.addTextChangedListener(new TextWatcher() {
+                @Override
+                public void beforeTextChanged(final CharSequence s, final int start,
+                        final int count, final int after) {
+                }
+
+                @Override
+                public void onTextChanged(final CharSequence s, final int start,
+                        final int before, final int count) {
+                }
+
+                @Override
+                public void afterTextChanged(final Editable s) {
+                    final String text = s.toString();
+                    if (!text.equals(mText)) {
+                        mText = text;
+                        mListener.onSearchTextChanged(text);
+                    }
+                }
+            });
+        }
+    }
+}
diff --git a/src/com/android/messaging/ui/conversationlist/FilteredConversationCursor.java b/src/com/android/messaging/ui/conversationlist/FilteredConversationCursor.java
new file mode 100644
index 0000000..35e41a1
--- /dev/null
+++ b/src/com/android/messaging/ui/conversationlist/FilteredConversationCursor.java
@@ -0,0 +1,114 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.messaging.ui.conversationlist;
+
+import android.database.Cursor;
+import android.database.CursorWrapper;
+
+import com.android.messaging.datamodel.data.ConversationListItemData;
+
+import java.util.Locale;
+
+/**
+ * N9 look: the conversation list cursor narrowed to the rows whose name or snippet contains the
+ * search text typed in the pull-down search pill.
+ */
+class FilteredConversationCursor extends CursorWrapper {
+    private final int[] mRows;
+    private int mPosition = -1;
+
+    FilteredConversationCursor(final Cursor cursor, final String query) {
+        super(cursor);
+        final String needle = query.toLowerCase(Locale.getDefault());
+        final int[] rows = new int[cursor.getCount()];
+        int count = 0;
+        final ConversationListItemData data = new ConversationListItemData();
+        for (int i = 0; i < rows.length; i++) {
+            if (!cursor.moveToPosition(i)) {
+                break;
+            }
+            data.bind(cursor);
+            if (contains(data.getName(), needle) || contains(data.getSnippetText(), needle)) {
+                rows[count++] = i;
+            }
+        }
+        mRows = new int[count];
+        System.arraycopy(rows, 0, mRows, 0, count);
+    }
+
+    private static boolean contains(final String text, final String needle) {
+        return text != null && text.toLowerCase(Locale.getDefault()).contains(needle);
+    }
+
+    @Override
+    public int getCount() {
+        return mRows.length;
+    }
+
+    @Override
+    public int getPosition() {
+        return mPosition;
+    }
+
+    @Override
+    public boolean moveToPosition(final int position) {
+        if (position < 0) {
+            mPosition = -1;
+            return false;
+        }
+        if (position >= mRows.length) {
+            mPosition = mRows.length;
+            return false;
+        }
+        mPosition = position;
+        return super.moveToPosition(mRows[position]);
+    }
+
+    @Override
+    public boolean move(final int offset) {
+        return moveToPosition(mPosition + offset);
+    }
+
+    @Override
+    public boolean moveToFirst() {
+        return moveToPosition(0);
+    }
+
+    @Override
+    public boolean moveToLast() {
+        return moveToPosition(mRows.length - 1);
+    }
+
+    @Override
+    public boolean moveToNext() {
+        return moveToPosition(mPosition + 1);
+    }
+
+    @Override
+    public boolean moveToPrevious() {
+        return moveToPosition(mPosition - 1);
+    }
+
+    @Override
+    public boolean isFirst() {
+        return mRows.length > 0 && mPosition == 0;
+    }
+
+    @Override
+    public boolean isLast() {
+        return mRows.length > 0 && mPosition == mRows.length - 1;
+    }
+
+    @Override
+    public boolean isBeforeFirst() {
+        return mRows.length == 0 || mPosition == -1;
+    }
+
+    @Override
+    public boolean isAfterLast() {
+        return mRows.length == 0 || mPosition == mRows.length;
+    }
+}
