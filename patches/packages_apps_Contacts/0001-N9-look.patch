+package com.android.contacts.util;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.res.Configuration;
+
+import com.bompotis.etesian.theme.EtesianBackground;
+
+/**
+ * N9 look: follows the user's Etesian background. Night resources hold the palette for the
+ * dark backgrounds (black, dark grey, wallpaper); the light N9 default uses the day resources
+ * whatever the system dark theme says.
+ */
+public final class N9Theme {
+
+    private N9Theme() {}
+
+    /** The user's background for this content app. */
+    public static EtesianBackground.Style style(Context context) {
+        return EtesianBackground.content(context);
+    }
+
+    /**
+     * For a platform (non-AppCompat) activity's attachBaseContext: [base] with the night mode
+     * forced to match [style].
+     */
+    public static Context wrap(Context base, EtesianBackground.Style style) {
+        final Configuration config = new Configuration(base.getResources().getConfiguration());
+        config.uiMode = (config.uiMode & ~Configuration.UI_MODE_NIGHT_MASK)
+                | (style.dark ? Configuration.UI_MODE_NIGHT_YES : Configuration.UI_MODE_NIGHT_NO);
+        return base.createConfigurationContext(config);
+    }
+
+    /** Puts the dark background (colour or wallpaper) behind the window; nothing for light. */
+    public static void applyBackground(Activity activity, EtesianBackground.Style style) {
+        if (style.dark) {
+            EtesianBackground.apply(activity, style);
+        }
+    }
+}
