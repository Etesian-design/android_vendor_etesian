+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.contacts.util;
+
+import android.graphics.Bitmap;
+import android.graphics.BitmapShader;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.Matrix;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.View;
+import android.view.ViewOutlineProvider;
+
+/**
+ * N9 look: every thumb-sized image (avatars, icons, thumbnails) is a Etesian squircle, never a
+ * circle or a rounded rectangle. Shape is the AOSP squircle on a 100x100 box.
+ */
+public final class N9Squircle {
+    // "M100.00 50.00L99.92 57.13L99.69 61.68L99.31 65.56L98.78 69.04L98.09 72.23L97.25 75.18L96.26 77.92L95.12 80.48L93.82 82.86L92.38 85.08L90.78 87.13L89.04 89.04L87.13 90.78L85.08 92.38L82.86 93.82L80.48 95.12L77.92 96.26L75.18 97.25L72.23 98.09L69.04 98.78L65.56 99.31L61.68 99.69L57.13 99.92L50.00 100.00L42.87 99.92L38.32 99.69L34.44 99.31L30.96 98.78L27.77 98.09L24.82 97.25L22.08 96.26L19.52 95.12L17.14 93.82L14.92 92.38L12.87 90.78L10.96 89.04L9.22 87.13L7.62 85.08L6.18 82.86L4.88 80.48L3.74 77.92L2.75 75.18L1.91 72.23L1.22 69.04L0.69 65.56L0.31 61.68L0.08 57.13L0.00 50.00L0.08 42.87L0.31 38.32L0.69 34.44L1.22 30.96L1.91 27.77L2.75 24.82L3.74 22.08L4.88 19.52L6.18 17.14L7.62 14.92L9.22 12.87L10.96 10.96L12.87 9.22L14.92 7.62L17.14 6.18L19.52 4.88L22.08 3.74L24.82 2.75L27.77 1.91L30.96 1.22L34.44 0.69L38.32 0.31L42.87 0.08L50.00 0.00L57.13 0.08L61.68 0.31L65.56 0.69L69.04 1.22L72.23 1.91L75.18 2.75L77.92 3.74L80.48 4.88L82.86 6.18L85.08 7.62L87.13 9.22L89.04 10.96L90.78 12.87L92.38 14.92L93.82 17.14L95.12 19.52L96.26 22.08L97.25 24.82L98.09 27.77L98.78 30.96L99.31 34.44L99.69 38.32L99.92 42.87Z"
+    private static final Path UNIT = new Path();
+    static {
+        // Superellipse |x|^n + |y|^n = 1 with n = 2.8: the N9 icon shape, measured from the
+        // N9's own icons. (n = 4 or more reads as a rounded square.)
+        final double n = 2.8;
+        final int steps = 96;
+        for (int i = 0; i < steps; i++) {
+            final double t = 2 * Math.PI * i / steps;
+            final double c = Math.cos(t), s = Math.sin(t);
+            final float x = (float) (50 + 50 * Math.signum(c) * Math.pow(Math.abs(c), 2 / n));
+            final float y = (float) (50 + 50 * Math.signum(s) * Math.pow(Math.abs(s), 2 / n));
+            if (i == 0) UNIT.moveTo(x, y); else UNIT.lineTo(x, y);
+        }
+        UNIT.close();
+    }
+
+    private N9Squircle() {}
+
+    /** Writes the squircle filling the given box into {@code out}. */
+    public static Path path(float left, float top, float right, float bottom, Path out) {
+        final Matrix m = new Matrix();
+        m.setScale((right - left) / 100f, (bottom - top) / 100f);
+        m.postTranslate(left, top);
+        out.reset();
+        UNIT.transform(m, out);
+        return out;
+    }
+
+    /** The squircle filling the given box. */
+    public static Path path(float left, float top, float right, float bottom) {
+        return path(left, top, right, bottom, new Path());
+    }
+
+    /** The largest squircle centred in {@code bounds}. */
+    public static Path centered(Rect bounds) {
+        final float half = Math.min(bounds.width(), bounds.height()) / 2f;
+        return path(bounds.exactCenterX() - half, bounds.exactCenterY() - half,
+                bounds.exactCenterX() + half, bounds.exactCenterY() + half);
+    }
+
+    /** Draws a squircle centred in {@code bounds} with {@code paint}. */
+    public static void draw(Canvas canvas, Rect bounds, Paint paint) {
+        canvas.drawPath(centered(bounds), paint);
+    }
+
+    /** Outline provider that clips a view to a squircle filling its bounds. */
+    public static final ViewOutlineProvider OUTLINE = new ViewOutlineProvider() {
+        @Override
+        public void getOutline(View view, Outline outline) {
+            final int w = view.getWidth(), h = view.getHeight();
+            if (w <= 0 || h <= 0) {
+                return;
+            }
+            outline.setPath(path(0, 0, w, h));
+        }
+    };
+
+    /** Clips {@code view} (and its content) to a squircle. */
+    public static void clip(View view) {
+        view.setOutlineProvider(OUTLINE);
+        view.setClipToOutline(true);
+    }
+
+    /** Returns {@code src} center-cropped to a {@code w}x{@code h} squircle bitmap. */
+    public static Bitmap bitmap(Bitmap src, int w, int h) {
+        if (src == null) {
+            return null;
+        }
+        final Bitmap out = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        final Drawable d = new BitmapDrawable(src);
+        d.setBounds(0, 0, w, h);
+        d.draw(new Canvas(out));
+        return out;
+    }
+
+    /** A bitmap drawable, center-cropped and clipped to a squircle (replaces circular ones). */
+    public static final class BitmapDrawable extends Drawable {
+        private final Bitmap mBitmap;
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG | Paint.FILTER_BITMAP_FLAG);
+        private final Matrix mMatrix = new Matrix();
+        private Path mPath = new Path();
+
+        public BitmapDrawable(Bitmap bitmap) {
+            mBitmap = bitmap;
+            mPaint.setShader(new BitmapShader(bitmap, Shader.TileMode.CLAMP,
+                    Shader.TileMode.CLAMP));
+        }
+
+        public Bitmap getBitmap() {
+            return mBitmap;
+        }
+
+        @Override
+        protected void onBoundsChange(Rect bounds) {
+            mPath = centered(bounds);
+            final float side = Math.min(bounds.width(), bounds.height());
+            final float scale = side / Math.min(mBitmap.getWidth(), mBitmap.getHeight());
+            mMatrix.setScale(scale, scale);
+            mMatrix.postTranslate(bounds.exactCenterX() - mBitmap.getWidth() * scale / 2f,
+                    bounds.exactCenterY() - mBitmap.getHeight() * scale / 2f);
+            mPaint.getShader().setLocalMatrix(mMatrix);
+        }
+
+        @Override
+        public void draw(Canvas canvas) {
+            canvas.drawPath(mPath, mPaint);
+        }
+
+        @Override
+        public void getOutline(Outline outline) {
+            outline.setPath(mPath);
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return mBitmap.getWidth();
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return mBitmap.getHeight();
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            mPaint.setAlpha(alpha);
+            invalidateSelf();
+        }
+
+        @Override
+        public int getAlpha() {
+            return mPaint.getAlpha();
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter cf) {
+            mPaint.setColorFilter(cf);
+            invalidateSelf();
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+}
