diff --git a/res/drawable/n9_action_call.xml b/res/drawable/n9_action_call.xml
new file mode 100644
index 000000000..e0b0d4635
--- /dev/null
+++ b/res/drawable/n9_action_call.xml
@@ -0,0 +1,14 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 (Etesian) call action: green squircle (radius ~28% of the 40dp side). -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="#33FFFFFF">
+    <item>
+        <shape android:shape="rectangle">
+            <corners android:radius="11dp" />
+            <gradient
+                android:angle="270"
+                android:startColor="#7BBF45"
+                android:endColor="#55A32A" />
+        </shape>
+    </item>
+</ripple>
diff --git a/res/drawable/n9_action_message.xml b/res/drawable/n9_action_message.xml
new file mode 100644
index 000000000..560c95c0a
--- /dev/null
+++ b/res/drawable/n9_action_message.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 (Etesian) message action: N9-blue squircle (radius ~28% of the 40dp side),
+     inset 4dp inside the 48dp touch target. -->
+<ripple xmlns:android="http://schemas.android.com/apk/res/android"
+    android:color="#33FFFFFF">
+    <item android:top="4dp" android:bottom="4dp" android:left="4dp" android:right="4dp">
+        <shape android:shape="rectangle">
+            <corners android:radius="11dp" />
+            <solid android:color="@color/n9_blue" />
+        </shape>
+    </item>
+</ripple>
diff --git a/res/drawable/n9_contact_card_header.xml b/res/drawable/n9_contact_card_header.xml
new file mode 100644
index 000000000..db6c0c204
--- /dev/null
+++ b/res/drawable/n9_contact_card_header.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 (Etesian) contact card header: dark vertical gradient. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
+    <gradient
+        android:angle="270"
+        android:startColor="@color/n9_card_header_top"
+        android:endColor="@color/n9_card_header_bottom" />
+</shape>
diff --git a/res/drawable/n9_fastscroll_preview.xml b/res/drawable/n9_fastscroll_preview.xml
new file mode 100644
index 000000000..fa672c97f
--- /dev/null
+++ b/res/drawable/n9_fastscroll_preview.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 (Etesian) fast-scroll letter preview: light squircle with a thin grey border. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
+    <solid android:color="@color/n9_list_background" />
+    <corners android:radius="22dp" />
+    <stroke android:width="1dp" android:color="@color/n9_separator" />
+    <size android:width="80dp" android:height="80dp" />
+</shape>
diff --git a/res/drawable/n9_search_box.xml b/res/drawable/n9_search_box.xml
new file mode 100644
index 000000000..01066cde7
--- /dev/null
+++ b/res/drawable/n9_search_box.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 (Etesian) search field: white rounded box with a 1dp separator-grey border,
+     inset so it floats inside the light toolbar. -->
+<inset xmlns:android="http://schemas.android.com/apk/res/android"
+    android:insetTop="8dp"
