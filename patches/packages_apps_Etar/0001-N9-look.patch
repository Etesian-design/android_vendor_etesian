+        <shape android:shape="rectangle">
+            <solid android:color="@color/n9_toolbar_highlight" />
+        </shape>
+    </item>
+    <item android:gravity="top" android:height="1dp">
+        <shape android:shape="rectangle">
+            <solid android:color="@color/n9_toolbar_edge" />
+        </shape>
+    </item>
+</layer-list>
