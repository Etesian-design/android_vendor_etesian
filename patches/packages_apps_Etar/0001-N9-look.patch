diff --git a/app/src/main/java/com/android/calendar/theme/EtesianTheme.kt b/app/src/main/java/com/android/calendar/theme/EtesianTheme.kt
new file mode 100644
index 00000000..c20b18a3
--- /dev/null
+++ b/app/src/main/java/com/android/calendar/theme/EtesianTheme.kt
@@ -0,0 +1,37 @@
+package com.android.calendar.theme
+
+import android.app.Activity
+import android.content.Context
+import com.bompotis.etesian.theme.EtesianBackground
+
+/**
+ * N9 ROM: the user's Etesian "Apps (light on the N9)" background. N9_LIGHT keeps Calendar's
+ * N9 light look; the dark styles (black, dark grey, wallpaper) switch Etar to its night
+ * resources, and the window background is drawn by [EtesianBackground.apply].
+ */
+object EtesianTheme {
+
+    @JvmStatic
+    fun style(context: Context): EtesianBackground.Style = EtesianBackground.content(context)
+
+    @JvmStatic
+    fun isDark(context: Context): Boolean = style(context).dark
+
+    /** Call after setContentView; returns the applied style for [recreateIfChanged]. */
+    @JvmStatic
+    fun applyBackground(activity: Activity): EtesianBackground.Style {
+        val s = style(activity)
+        EtesianBackground.apply(activity, s)
+        return s
+    }
+
+    /** Call from onResume; recreates the activity when the user picked another background. */
+    @JvmStatic
+    fun recreateIfChanged(activity: Activity, applied: EtesianBackground.Style?): Boolean {
+        if (applied != null && style(activity) != applied) {
+            activity.recreate()
+            return true
+        }
+        return false
+    }
+}
