+    /** The N9 squircle (superellipse, n = 2.8) filling [box], inset by [inset]. */
+    static android.graphics.Path n9Squircle(RectF box, float inset) {
+        final android.graphics.Path path = new android.graphics.Path();
+        final float cx = box.centerX(), cy = box.centerY();
+        final float rx = box.width() / 2f - inset, ry = box.height() / 2f - inset;
+        for (int i = 0; i < 96; i++) {
+            final double t = 2 * Math.PI * i / 96, c = Math.cos(t), sn = Math.sin(t);
+            final float x = (float) (cx + rx * Math.signum(c) * Math.pow(Math.abs(c), 2 / 2.8));
+            final float y = (float) (cy + ry * Math.signum(sn) * Math.pow(Math.abs(sn), 2 / 2.8));
+            if (i == 0) path.moveTo(x, y); else path.lineTo(x, y);
+        }
+        path.close();
+        return path;
+    }
