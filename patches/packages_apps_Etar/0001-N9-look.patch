@@ -0,0 +1,55 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 compact month (phones): weekday row, 6-row grid on a brushed panel,
+     and the selected day's events below -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/month"
+    android:orientation="vertical"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/n9_window_bg">
+
+    <TextView android:id="@+id/month_name"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:visibility="gone"
+        style="@style/MonthView_MiniMonthLabel" />
+
+    <include android:id="@+id/day_names" layout="@layout/n9_month_header" />
+
+    <com.android.calendar.month.MonthListView
+        android:id="@android:id/list"
+        android:layout_width="match_parent"
+        android:layout_height="@dimen/n9_month_grid_height"
+        android:background="@drawable/n9_month_panel_bg"
+        android:cacheColorHint="@android:color/transparent"
+        android:divider="@null"
+        android:drawSelectorOnTop="false" />
+
+    <View
+        android:layout_width="match_parent"
+        android:layout_height="1dp"
+        android:background="@color/agenda_list_separator_color" />
+
+    <FrameLayout
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1">
+
+        <ListView
+            android:id="@+id/n9_day_events"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:divider="@color/agenda_list_separator_color"
+            android:dividerHeight="1px" />
+
+        <TextView
+            android:id="@+id/n9_day_events_empty"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:gravity="center"
+            android:text="@string/n9_no_events"
+            android:textColor="@color/n9_text_secondary"
+            android:textFontWeight="300"
+            android:textSize="20sp" />
+    </FrameLayout>
+</LinearLayout>
diff --git a/app/src/main/res/layout/n9_month_event_item.xml b/app/src/main/res/layout/n9_month_event_item.xml
new file mode 100644
index 00000000..9ba00bab
--- /dev/null
+++ b/app/src/main/res/layout/n9_month_event_item.xml
@@ -0,0 +1,45 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 compact month: one event of the selected day (like an agenda row) -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:minHeight="64dip"
+    android:background="@color/n9_window_bg"
+    android:orientation="horizontal">
+
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:layout_gravity="center_vertical"
+        android:layout_marginStart="16dip"
+        android:layout_marginEnd="8dip"
+        android:paddingTop="8dip"
+        android:paddingBottom="8dip"
+        android:orientation="vertical">
+
+        <TextView
+            android:id="@+id/n9_event_title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:ellipsize="end"
+            android:singleLine="true"
+            android:textColor="@color/n9_text"
+            android:textSize="20sp"
+            android:textStyle="bold" />
+
+        <TextView
+            android:id="@+id/n9_event_when"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:ellipsize="end"
+            android:singleLine="true"
+            android:textColor="@color/agenda_item_where_text_color"
+            android:textSize="16sp" />
+    </LinearLayout>
+
+    <View
+        android:id="@+id/n9_event_color"
+        android:layout_width="6dip"
+        android:layout_height="match_parent" />
+</LinearLayout>
