new file mode 100644
index 00000000..a272f163
--- /dev/null
+++ b/app/src/main/res/drawable/n9_bottom_bar_bg.xml
@@ -0,0 +1,21 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 bottom toolbar: grey vertical gradient with a dark edge over a light line on top -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item>
+        <shape android:shape="rectangle">
