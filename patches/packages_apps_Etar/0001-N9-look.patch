diff --git a/app/src/main/res/layout-land/n9_full_month_by_week.xml b/app/src/main/res/layout-land/n9_full_month_by_week.xml
new file mode 100644
index 00000000..060cd4bc
--- /dev/null
+++ b/app/src/main/res/layout-land/n9_full_month_by_week.xml
@@ -0,0 +1,63 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- N9 compact month, phone landscape: the grid on the left, the selected day's events
+     beside it (below it there would be no room left). -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:id="@+id/month"
+    android:orientation="horizontal"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/n9_window_bg">
+
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1"
+        android:orientation="vertical"
+        android:background="@drawable/n9_month_panel_bg">
+
+        <TextView android:id="@+id/month_name"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:visibility="gone"
+            style="@style/MonthView_MiniMonthLabel" />
+
+        <include android:id="@+id/day_names" layout="@layout/n9_month_header" />
+
+        <com.android.calendar.month.MonthListView
+            android:id="@android:id/list"
+            android:layout_width="match_parent"
+            android:layout_height="0dp"
+            android:layout_weight="1"
+            android:cacheColorHint="@android:color/transparent"
+            android:divider="@null"
+            android:drawSelectorOnTop="false" />
+    </LinearLayout>
+
+    <View
+        android:layout_width="1dp"
+        android:layout_height="match_parent"
+        android:background="@color/agenda_list_separator_color" />
+
+    <FrameLayout
+        android:layout_width="0dp"
+        android:layout_height="match_parent"
+        android:layout_weight="1">
+
+        <ListView
+            android:id="@+id/n9_day_events"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:divider="@color/agenda_list_separator_color"
+            android:dividerHeight="1px" />
+
+        <TextView
+            android:id="@+id/n9_day_events_empty"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:gravity="center"
+            android:text="@string/n9_no_events"
+            android:textColor="@color/n9_text_secondary"
+            android:textFontWeight="300"
+            android:textSize="20sp" />
+    </FrameLayout>
+</LinearLayout>
