+    // The settings page
+
+    private fun openPage() {
+        if (recording) return
+        showFlashStrip(false)
+        renderPage()
+        page.scrollTo(0, 0)
+        page.isVisible = true
+        vf.isVisible = false
+        updateBack()
+    }
+
+    private fun closePage() {
+        page.isVisible = false
+        vf.isVisible = true
+        updateBack()
+    }
+
+    private fun changed(rebind: Boolean = false) {
+        if (rebind) onRebind() else onCaptureOptionsChanged()
+        updateInfoPill()
+        if (page.isVisible) {
+            val y = page.scrollY
+            renderPage()
+            page.post { page.scrollTo(0, y) }
+        }
+    }
+
+    private fun tv(t: String, size: Float, color: Int = Color.WHITE, face: android.graphics.Typeface = N9.text) =
+        TextView(a).apply { text = t; setTextSize(TypedValue.COMPLEX_UNIT_PX, size * d); setTextColor(color); typeface = face }
+
+    /** The large light heading of a part ("Image capture settings", "Camera settings"). */
+    private fun heading(t: String) {
+        pageBody.addView(tv(t, 21f, face = N9.light).apply { setPadding(0, dp(14), 0, dp(6)) })
+    }
+
+    /** A small bold grey section title with a thin rule after it. */
+    private fun section(t: String, into: LinearLayout = pageBody) {
+        into.addView(LinearLayout(a).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            addView(tv(t, 10.5f, N9.GREY_TEXT, N9.bold))
+            addView(View(a).apply { setBackgroundColor(N9.RULE) },
+                LinearLayout.LayoutParams(0, dp(1), 1f).apply { marginStart = dp(8) })
+            setPadding(0, dp(9), 0, dp(8))
+        })
+    }
+
+    private data class Tile(val icon: Int, val label: String, val selected: Boolean, val onClick: () -> Unit)
+
+    /** Tiles, 3 per row: solid dark on the page ([glass] false), see-through grey over the picture. */
+    private fun tiles(items: List<Tile>, into: LinearLayout, glass: Boolean) {
+        items.chunked(3).forEach { row ->
+            val r = LinearLayout(a).apply { orientation = LinearLayout.HORIZONTAL; setPadding(0, 0, 0, dp(11)) }
+            row.forEach { t ->
+                r.addView(LinearLayout(a).apply {
+                    orientation = LinearLayout.VERTICAL
+                    gravity = Gravity.CENTER_HORIZONTAL
+                    contentDescription = t.label
+                    isSelected = t.selected
+                    setOnClickListener { t.onClick() }
+                    addView(ImageView(a).apply {
+                        setImageResource(t.icon)
+                        scaleType = ImageView.ScaleType.FIT_CENTER
+                        setPadding(dp(8))
+                        imageTintList = ColorStateList.valueOf(Color.WHITE)
+                        background = N9SquircleDrawable(N9.TILE_BOTTOM, 0, d).apply {
+                            when {
+                                t.selected -> { setGradient(intArrayOf(N9.BLUE_TOP, N9.BLUE_BOTTOM)); rim = N9.BLUE_RIM }
+                                glass -> fill = N9.TILE_GLASS
+                                else -> setGradient(intArrayOf(N9.TILE_TOP, N9.TILE_BOTTOM))
+                            }
+                            Unit
+                        }
+                    }, LinearLayout.LayoutParams(dp(40), dp(40)))
+                    addView(tv(t.label, 11.5f, 0xFFCCCCCC.toInt()).apply { setPadding(0, dp(5), 0, 0) })
+                }, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            }
+            repeat(3 - row.size) { r.addView(View(a), LinearLayout.LayoutParams(0, 0, 1f)) }
+            into.addView(r)
+        }
+    }
+
+    /** A row with a round blue icon, bold title and grey value. */
+    private fun iconRow(icon: Int, title: String, value: String, id: Int, onClick: () -> Unit) {
+        pageBody.addView(LinearLayout(a).apply {
+            this.id = id
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            minimumHeight = dp(53)
+            setOnClickListener { onClick() }
+            addView(ImageView(a).apply {
+                setImageResource(icon)
+                scaleType = ImageView.ScaleType.FIT_CENTER
+                setPadding(dp(7))
+                imageTintList = ColorStateList.valueOf(Color.WHITE)
+                // A blue squircle (n9cam-0), as the scene tiles.
+                background = N9SquircleDrawable(N9.BLUE, 0, d).apply {
+                    setGradient(intArrayOf(N9.BLUE_TOP, N9.BLUE_BOTTOM))
+                }
+            }, LinearLayout.LayoutParams(dp(40), dp(40)).apply { marginEnd = dp(12) })
+            addView(LinearLayout(a).apply {
+                orientation = LinearLayout.VERTICAL
+                addView(tv(title, 17f, face = N9.bold))
+                addView(tv(value, 13f, N9.VALUE_TEXT))
+            })
+        })
+    }
+
+    /** A segmented group, portrait: stacked, centred, 2/3 of the width; the selected row flat blue. */
+    private fun group(options: List<String>, selected: Int, onSelect: (Int) -> Unit) {
+        val box = LinearLayout(a).apply {
+            orientation = LinearLayout.VERTICAL
+            clipToOutline = true
+            outlineProvider = object : android.view.ViewOutlineProvider() {
+                override fun getOutline(v: View, o: android.graphics.Outline) =
+                    o.setRoundRect(0, 0, v.width, v.height, dp(6).toFloat())
+            }
+        }
+        options.forEachIndexed { i, s ->
+            box.addView(tv(s, 13.5f, face = N9.bold).apply {
+                gravity = Gravity.CENTER
+                isSelected = i == selected
+                background = if (i == selected) {
+                    GradientDrawable().apply { setColor(N9.BLUE) }
+                } else {
+                    GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                        intArrayOf(0xFF3A3A3A.toInt(), 0xFF1E1E1E.toInt()))
+                }
+                setOnClickListener { onSelect(i) }
+            }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(33)).apply {
+                if (i > 0) topMargin = dp(1)
+            })
+        }
+        box.setBackgroundColor(Color.BLACK)
+        val w = (a.resources.displayMetrics.widthPixels * 2 / 3)
+        pageBody.addView(box, LinearLayout.LayoutParams(w, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+            gravity = Gravity.CENTER_HORIZONTAL
+            bottomMargin = dp(4)
+        })
+    }
+
+    /** A switch row: title, an optional icon before the switch, an optional explanation under it. */
+    private fun switchRow(title: String, on: Boolean, icon: Int? = null, note: String? = null, onChange: (Boolean) -> Unit) {
+        val sw = N9Switch(a).apply { setCheckedNow(on); contentDescription = title; this.onChange = onChange }
+        pageBody.addView(LinearLayout(a).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            minimumHeight = dp(44)
+            setOnClickListener { sw.performClick() }
+            addView(tv(title, 17f, face = N9.bold), LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            icon?.let {
+                addView(ImageView(a).apply {
+                    setImageResource(it); imageTintList = ColorStateList.valueOf(Color.WHITE)
+                }, LinearLayout.LayoutParams(dp(20), dp(20)).apply { marginEnd = dp(18) })
+            }
+            addView(sw)
+        })
+        note?.let { pageBody.addView(tv(it, 14f).apply { setPadding(0, dp(2), 0, dp(8)) }) }
+    }
+
+    private fun renderPage() {
+        pageBody.removeAllViews()
+        val c = config ?: return
+        val video = c is CameraConfiguration.Video
+        val caps = cap.caps(c.camera.cameraId)
+
+        heading(if (video) "Video recording settings" else "Image capture settings")
+
+        // Scene: Automatic plus what the camera lists (Camera2 scene modes; macro is the AF mode).
+        val scenes = buildList {
+            add(N9Capture.AUTO_SCENE to "Automatic")
+            if (video) {
+                if (CameraMetadata.CONTROL_SCENE_MODE_NIGHT in caps.scenes) {
+                    add(CameraMetadata.CONTROL_SCENE_MODE_NIGHT to "Video at night")
+                }
+            } else {
+                if (caps.macro) add(N9Capture.MACRO_SCENE to "Macro")
+                for ((m, l) in listOf(
+                    CameraMetadata.CONTROL_SCENE_MODE_LANDSCAPE to "Landscape",
+                    CameraMetadata.CONTROL_SCENE_MODE_PORTRAIT to "Portrait",
+                    CameraMetadata.CONTROL_SCENE_MODE_NIGHT to "Night",
+                    CameraMetadata.CONTROL_SCENE_MODE_SPORTS to "Sports",
+                )) if (m in caps.scenes) add(m to l)
+            }
+        }
+        if (scenes.size > 1) {
+            section("Scene")
+            val cur = cap.scene(video)
+            tiles(scenes.map { (m, l) ->
+                Tile(sceneIcon(m), l, m == cur) { cap.setScene(video, m); changed() }
+            }, pageBody, glass = false)
+        }
+
+        if (wbChoices(caps).size > 1) {
+            iconRow(wbIcon(cap.whiteBalance), "White balance", wbChoices(caps)
+                .firstOrNull { it.first == cap.whiteBalance }?.second ?: "Automatic", R.id.n9WhiteBalance) {
+                openPanel(Panel.WB)
+            }
+        }
+        if (c.camera.exposureCompensationRange.let { it.start < it.endInclusive }) {
+            iconRow(R.drawable.n9_ic_exposure, "Exposure compensation",
+                "%.1f".format(cap.exposureThirds / 3f).replace("-0.0", "0.0").let {
+                    if (cap.exposureThirds > 0) "+$it" else it
+                }, R.id.n9Exposure) { openPanel(Panel.EV) }
+        }
+        if (filterChoices(caps).size > 1) {
+            iconRow(filterIcon(cap.colourFilter), "Colour filter", filterChoices(caps)
+                .firstOrNull { it.first == cap.colourFilter }?.second ?: "Off", R.id.n9ColourFilter) {
+                openPanel(Panel.FILTER)
+            }
+        }
+
+        section("Self-timer")
+        val timers = listOf(TimerMode.OFF to "Disabled", TimerMode.ON_3S to "3 seconds", TimerMode.ON_10S to "10 seconds")
+        group(timers.map { it.second }, timers.indexOfFirst { it.first == vm.timerMode.value }) {
+            vm.setTimerMode(timers[it].first); changed()
+        }
+
+        when (c) {
+            is CameraConfiguration.Photo -> {
+                section("Aspect ratio")
+                val ratios = listOf(AspectRatio.RATIO_16_9 to "16:9", AspectRatio.RATIO_4_3 to "4:3")
+                group(ratios.map { it.second }, ratios.indexOfFirst { it.first == c.photoAspectRatio }) {
+                    if (ratios[it].first != c.photoAspectRatio) vm.cyclePhotoAspectRatio()
+                    page.postDelayed({ changed() }, 400)
+                }
+                val sizes = caps.resolutions(ratio(c))
+                if (sizes.size > 1) {
+                    section("Resolution")
+                    val names = listOf("High", "Medium", "Low")
+                    group(sizes.mapIndexed { i, s -> "${names[i]} ${N9Capture.megapixels(s).dropLast(1)} Mpx" },
+                        cap.resolution.coerceAtMost(sizes.size - 1)) {
+                        cap.resolution = it; changed(rebind = true)
+                    }
+                }
+                if (caps.faceDetection) {
+                    switchRow("Face detection", cap.faceDetection, R.drawable.n9_ic_face) {
+                        cap.faceDetection = it; changed()
+                    }
+                }
+            }
+
+            is CameraConfiguration.Video -> {
+                val qualities = c.camera.supportedVideoQualities.keys.sortedBy {
+                    listOf(Quality.UHD, Quality.QHD, Quality.FHD, Quality.HD, Quality.SD).indexOf(it)
+                }
+                if (qualities.size > 1) {
+                    section("Resolution")
+                    group(qualities.map { qualityName(it) }, qualities.indexOf(c.videoQuality)) {
+                        vm.setVideoQuality(qualities[it])
+                        page.postDelayed({ changed() }, 400)
+                    }
+                }
+            }
+
+            else -> {}
+        }
+
+        // Front or back: two values, a straight toggle (kept off the viewfinder).
+        if (vm.canFlipCamera.value) {
+            switchRow("Front camera", c.camera.cameraFacing == CameraFacing.FRONT) {
+                vm.flipCamera()
+                page.postDelayed({ changed() }, 400)
+            }
+        }
+
+        heading("Camera settings")
+        if (!video) {
+            section("Show captured content")
+            val reviews = listOf(0 to "Disabled", 2 to "2 seconds", 5 to "5 seconds", -1 to "No time-out")
+            group(reviews.map { it.second }, reviews.indexOfFirst { it.first == prefs.getInt("review", 0) }) {
+                prefs.edit { putInt("review", reviews[it].first) }; changed()
+            }
+        }
+        switchRow("Show grid lines", vm.gridMode.value != GridMode.OFF) {
+            vm.setGridMode(if (it) GridMode.ON_3 else GridMode.OFF)
+        }
+        if (!video) {
+            pageBody.addView(tv("Creator name", 14f, N9.GREY_TEXT).apply { setPadding(0, dp(6), 0, dp(4)) })
+            pageBody.addView(EditText(a).apply {
+                id = R.id.n9CreatorName
+                hint = "Name or copyright"
+                setText(prefs.getString("creator", ""))
+                setTextColor(Color.BLACK)
+                setHintTextColor(0xFF8C8C8C.toInt())
+                typeface = N9.text
+                setTextSize(TypedValue.COMPLEX_UNIT_PX, 15f * d)
+                setSingleLine(true)
+                background = N9SquircleDrawable(0xFFE6E6E6.toInt(), 0xFFB4B4B4.toInt(), d, ends = true)
+                setPadding(dp(14), 0, dp(14), 0)
+                addTextChangedListener(object : TextWatcher {
+                    override fun beforeTextChanged(s: CharSequence?, st: Int, c: Int, af: Int) {}
+                    override fun onTextChanged(s: CharSequence?, st: Int, b: Int, c: Int) {}
+                    override fun afterTextChanged(s: Editable?) {
+                        prefs.edit { putString("creator", s?.toString()?.trim()) }
+                    }
+                })
+            }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(32)))
+        }
+        switchRow("Use GPS", vm.saveLocation.value == true, R.drawable.ic_location_on,
+            "GPS coordinates will be attached to images and videos if GPS is available. If images or " +
+                    "videos are shared, location data might be visible to third parties.") {
+            onGpsChanged(it)
+        }
+
+        pageBody.addView(tv("All camera settings", 17f, face = N9.bold).apply {
+            id = R.id.n9AllSettings
+            minHeight = dp(44)
+            gravity = Gravity.CENTER_VERTICAL
+            setOnClickListener { onAllSettings() }
+        })
+    }
+
+    private fun qualityName(q: Quality) = when (q) {
+        Quality.UHD -> "4K (2160p)"
+        Quality.QHD -> "QHD (1440p)"
+        Quality.FHD -> "Full HD (1080p)"
+        Quality.HD -> "HD (720p)"
+        Quality.SD -> "SD (480p)"
+        else -> q.toString()
+    }
+
+    // Panels over the live picture
+
+    private enum class Panel { WB, EV, FILTER }
+
+    private fun wbChoices(caps: N9Capture.Caps) = listOf(
+        CameraMetadata.CONTROL_AWB_MODE_AUTO to "Automatic",
+        CameraMetadata.CONTROL_AWB_MODE_DAYLIGHT to "Sunny",
+        CameraMetadata.CONTROL_AWB_MODE_CLOUDY_DAYLIGHT to "Cloudy",
+        CameraMetadata.CONTROL_AWB_MODE_FLUORESCENT to "Fluorescent",
+        CameraMetadata.CONTROL_AWB_MODE_INCANDESCENT to "Incandescent",
+    ).filter { it.first == CameraMetadata.CONTROL_AWB_MODE_AUTO || it.first in caps.awb }
+
+    private fun wbIcon(m: Int) = when (m) {
+        CameraMetadata.CONTROL_AWB_MODE_DAYLIGHT -> R.drawable.n9_ic_wb_sunny
+        CameraMetadata.CONTROL_AWB_MODE_CLOUDY_DAYLIGHT -> R.drawable.n9_ic_wb_cloudy
+        CameraMetadata.CONTROL_AWB_MODE_FLUORESCENT -> R.drawable.n9_ic_wb_fluorescent
+        CameraMetadata.CONTROL_AWB_MODE_INCANDESCENT -> R.drawable.n9_ic_wb_incandescent
+        else -> R.drawable.n9_ic_wb_auto
+    }
+
+    // Vivid has no Camera2 colour effect, so it is not offered.
+    private fun filterChoices(caps: N9Capture.Caps) = listOf(
+        CameraMetadata.CONTROL_EFFECT_MODE_OFF to "Off",
+        CameraMetadata.CONTROL_EFFECT_MODE_MONO to "Black & white",
+        CameraMetadata.CONTROL_EFFECT_MODE_SEPIA to "Sepia",
+        CameraMetadata.CONTROL_EFFECT_MODE_NEGATIVE to "Negative",
+        CameraMetadata.CONTROL_EFFECT_MODE_SOLARIZE to "Solarise",
+        CameraMetadata.CONTROL_EFFECT_MODE_POSTERIZE to "Posterise",
+    ).filter { it.first == CameraMetadata.CONTROL_EFFECT_MODE_OFF || it.first in caps.effects }
+
+    private fun filterIcon(m: Int) = when (m) {
+        CameraMetadata.CONTROL_EFFECT_MODE_MONO -> R.drawable.n9_ic_filter_mono
+        CameraMetadata.CONTROL_EFFECT_MODE_SEPIA -> R.drawable.n9_ic_filter_sepia
+        CameraMetadata.CONTROL_EFFECT_MODE_NEGATIVE -> R.drawable.n9_ic_filter_negative
+        CameraMetadata.CONTROL_EFFECT_MODE_SOLARIZE -> R.drawable.n9_ic_filter_solarise
+        CameraMetadata.CONTROL_EFFECT_MODE_POSTERIZE -> R.drawable.n9_ic_filter_posterize
+        else -> R.drawable.n9_ic_filter_off
+    }
+
+    private var openPanelKind: Panel? = null
+
+    private fun openPanel(p: Panel) {
+        openPanelKind = p
+        renderPanel()
+        page.isVisible = false
+        vf.isVisible = false
+        panel.isVisible = true
+        updateBack()
+    }
+
+    private fun closePanel() {
+        panel.isVisible = false
+        openPanelKind = null
+        renderPage()
+        page.isVisible = true
+        updateBack()
+    }
+
+    private fun renderPanel() {
+        panel.removeAllViews()
+        val c = config ?: return
+        val caps = cap.caps(c.camera.cameraId)
+        val body = LinearLayout(a).apply { orientation = LinearLayout.VERTICAL; setPadding(dp(11), 0, dp(11), 0) }
+        panel.addView(body)
+        when (openPanelKind) {
+            Panel.WB -> {
+                section("White balance", body)
+                tiles(wbChoices(caps).map { (m, l) ->
+                    Tile(wbIcon(m), l, m == cap.whiteBalance) { cap.whiteBalance = m; onCaptureOptionsChanged(); renderPanel() }
+                }, body, glass = true)
+            }
+
+            Panel.FILTER -> {
+                section("Colour filter", body)
+                tiles(filterChoices(caps).map { (m, l) ->
+                    Tile(filterIcon(m), l, m == cap.colourFilter) { cap.colourFilter = m; onCaptureOptionsChanged(); renderPanel() }
+                }, body, glass = true)
+            }
+
+            Panel.EV -> {
+                section("Exposure compensation", body)
+                body.addView(N9SteppedSlider(a).apply {
+                    id = R.id.n9ExposureSlider
+                    contentDescription = "Exposure compensation"
+                    value = cap.exposureThirds
+                    onChange = { cap.exposureThirds = it; onCaptureOptionsChanged() }
+                })
+            }
+
+            null -> {}
+        }
+    }
+
+    fun isOverlayOpen() = page.isVisible || panel.isVisible
+}
