+            constrainHeight(R.id.galleryButtonCardView, (60 * dp).toInt())
+            connect(R.id.galleryButtonCardView, ConstraintSet.BOTTOM, ConstraintSet.PARENT_ID, ConstraintSet.BOTTOM, margin)
+            centerHorizontally(R.id.galleryButtonCardView, ConstraintSet.PARENT_ID)
+
+            clear(R.id.videoRecordingStateButton)
