+        CameraMetadata.CONTROL_SCENE_MODE_PORTRAIT -> R.drawable.n9_ic_scene_portrait
+        CameraMetadata.CONTROL_SCENE_MODE_NIGHT -> R.drawable.n9_ic_scene_night
+        CameraMetadata.CONTROL_SCENE_MODE_SPORTS -> R.drawable.n9_ic_scene_sports
+        else -> R.drawable.n9_ic_scene_auto
