@@ -0,0 +1,177 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Etesian
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.ui.n9
+
+import android.graphics.Canvas
+import android.graphics.LinearGradient
+import android.graphics.Shader
+import android.graphics.ColorFilter
+import android.graphics.Outline
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+import android.view.View
+import android.view.ViewOutlineProvider
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.pow
+import kotlin.math.sign
+import kotlin.math.sin
+
+/**
+ * Etesian: the N9 camera's control face. A squircle (n = 2.8, the curve of the ROM's icons and
+ * vendor/etesian/patches/tools/squircle9.py) with a thin light rim. A long control ([ends]) gets
+ * squircle-half ends as wide as its short side, pulled apart, the middle straight (the pills).
+ */
+class N9SquircleDrawable(
+    fill: Int,
+    rim: Int,
+    private val density: Float,
+    private val ends: Boolean = false,
+) : Drawable() {
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = fill }
+    private val rimPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE; strokeWidth = density; color = rim
+    }
+    private val path = Path()
+
+    var fill: Int
+        get() = fillPaint.color
+        set(value) { fillPaint.color = value; gradient = null; fillPaint.shader = null; invalidateSelf() }
+
+    var rim: Int
+        get() = rimPaint.color
+        set(value) { rimPaint.color = value; invalidateSelf() }
+
+    private var gradient: IntArray? = null
+
+    /** A top-to-bottom gradient fill in place of [fill] (null: the plain fill). */
+    fun setGradient(colors: IntArray?) {
+        if (colors.contentEquals(gradient)) return
+        gradient = colors
+        updateShader()
+        invalidateSelf()
+    }
+
+    private fun updateShader() {
+        val g = gradient
+        val b = bounds
+        fillPaint.shader = if (g == null || b.isEmpty) null else LinearGradient(
+            0f, b.top.toFloat(), 0f, b.bottom.toFloat(), g, null, Shader.TileMode.CLAMP
+        )
+    }
+
+    override fun onBoundsChange(b: Rect) {
+        updateShader()
+        path.reset()
+        val inset = density / 2
+        path.addPath(shape(b.left + inset, b.top + inset, b.right - inset, b.bottom - inset, ends))
+    }
+
+    override fun draw(c: Canvas) {
+        c.drawPath(path, fillPaint)
+        if (rimPaint.alpha > 0) c.drawPath(path, rimPaint)
+    }
+
+    override fun getOutline(outline: Outline) {
+        @Suppress("DEPRECATION")
+        outline.setConvexPath(path)
+    }
+
+    override fun setAlpha(a: Int) { fillPaint.alpha = a; rimPaint.alpha = a }
+    override fun setColorFilter(cf: ColorFilter?) { fillPaint.colorFilter = cf; rimPaint.colorFilter = cf }
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity() = PixelFormat.TRANSLUCENT
+
+    companion object {
+        private const val N = 2.8
+
+        /** A squircle in the box; with [ends], squircle halves at the ends of its long side. */
+        fun shape(l: Float, t: Float, r: Float, b: Float, ends: Boolean): Path {
+            val p = Path()
+            val h = b - t
+            val w = r - l
+            when {
+                !ends || abs(w - h) < 1f -> curve(p, (l + r) / 2, (t + b) / 2, w / 2, h / 2, 0.0, 360.0, true)
+                w > h -> {
+                    val ry = h / 2
+                    curve(p, l + ry, t + ry, ry, ry, 90.0, 270.0, true)
+                    curve(p, r - ry, t + ry, ry, ry, 270.0, 450.0, false)
+                }
+                else -> {
+                    val rx = w / 2
+                    curve(p, l + rx, t + rx, rx, rx, 0.0, 180.0, true)
+                    curve(p, l + rx, b - rx, rx, rx, 180.0, 360.0, false)
+                }
+            }
+            p.close()
+            return p
+        }
+
+        private fun curve(
+            p: Path, cx: Float, cy: Float, rx: Float, ry: Float, from: Double, to: Double, first: Boolean,
+        ) {
+            var a = from
+            var move = first
+            while (a <= to + 0.001) {
+                val th = Math.toRadians(a)
+                val c = cos(th)
+                val s = sin(th)
+                val x = cx + rx * sign(c) * abs(c).pow(2.0 / N)
+                val y = cy - ry * sign(s) * abs(s).pow(2.0 / N)
+                if (move) {
+                    p.moveTo(x.toFloat(), y.toFloat()); move = false
+                } else {
+                    p.lineTo(x.toFloat(), y.toFloat())
+                }
+                a += 3.0
+            }
+        }
+
+        /** Clips a view (the gallery's picture) to the same squircle. */
+        fun outline() = object : ViewOutlineProvider() {
+            override fun getOutline(v: View, o: Outline) {
+                @Suppress("DEPRECATION")
+                o.setConvexPath(shape(0f, 0f, v.width.toFloat(), v.height.toFloat(), false))
+            }
+        }
+    }
+}
+
+/** The N9 focus brackets: four corners, white, blue once the focus locks. */
+class N9BracketsDrawable(private val density: Float) : Drawable() {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE; strokeWidth = 2 * density; color = 0xFFFFFFFF.toInt()
+        strokeCap = Paint.Cap.SQUARE
+    }
+
+    var color: Int
+        get() = paint.color
+        set(value) { paint.color = value; invalidateSelf() }
+
+    override fun draw(c: Canvas) {
+        val b = bounds
+        val i = paint.strokeWidth / 2
+        val l = b.left + i
+        val t = b.top + i
+        val r = b.right - i
+        val btm = b.bottom - i
+        val arm = 12 * density
+        c.drawLine(l, t, l + arm, t, paint); c.drawLine(l, t, l, t + arm, paint)
+        c.drawLine(r, t, r - arm, t, paint); c.drawLine(r, t, r, t + arm, paint)
+        c.drawLine(l, btm, l + arm, btm, paint); c.drawLine(l, btm, l, btm - arm, paint)
+        c.drawLine(r, btm, r - arm, btm, paint); c.drawLine(r, btm, r, btm - arm, paint)
+    }
+
+    override fun setAlpha(a: Int) { paint.alpha = a }
+    override fun setColorFilter(cf: ColorFilter?) { paint.colorFilter = cf }
+
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity() = PixelFormat.TRANSLUCENT
+}
