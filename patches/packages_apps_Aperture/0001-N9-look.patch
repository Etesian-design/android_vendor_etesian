+
+package org.lineageos.aperture.ui.n9
+
+import android.content.Context
+import android.graphics.ImageFormat
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.hardware.camera2.CameraMetadata
+import android.hardware.camera2.CaptureRequest
+import android.util.Size
+import androidx.camera.camera2.interop.CaptureRequestOptions
+import androidx.core.content.edit
+import org.lineageos.aperture.models.FlashMode
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+/**
+ * Etesian: the N9 image capture settings that Aperture has no setting for, all of them real
+ * Camera2 controls applied through CameraX's Camera2 interop: scene, white balance, colour
+ * filter, face detection, red-eye flash, and the picture's resolution. Each one is only offered
+ * when the camera lists it in its characteristics.
+ */
+@androidx.annotation.OptIn(androidx.camera.camera2.interop.ExperimentalCamera2Interop::class)
+class N9Capture(context: Context) {
+    private val prefs = context.getSharedPreferences("n9_capture", Context.MODE_PRIVATE)
+    private val cameraManager = context.getSystemService(CameraManager::class.java)
+
+    /** What one camera can do. */
+    class Caps(c: CameraCharacteristics?) {
+        val scenes: Set<Int> = c?.get(CameraCharacteristics.CONTROL_AVAILABLE_SCENE_MODES)
+            ?.toSet().orEmpty()
+        val awb: Set<Int> = c?.get(CameraCharacteristics.CONTROL_AWB_AVAILABLE_MODES)
+            ?.toSet().orEmpty()
+        val effects: Set<Int> = c?.get(CameraCharacteristics.CONTROL_AVAILABLE_EFFECTS)
+            ?.toSet().orEmpty()
+        val afModes: Set<Int> = c?.get(CameraCharacteristics.CONTROL_AF_AVAILABLE_MODES)
+            ?.toSet().orEmpty()
+        val aeModes: Set<Int> = c?.get(CameraCharacteristics.CONTROL_AE_AVAILABLE_MODES)
+            ?.toSet().orEmpty()
+        val faceModes: Set<Int> =
+            c?.get(CameraCharacteristics.STATISTICS_INFO_AVAILABLE_FACE_DETECT_MODES)
+                ?.toSet().orEmpty()
+        val jpegSizes: List<Size> = c?.get(CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP)
+            ?.getOutputSizes(ImageFormat.JPEG)?.sortedByDescending { it.width * it.height }
+            .orEmpty()
+
+        val macro get() = CameraMetadata.CONTROL_AF_MODE_MACRO in afModes
+        val redEye get() = CameraMetadata.CONTROL_AE_MODE_ON_AUTO_FLASH_REDEYE in aeModes
+        val faceDetection get() = faceModes.any { it != CameraMetadata.STATISTICS_FACE_DETECT_MODE_OFF }
+
+        /** High, medium and low sizes of [ratio] (w/h), as the N9's 7, 6 and 3 Mpx. */
+        fun resolutions(ratio: Float): List<Size> {
+            val sizes = jpegSizes.filter { abs(it.width.toFloat() / it.height - ratio) < 0.02f }
+            if (sizes.isEmpty()) return listOf()
+            val max = sizes.first().width * sizes.first().height
+            val picks = listOf(1.0, 0.5, 0.25).map { f ->
+                sizes.minBy { abs(it.width * it.height - max * f) }
+            }
+            return picks.distinct()
+        }
+    }
+
+    private val capsCache = mutableMapOf<String, Caps>()
+
+    fun caps(cameraId: String): Caps = capsCache.getOrPut(cameraId) {
+        Caps(runCatching { cameraManager.getCameraCharacteristics(cameraId) }.getOrNull())
+    }
+
+    // The settings (N9 values; AUTO_SCENE means Automatic)
+
+    fun scene(video: Boolean) = prefs.getInt(if (video) "scene_video" else "scene_photo", AUTO_SCENE)
+    fun setScene(video: Boolean, scene: Int) =
+        prefs.edit { putInt(if (video) "scene_video" else "scene_photo", scene) }
+
+    var whiteBalance: Int
+        get() = prefs.getInt("wb", CameraMetadata.CONTROL_AWB_MODE_AUTO)
+        set(v) = prefs.edit { putInt("wb", v) }
+
+    var colourFilter: Int
+        get() = prefs.getInt("effect", CameraMetadata.CONTROL_EFFECT_MODE_OFF)
+        set(v) = prefs.edit { putInt("effect", v) }
+
+    /** Exposure compensation in thirds of a step, -6..6 (the N9's -2..+2). */
+    var exposureThirds: Int
+        get() = prefs.getInt("ev_thirds", 0)
+        set(v) = prefs.edit { putInt("ev_thirds", v.coerceIn(-6, 6)) }
+
+    var faceDetection: Boolean
+        get() = prefs.getBoolean("face", true)
+        set(v) = prefs.edit { putBoolean("face", v) }
+
+    var redEye: Boolean
+        get() = prefs.getBoolean("redeye", false)
+        set(v) = prefs.edit { putBoolean("redeye", v) }
+
+    /** 0 high, 1 medium, 2 low. */
+    var resolution: Int
+        get() = prefs.getInt("resolution", 0)
+        set(v) = prefs.edit { putInt("resolution", v) }
+
+    fun resolutionSize(cameraId: String, ratio: Float): Size? =
+        caps(cameraId).resolutions(ratio).let { it.getOrNull(resolution) ?: it.firstOrNull() }
+
+    /** Adds the N9 settings this camera supports to [builder]. */
+    fun apply(builder: CaptureRequestOptions.Builder, cameraId: String, video: Boolean, flashMode: FlashMode) {
+        val caps = caps(cameraId)
+        val scene = scene(video)
+        when {
+            scene == MACRO_SCENE && caps.macro && !video ->
+                builder.setCaptureRequestOption(CaptureRequest.CONTROL_AF_MODE, CameraMetadata.CONTROL_AF_MODE_MACRO)
+
+            scene >= 0 && scene in caps.scenes -> {
+                builder.setCaptureRequestOption(CaptureRequest.CONTROL_MODE, CameraMetadata.CONTROL_MODE_USE_SCENE_MODE)
+                builder.setCaptureRequestOption(CaptureRequest.CONTROL_SCENE_MODE, scene)
+            }
+        }
+        whiteBalance.takeIf { it in caps.awb && it != CameraMetadata.CONTROL_AWB_MODE_AUTO }?.let {
+            builder.setCaptureRequestOption(CaptureRequest.CONTROL_AWB_MODE, it)
+        }
+        colourFilter.takeIf { it in caps.effects && it != CameraMetadata.CONTROL_EFFECT_MODE_OFF }?.let {
+            builder.setCaptureRequestOption(CaptureRequest.CONTROL_EFFECT_MODE, it)
+        }
+        if (faceDetection && caps.faceDetection) {
+            builder.setCaptureRequestOption(
+                CaptureRequest.STATISTICS_FACE_DETECT_MODE,
+                if (CameraMetadata.STATISTICS_FACE_DETECT_MODE_FULL in caps.faceModes) {
+                    CameraMetadata.STATISTICS_FACE_DETECT_MODE_FULL
+                } else {
+                    CameraMetadata.STATISTICS_FACE_DETECT_MODE_SIMPLE
+                }
+            )
+        }
+        if (!video && redEye && flashMode == FlashMode.AUTO && caps.redEye) {
+            builder.setCaptureRequestOption(
+                CaptureRequest.CONTROL_AE_MODE, CameraMetadata.CONTROL_AE_MODE_ON_AUTO_FLASH_REDEYE
+            )
+        }
+    }
+
+    /** The exposure index for the camera's step (EV per index). */
+    fun exposureIndex(step: Float, range: IntRange): Int =
+        if (step <= 0f) 0 else (exposureThirds / 3f / step).roundToInt().coerceIn(range)
+
+    /** Creator name: written into the saved photo's EXIF (Artist and Copyright). */
+    fun writeCreator(context: Context, uri: android.net.Uri, name: String?) {
+        if (name.isNullOrBlank()) return
+        runCatching {
+            context.contentResolver.openFileDescriptor(uri, "rw")?.use { pfd ->
+                val exif = androidx.exifinterface.media.ExifInterface(pfd.fileDescriptor)
+                exif.setAttribute(androidx.exifinterface.media.ExifInterface.TAG_ARTIST, name)
+                exif.setAttribute(androidx.exifinterface.media.ExifInterface.TAG_COPYRIGHT, name)
+                exif.saveAttributes()
+            }
+        }
+    }
+
+    companion object {
+        const val AUTO_SCENE = -1
+        const val MACRO_SCENE = -2
+
+        /** Megapixels as the N9 writes them on the viewfinder ("7M"). */
+        fun megapixels(s: Size) = "${((s.width.toLong() * s.height) / 1_000_000.0).roundToInt().coerceAtLeast(1)}M"
+    }
+}
