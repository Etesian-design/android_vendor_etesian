+    fun onCameraState(s: CameraState) {
+        val rec = s.isRecordingVideo
+        if (rec == recording) return
+        recording = rec
+        // Recording: everything hides but the shutter; the time in the strip's corner.
+        for (v in listOf(infoPill, flashButton, modeSwitch, gallery)) v.isVisible = !rec
+        if (rec) showFlashStrip(false)
+        recPill.isVisible = rec
+    }
