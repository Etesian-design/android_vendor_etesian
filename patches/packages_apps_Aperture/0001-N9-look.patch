+    private fun updateModeSwitch() {
+        for ((v, m) in listOf(modeVideo to CameraMode.VIDEO, modePhoto to CameraMode.PHOTO)) {
+            val on = m == mode
+            v.background = if (on) N9SquircleDrawable(Color.WHITE, 0, d) else null
+            v.imageTintList = ColorStateList.valueOf(if (on) Color.BLACK else Color.WHITE)
+            v.isSelected = on
+        }
+    }
+
+    /** Photo <-> video: the whole screen turns over like a card, video on the back. */
+    private fun switchMode(target: CameraMode) {
+        if (target == mode || recording) return
+        showFlashStrip(false)
+        val reduce = !ValueAnimator.areAnimatorsEnabled()
+        val v = mainLayout
+        if (reduce) {
+            v.animate().alpha(0.4f).setDuration(90).withEndAction {
+                vm.setCameraMode(target)
+                v.animate().alpha(1f).setDuration(90).start()
+            }.start()
+            return
+        }
+        v.cameraDistance = 8000 * d
+        val dir = if (target == CameraMode.VIDEO) 1f else -1f
+        v.animate().rotationY(90f * dir).setDuration(180).setInterpolator(android.view.animation.AccelerateInterpolator())
+            .setListener(object : AnimatorListenerAdapter() {
+                override fun onAnimationEnd(animation: Animator) {
+                    v.animate().setListener(null)
+                    vm.setCameraMode(target)
+                    v.rotationY = -90f * dir
+                    v.animate().rotationY(0f).setDuration(180)
+                        .setInterpolator(android.view.animation.DecelerateInterpolator()).start()
+                }
+            }).start()
+    }
