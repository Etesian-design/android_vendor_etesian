+    fun onPhotoSaved(uri: Uri?) {
+        uri ?: return
+        cap.writeCreator(a, uri, prefs.getString("creator", null))
+        val seconds = prefs.getInt("review", 0)
+        if (seconds == 0) return
+        review.load(uri)
+        review.isVisible = true
+        updateBack()
+        handler.removeCallbacksAndMessages(null)
+        if (seconds > 0) handler.postDelayed({ hideReview() }, seconds * 1000L)
+    }
