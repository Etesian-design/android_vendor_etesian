+/**
+ * Etesian: the Nokia N9 camera, drawn over Aperture's viewfinder (from the user's N9, PR1.3).
+ *
+ * All picture, no toolbar. Top left one see-through pill (face detection, scene, megapixels; in
+ * video the quality and scene) that opens the capture settings; top right the flash (photo: a strip
+ * of Auto / On / Off / Red-eye; video: a straight torch toggle); bottom left the photo/video switch,
+ * bottom centre the shutter, bottom right the gallery. Tapping the picture focuses. The layout is
+ * fixed to the device: on turning only the contents of each control rotate.
+ *
+ * The capture settings page and the panels over the live picture (white balance, exposure, colour
+ * filter) live in this activity too, so a change is seen at once, with the dark toolbar's Back.
+ */
+class N9CameraUi(
+    private val a: AppCompatActivity,
+    private val vm: CameraViewModel,
+    private val cap: N9Capture,
+    private val mainLayout: ViewGroup,
+    private val viewFinder: View,
+    private val flashButton: ImageButton,
+    private val shutterButton: ImageButton,
+    private val gallery: CardView,
+    private val galleryIcon: ImageView,
+    private val focus: ImageView,
+    /** The Camera2 options changed (scene, white balance, …): apply them now. */
+    private val onCaptureOptionsChanged: () -> Unit,
+    /** The photo resolution changed: rebind. */
+    private val onRebind: () -> Unit,
+    private val onGpsChanged: (Boolean) -> Unit,
+    private val onAllSettings: () -> Unit,
+) {
+    /** One "dp" of the N9 (1.5 N9 px) on this screen: sized by the short side, as the N9's 480 px. */
+    private val d = N9.unit(a)
+    private fun dp(v: Number) = (v.toFloat() * d).roundToInt()
+    private val prefs = a.getSharedPreferences("n9_capture", 0)
+
+    // Viewfinder
+    private val vf = FrameLayout(a)
+    private val infoPill = LinearLayout(a)
+    private val recPill = LinearLayout(a)
+    private val recTime = TextView(a)
+    private val flashFace = N9SquircleDrawable(N9.CONTROL_FILL, N9.CONTROL_RIM, d)
+    private val flashStrip = LinearLayout(a)
+    private val modeSwitch = LinearLayout(a)
+    private val modeVideo = ImageView(a)
+    private val modePhoto = ImageView(a)
+    private val zoom by lazy { N9ZoomSlider(a) }
+    private val zoomHide = Runnable {
+        zoom.animate().alpha(0f).setDuration(250).withEndAction { zoom.isVisible = false }.start()
+    }
+    private val brackets by lazy { N9BracketsDrawable(d) }
+
+    // Settings page, panels, captured content
+    private val page = ScrollView(a)
+    private val pageBody = LinearLayout(a)
+    private val panel = LinearLayout(a)
+    private val ownBar = FrameLayout(a)
+    private val review = ImageView(a)
+
+    private var mode = CameraMode.PHOTO
