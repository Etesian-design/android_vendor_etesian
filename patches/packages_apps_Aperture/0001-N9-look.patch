+    // Flash
+
+    private fun flashIcon(m: FlashMode) = when (m) {
+        FlashMode.AUTO -> R.drawable.n9_ic_flash_auto
+        FlashMode.ON -> R.drawable.n9_ic_flash_on
+        FlashMode.OFF -> if (mode == CameraMode.VIDEO) R.drawable.n9_ic_torch_off else R.drawable.n9_ic_flash_off
+        FlashMode.TORCH -> R.drawable.n9_ic_torch_on
+        FlashMode.SCREEN -> R.drawable.ic_flash_screen
+    }
+
+    private val redEyeShown get() = mode == CameraMode.PHOTO && prefs.getBoolean("redeye", false) && flashMode == FlashMode.AUTO
+
+    fun onFlash(m: FlashMode, supported: Set<FlashMode>) {
+        flashMode = m
+        flashModes = supported
+        flashButton.setImageResource(if (redEyeShown) R.drawable.n9_ic_redeye else flashIcon(m))
+        flashButton.contentDescription = if (mode == CameraMode.VIDEO) "Torch" else "Flash"
+        flashButton.isSelected = m == FlashMode.TORCH
+        if (flashStrip.isVisible) fillFlashStrip()
+    }
+
+    private data class FlashChoice(val mode: FlashMode, val redEye: Boolean, val icon: Int, val label: String)
+
+    private fun flashChoices(): List<FlashChoice> {
+        val camId = config?.camera?.cameraId
+        val redEyeOk = camId != null && cap.caps(camId).redEye
+        return buildList {
+            if (FlashMode.AUTO in flashModes) add(FlashChoice(FlashMode.AUTO, false, R.drawable.n9_ic_flash_auto, "Automatic"))
+            if (FlashMode.ON in flashModes) add(FlashChoice(FlashMode.ON, false, R.drawable.n9_ic_flash_on, "On"))
+            if (FlashMode.SCREEN in flashModes) add(FlashChoice(FlashMode.SCREEN, false, R.drawable.ic_flash_screen, "Screen flash"))
+            if (FlashMode.OFF in flashModes) add(FlashChoice(FlashMode.OFF, false, R.drawable.n9_ic_flash_off, "Off"))
+            if (FlashMode.AUTO in flashModes && redEyeOk) {
+                add(FlashChoice(FlashMode.AUTO, true, R.drawable.n9_ic_redeye, "Red-eye reduction"))
+            }
+        }
+    }
+
+    private fun onFlashTap() {
+        if (mode == CameraMode.VIDEO) {
+            // A straight torch toggle; only the icon changes.
+            vm.setFlashMode(if (flashMode == FlashMode.TORCH) FlashMode.OFF else FlashMode.TORCH)
+            return
+        }
+        val choices = flashChoices()
+        if (choices.size <= 2) {
+            // Two values toggle straight from the button.
+            val next = choices.firstOrNull { it.mode != flashMode } ?: return
+            cap.redEye = next.redEye
+            vm.setFlashMode(next.mode)
+            onCaptureOptionsChanged()
+            return
+        }
+        showFlashStrip(!flashStrip.isVisible)
+    }
+
+    private fun fillFlashStrip() {
+        flashStrip.removeAllViews()
+        for (c in flashChoices()) {
+            val current = c.mode == flashMode && c.redEye == (redEyeShown)
+            flashStrip.addView(ImageView(a).apply {
+                setImageResource(c.icon)
+                scaleType = ImageView.ScaleType.FIT_CENTER
+                setPadding(dp(8), dp(11), dp(8), dp(11))
+                imageTintList = ColorStateList.valueOf(if (current) N9.BLUE else Color.WHITE)
+                contentDescription = c.label
+                isSelected = current
+                rotation = this@N9CameraUi.rotation
+                setOnClickListener {
+                    cap.redEye = c.redEye
+                    vm.setFlashMode(c.mode)
+                    onCaptureOptionsChanged()
+                    flashMode = c.mode
+                    onFlash(c.mode, flashModes)
+                    showFlashStrip(false)
+                }
+            }, LinearLayout.LayoutParams(dp(40), dp(46)))
+        }
+    }
+
+    private fun showFlashStrip(show: Boolean) {
+        if (show) fillFlashStrip()
+        flashFace.fill = if (show) N9.BLUE else N9.CONTROL_FILL
+        flashFace.rim = if (show) N9.BLUE else N9.CONTROL_RIM
+        if (show == flashStrip.isVisible) return
+        if (show) {
+            flashStrip.isVisible = true
+            flashStrip.pivotY = 0f
+            flashStrip.scaleY = 0f
+            flashStrip.animate().scaleY(1f).setDuration(160).start()
+        } else {
+            flashStrip.animate().scaleY(0f).setDuration(120).withEndAction {
+                flashStrip.isVisible = false
+                flashStrip.scaleY = 1f
+            }.start()
+        }
+        updateBack()
+    }
