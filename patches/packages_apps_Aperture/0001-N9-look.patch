+    fun onDuration(nanos: Long) {
+        val s = nanos / 1_000_000_000L
+        recTime.text = "%02d:%02d".format(s / 60, s % 60)
+    }
+
+    /** Pinch zoom (or the slider): show the zoom slider; Aperture's timer hides it again. */
+    fun onZoom(linear: Float, ratio: Float, min: Float, max: Float, setLinear: (Float) -> Unit) {
+        if (min >= max) return
+        zoom.minRatio = min
+        zoom.maxRatio = max
+        zoom.ratio = ratio
+        zoom.linear = linear
+        zoom.onChange = setLinear
+        zoom.animate().cancel()
+        zoom.alpha = 1f
+        zoom.isVisible = !page.isVisible && !panel.isVisible
+    }
+
+    /** Aperture's own zoom slider timeout (MSG_HIDE_ZOOM_SLIDER) hides it. */
+    fun hideZoom() = zoomHide.run()
+
+    /** Turning the phone: only the contents of the controls turn, animated. */
+    fun onRotation(degrees: Float) {
+        rotation = degrees
+        ValueAnimator.ofFloat(zoom.contentRotation, degrees).apply {
+            duration = 260
+            addUpdateListener { zoom.contentRotation = it.animatedValue as Float }
+        }.start()
+        for (v in listOf(flashButton, shutterButton, gallery, modeVideo, modePhoto, recTime)) v.smoothRotate(degrees)
+        for (i in 0 until infoPill.childCount) infoPill.getChildAt(i).smoothRotate(degrees)
+        for (i in 0 until flashStrip.childCount) flashStrip.getChildAt(i).smoothRotate(degrees)
+    }
+
+    /** The focus brackets: moved to the tap, blue once the focus locks; back to the middle later. */
+    fun onFocus(started: Boolean, locked: Boolean, point: PointF?) {
+        if (started && point != null) {
+            focus.x = point.x - focus.width / 2f
+            focus.y = point.y - focus.height / 2f
+            brackets.color = Color.WHITE
+        } else {
+            brackets.color = if (locked) N9.BLUE else Color.WHITE
+        }
+        focus.isVisible = true
+    }
+
+    fun recentreFocus() {
+        focus.post {
+            focus.translationX = 0f
+            focus.translationY = 0f
+            val parent = focus.parent as View
+            focus.x = (parent.width - focus.width) / 2f
+            focus.y = (parent.height - focus.height) / 2f
+            brackets.color = Color.WHITE
+            focus.isVisible = true
+        }
+    }
