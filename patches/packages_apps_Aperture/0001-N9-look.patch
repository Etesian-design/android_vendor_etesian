+    private fun videoLabel(q: Quality?) = when (q) {
+        Quality.UHD -> "4K"
+        Quality.QHD -> "QHD"
+        Quality.FHD -> "FHD"
+        Quality.HD -> "HD"
+        Quality.SD -> "SD"
+        else -> "HD"
+    }
+
+    private fun ratio(c: CameraConfiguration.Photo) =
+        if (c.photoAspectRatio == AspectRatio.RATIO_16_9) 16f / 9f else 4f / 3f
+
+    private fun updateInfoPill() {
+        infoPill.removeAllViews()
+        val c = config ?: return
+        val caps = cap.caps(c.camera.cameraId)
+        fun icon(res: Int) = ImageView(a).apply {
+            setImageResource(res); imageTintList = ColorStateList.valueOf(Color.WHITE)
+        }
+        fun label(t: String, boxed: Boolean) = TextView(a).apply {
+            text = t; setTextColor(Color.WHITE); typeface = N9.bold; setTextSize(TypedValue.COMPLEX_UNIT_PX, 13f * d)
+            if (boxed) {
+                background = GradientDrawable().apply { setStroke(dp(1.5f), Color.WHITE); cornerRadius = dp(2).toFloat() }
+                setPadding(dp(3), 0, dp(3), 0)
+            }
+        }
+        val views = mutableListOf<View>()
+        when (c) {
+            is CameraConfiguration.Photo -> {
+                if (cap.faceDetection && caps.faceDetection) views += icon(R.drawable.n9_ic_face)
+                views += icon(sceneIcon(cap.scene(false)))
+                cap.resolutionSize(c.camera.cameraId, ratio(c))?.let { views += label(N9Capture.megapixels(it), false) }
+            }
+            is CameraConfiguration.Video -> {
+                views += label(videoLabel(c.videoQuality), true)
+                views += icon(sceneIcon(cap.scene(true)))
+            }
+            else -> {}
+        }
+        views.forEachIndexed { i, v ->
+            v.rotation = rotation
+            infoPill.addView(v, LinearLayout.LayoutParams(
+                if (v is ImageView) dp(20) else ViewGroup.LayoutParams.WRAP_CONTENT,
+                if (v is ImageView) dp(20) else ViewGroup.LayoutParams.WRAP_CONTENT,
+            ).apply { if (i > 0) marginStart = dp(13) })
+        }
+    }
