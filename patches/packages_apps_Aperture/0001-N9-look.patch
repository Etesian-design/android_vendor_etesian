+            landscapePrimarySet.applyTo(primaryBarLayout)
+            landscapeSecondarySet.applyTo(secondaryBottomBarLayout)
+            secondaryBottomBarLayout.background = null
+            primaryBarLayout.setPadding(0, 0, 0, 0)
+        } else {
+            portraitMainSet.applyTo(mainLayout)
+            portraitPrimarySet.applyTo(primaryBarLayout)
