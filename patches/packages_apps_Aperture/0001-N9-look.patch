@@ -0,0 +1,256 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Etesian
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.ui.n9
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Typeface
+import android.view.MotionEvent
+import android.view.View
+import kotlin.math.roundToInt
+
+/** The N9's colours and type. */
+object N9 {
+    const val BLUE = 0xFF268CE1.toInt()
+    const val BLUE_TOP = 0xFF3B9BEA.toInt()
+    const val BLUE_BOTTOM = 0xFF1678D2.toInt()
+    const val BLUE_RIM = 0xFF7FC0F6.toInt()
+    const val GREY_TEXT = 0xFF8C8C8C.toInt()
+    const val VALUE_TEXT = 0xFF9A9A9A.toInt()
+    const val RULE = 0xFF3A3A3A.toInt()
+    const val TILE_TOP = 0xFF4A4A4A.toInt()
+    const val TILE_BOTTOM = 0xFF262626.toInt()
+    const val TILE_GLASS = 0x59FFFFFF
+    const val CONTROL_FILL = 0x99000000.toInt()
+    const val CONTROL_RIM = 0x59FFFFFF
+    const val STRIP_FILL = 0x73808080
+    const val PANEL_FILL = 0xA6000000.toInt()
+
+    val text: Typeface = Typeface.create("etesian-text", Typeface.NORMAL)
+    val bold: Typeface = Typeface.create(text, Typeface.BOLD)
+    val light: Typeface = Typeface.create(text, 300, false)
+
+    /** Px per N9 "dp" (1.5 N9 px) on this screen: the N9's 480 px short side maps onto this one's. */
+    fun unit(context: Context): Float {
+        val m = context.resources.displayMetrics
+        return minOf(m.widthPixels, m.heightPixels) / 320f
+    }
+}
+
+/**
+ * The N9 switch: a 42 x 26 dp track with squircle-half ends (off #2D2E2D, on a blue gradient) and a
+ * white squircle knob inset 3 dp, sliding over when toggled.
+ */
+class N9Switch(context: Context) : View(context) {
+    private val d = N9.unit(context)
+    private val track = N9SquircleDrawable(0xFF2D2E2D.toInt(), 0x33FFFFFF, d, ends = true)
+    private val knob = N9SquircleDrawable(0xFFFFFFFF.toInt(), 0, d)
+    private var pos = 0f
+
+    var onChange: ((Boolean) -> Unit)? = null
+
+    var isChecked = false
+        set(value) {
+            if (field == value) return
+            field = value
+            animateTo(if (value) 1f else 0f)
+        }
+
+    init {
+        isClickable = true
+        isFocusable = true
+        setOnClickListener {
+            isChecked = !isChecked
+            onChange?.invoke(isChecked)
+        }
+    }
+
+    fun setCheckedNow(value: Boolean) {
+        isChecked = value
+        pos = if (value) 1f else 0f
+        invalidate()
+    }
+
+    private fun animateTo(target: Float) {
+        android.animation.ValueAnimator.ofFloat(pos, target).apply {
+            duration = 150
+            addUpdateListener { pos = it.animatedValue as Float; invalidate() }
+        }.start()
+    }
+
+    override fun onMeasure(w: Int, h: Int) = setMeasuredDimension((42 * d).roundToInt(), (26 * d).roundToInt())
+
+    override fun onDraw(c: Canvas) {
+        track.setBounds(0, 0, width, height)
+        track.setGradient(if (pos > 0.5f) intArrayOf(0xFF4195DE.toInt(), 0xFF107DD6.toInt()) else null)
+        track.draw(c)
+        val inset = (3 * d).roundToInt()
+        val k = height - 2 * inset
+        val x = inset + ((width - 2 * inset - k) * pos).roundToInt()
+        knob.setBounds(x, inset, x + k, inset + k)
+        knob.draw(c)
+    }
+
+    override fun onInitializeAccessibilityNodeInfo(info: android.view.accessibility.AccessibilityNodeInfo) {
+        super.onInitializeAccessibilityNodeInfo(info)
+        info.className = android.widget.Switch::class.java.name
+        info.isCheckable = true
+        info.isChecked = isChecked
+    }
+}
+
+/**
+ * The N9 stepped slider (exposure compensation): labels above (-2 -1 0 +1 +2, the current one blue),
+ * a tick every third of a step, the track blue up to the handle and grey after, a white squircle handle.
+ * Values are in thirds of a step, [min]..[max].
+ */
+class N9SteppedSlider(context: Context) : View(context) {
+    private val d = N9.unit(context)
+    private val label = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textSize = 15 * d; typeface = N9.text; textAlign = Paint.Align.CENTER
+    }
+    private val tick = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = 0xFFFFFFFF.toInt(); strokeWidth = d }
+    private val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { strokeWidth = 5 * d; strokeCap = Paint.Cap.ROUND }
+    private val handle = N9SquircleDrawable(0xFFFFFFFF.toInt(), 0x33000000, d)
+
+    var min = -6
+    var max = 6
+    var value = 0
+        set(v) { field = v.coerceIn(min, max); invalidate() }
+    var onChange: ((Int) -> Unit)? = null
+
+    init {
+        isFocusable = true
+    }
+
+    override fun onMeasure(w: Int, h: Int) =
+        setMeasuredDimension(MeasureSpec.getSize(w), (92 * d).roundToInt())
+
+    private val trackL get() = 18 * d
+    private val trackR get() = width - 18 * d
+    private fun xOf(v: Int) = trackL + (trackR - trackL) * (v - min) / (max - min).coerceAtLeast(1)
+
+    override fun onDraw(c: Canvas) {
+        for (v in min..max) {
+            val x = xOf(v)
+            if (v % 3 == 0) {
+                label.color = if (v == value) N9.BLUE else 0xFFFFFFFF.toInt()
+                val s = when {
+                    v == 0 -> "0"
+                    v > 0 -> "+${v / 3}"
+                    else -> "${v / 3}"
+                }
+                c.drawText(s, x, 22 * d, label)
+            }
+            val top = if (v % 3 == 0) 34 * d else 37 * d
+            c.drawLine(x, top, x, 43 * d, tick)
+        }
+        val y = 68 * d
+        trackPaint.color = 0x80B4B4B4.toInt()
+        c.drawLine(trackL, y, trackR, y, trackPaint)
+        trackPaint.color = N9.BLUE
+        c.drawLine(trackL, y, xOf(value), y, trackPaint)
+        val hw = (20 * d).roundToInt()
+        val hh = (16 * d).roundToInt()
+        val hx = xOf(value).roundToInt()
+        handle.setBounds(hx - hw, y.roundToInt() - hh, hx + hw, y.roundToInt() + hh)
+        handle.draw(c)
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    override fun onTouchEvent(e: MotionEvent): Boolean {
+        when (e.actionMasked) {
+            MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE, MotionEvent.ACTION_UP -> {
+                parent?.requestDisallowInterceptTouchEvent(true)
+                val f = ((e.x - trackL) / (trackR - trackL)).coerceIn(0f, 1f)
+                val v = (min + f * (max - min)).roundToInt()
+                if (v != value) {
+                    value = v
+                    onChange?.invoke(v)
+                }
+            }
+        }
+        return true
+    }
+}
+
+/**
+ * Zoom as the N9's stepped slider, standing along the edge: a see-through dark pill, the track blue
+ * from the bottom up to a white squircle handle, a tick and a label at each whole ratio stop (1x, 2x,
+ * 5x, ...; the current one blue). [linear] is CameraX's linear zoom (0..1). Labels turn with the device.
+ */
+class N9ZoomSlider(context: Context) : View(context) {
+    private val d = N9.unit(context)
+    private val face = N9SquircleDrawable(0x80000000.toInt(), N9.CONTROL_RIM, d, ends = true)
+    private val handle = N9SquircleDrawable(0xFFFFFFFF.toInt(), 0x33000000, d)
+    private val label = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textSize = 10 * d; typeface = N9.bold; textAlign = Paint.Align.CENTER
+    }
+    private val tick = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = 0xFFFFFFFF.toInt(); strokeWidth = d }
+    private val track = Paint(Paint.ANTI_ALIAS_FLAG).apply { strokeWidth = 3 * d; strokeCap = Paint.Cap.ROUND }
+
+    var minRatio = 1f
+    var maxRatio = 1f
+    var linear = 0f
+        set(v) { field = v.coerceIn(0f, 1f); invalidate() }
+    var ratio = 1f
+    var contentRotation = 0f
+        set(v) { field = v; invalidate() }
+    var onChange: ((Float) -> Unit)? = null
+
+    /** CameraX's linear zoom for a ratio (linear in 1/ratio). */
+    private fun linearOf(r: Float): Float {
+        val a = 1f / minRatio
+        val b = 1f / maxRatio
+        return if (a == b) 0f else ((a - 1f / r) / (a - b)).coerceIn(0f, 1f)
+    }
+
+    private val tTop get() = 26 * d
+    private val tBot get() = height - 26 * d
+    private fun yOf(l: Float) = tBot - (tBot - tTop) * l
+
+    override fun onDraw(c: Canvas) {
+        face.setBounds(0, 0, width, height)
+        face.draw(c)
+        val x = width * 0.62f
+        track.color = 0x80B4B4B4.toInt()
+        c.drawLine(x, tTop, x, tBot, track)
+        track.color = N9.BLUE
+        c.drawLine(x, tBot, x, yOf(linear), track)
+        val stops = listOf(minRatio, 1f, 2f, 5f, 10f, maxRatio).filter { it in minRatio..maxRatio }.distinct()
+        val near = stops.minByOrNull { kotlin.math.abs(it - ratio) }
+        for (r in stops) {
+            val y = yOf(linearOf(r))
+            c.drawLine(x - 5 * d, y, x + 5 * d, y, tick)
+            label.color = if (r == near && kotlin.math.abs(r - ratio) < 0.15f) N9.BLUE else 0xFFFFFFFF.toInt()
+            val text = if (r == r.toInt().toFloat()) "${r.toInt()}x" else "%.1fx".format(r)
+            val lx = width * 0.27f
+            c.save()
+            c.rotate(contentRotation, lx, y)
+            c.drawText(text, lx, y + label.textSize / 3, label)
+            c.restore()
+        }
+        val hw = (12 * d).roundToInt()
+        val hh = (10 * d).roundToInt()
+        val hy = yOf(linear).roundToInt()
+        handle.setBounds(x.roundToInt() - hw, hy - hh, x.roundToInt() + hw, hy + hh)
+        handle.draw(c)
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    override fun onTouchEvent(e: MotionEvent): Boolean {
+        when (e.actionMasked) {
+            MotionEvent.ACTION_DOWN, MotionEvent.ACTION_MOVE, MotionEvent.ACTION_UP -> {
+                parent?.requestDisallowInterceptTouchEvent(true)
+                linear = ((tBot - e.y) / (tBot - tTop)).coerceIn(0f, 1f)
+                onChange?.invoke(linear)
+            }
+        }
+        return true
+    }
+}
