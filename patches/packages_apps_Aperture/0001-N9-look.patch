+    private fun buildOwnBar() {
+        ownBar.setBackgroundColor(0xFF111111.toInt())
+        ownBar.isVisible = false
+        ownBar.addView(ImageButton(a).apply {
+            setImageResource(R.drawable.n9_ic_back)
+            background = N9SquircleDrawable(0xFF2A2A2A.toInt(), 0x33FFFFFF, d)
+            contentDescription = "Back"
+            setOnClickListener { a.onBackPressedDispatcher.onBackPressed() }
+        }, FrameLayout.LayoutParams(dp(48), dp(40), Gravity.CENTER_VERTICAL or Gravity.START).apply {
+            setMargins(dp(12), dp(8), 0, dp(8))
+        })
+        mainLayout.addView(ownBar, constraintBottom())
+    }
