+    private fun slideBars(visible: Boolean) {
+        listOf(appBarLayout to -1, bottomSheetLinearLayout to 1).forEach { (bar, direction) ->
+            bar.animate().cancel()
+            if (visible) {
+                bar.isVisible = bar !== bottomSheetLinearLayout || !useSystemToolbar
+                if (bar.height > 0 && bar.translationY == 0f) {
+                    bar.translationY = (direction * bar.height).toFloat()
+                }
+                bar.animate()
+                    .translationY(0f)
+                    .setDuration(BARS_ANIMATION_DURATION)
+                    .start()
+            } else if (bar.height == 0) {
+                // Not laid out yet (opening full screen): just hide it
+                bar.isVisible = false
+            } else {
+                bar.animate()
+                    .translationY((direction * bar.height).toFloat())
+                    .setDuration(BARS_ANIMATION_DURATION)
+                    .withEndAction { bar.isVisible = false }
+                    .start()
+            }
+        }
+    }
+
