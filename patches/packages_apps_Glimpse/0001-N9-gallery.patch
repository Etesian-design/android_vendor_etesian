+        }
+
+        systemToolbar
+            .setStyle(EtesianToolbar.STYLE_DARK)
+            .setBack(true)
+            .setItems(items) { id ->
+                when (id) {
+                    TOOLBAR_FAVORITE -> favoriteButton.performClick()
+                    TOOLBAR_SHARE -> shareButton.performClick()
