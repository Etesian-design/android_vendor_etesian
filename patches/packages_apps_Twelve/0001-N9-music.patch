+/**
+ * N9 Music library list (Artists, Albums, Songs or Playlists): a light header over a thin rule,
+ * a pull-down search field, a Shuffle row, then the items in alphabetical sections.
+ */
+class N9LibraryListFragment : Fragment(R.layout.fragment_n9_library_list) {
+    // View models
+    private val viewModel by viewModels<N9MusicViewModel>()
+    private var playingUri: android.net.Uri? = null
+    private var playingAlbum: String? = null
+
+    // Views
+    private val backImageButton by getViewProperty<ImageButton>(R.id.backImageButton)
+    private val noElementsTextView by getViewProperty<TextView>(R.id.noElementsTextView)
+    private val recyclerView by getViewProperty<RecyclerView>(R.id.recyclerView)
+    private val rootLinearLayout by getViewProperty<LinearLayout>(R.id.rootLinearLayout)
+    private val titleTextView by getViewProperty<TextView>(R.id.titleTextView)
+
+    // Arguments
+    private val kind: N9MusicViewModel.Kind
+        get() = N9MusicViewModel.Kind.entries[requireArguments().getInt(ARG_KIND)]
+
+    // Data
+    private var allRows = listOf<N9MusicViewModel.Row>()
+    private var query = ""
+    private var scrolledPastSearch = false
+
+    // RecyclerView
+    private val adapter = ListAdapter()
+    private var fastScroller: EtesianFastScroller? = null
+
+    // Permissions
+    private val permissionsChecker = PermissionsChecker(
+        this, PermissionsUtils.mainPermissions
+    )
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+
+        // Insets
+        ViewCompat.setOnApplyWindowInsetsListener(rootLinearLayout) { v, windowInsets ->
+            val insets = windowInsets.getInsets(
+                WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout()
+            )
+
+            v.updatePadding(
+                insets,
+                start = true,
+                top = true,
+                end = true,
+            )
+
+            windowInsets
+        }
+
+        ViewCompat.setOnApplyWindowInsetsListener(recyclerView) { v, windowInsets ->
+            val insets = windowInsets.getInsets(WindowInsetsCompat.Type.systemBars())
+
+            v.updatePadding(
+                insets,
+                bottom = true,
+            )
+
+            windowInsets
+        }
+
+        titleTextView.setText(
+            when (kind) {
+                N9MusicViewModel.Kind.ARTISTS -> R.string.n9_music_artists
+                N9MusicViewModel.Kind.ALBUMS -> R.string.n9_music_albums
+                N9MusicViewModel.Kind.SONGS -> R.string.n9_music_songs
+                N9MusicViewModel.Kind.PLAYLISTS -> R.string.n9_music_playlists
+            }
+        )
+
+        // Without the system toolbar there is no Back button: draw our own
+        backImageButton.isVisible = !EtesianToolbar.isAvailable(requireContext())
+        backImageButton.setOnClickListener {
+            (parentFragment as? MainFragment)?.showPage(MainFragment.Page.HOME)
+        }
+
+        recyclerView.adapter = adapter
+        fastScroller = EtesianFastScroller.attach(recyclerView) { position ->
+            adapter.sectionFor(position)
+        }
+
+        viewModel.setKind(kind)
+
+        viewLifecycleOwner.lifecycleScope.launch {
+            viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                viewModel.playing.collectLatest {
+                    playingUri = it.first
+                    playingAlbum = it.second
+                    recyclerView.adapter?.notifyDataSetChanged()
+                }
+            }
+        }
+
+        viewLifecycleOwner.lifecycleScope.launch {
+            viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                permissionsChecker.withPermissionsGranted {
+                    viewModel.rows.collectLatest {
+                        when (it) {
+                            is FlowResult.Loading -> {
+                                // Do nothing
+                            }
+
+                            is FlowResult.Success -> {
+                                allRows = it.data
+                                updateRows()
+                            }
+
+                            is FlowResult.Failure -> {
+                                Log.e(
+                                    LOG_TAG,
+                                    "Failed to load $kind, error: ${it.error}",
+                                    it.throwable
+                                )
+
+                                allRows = listOf()
+                                updateRows()
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    override fun onDestroyView() {
+        fastScroller?.detach()
+        fastScroller = null
+        recyclerView.adapter = null
+
+        super.onDestroyView()
+    }
+
+    private fun updateRows() {
+        val rows = query.trim().takeIf { it.isNotEmpty() }?.let { q ->
+            allRows.filter {
+                it.title?.contains(q, true) == true || it.subtitle?.contains(q, true) == true
+            }
+        } ?: allRows
+
+        adapter.submitRows(rows)
+
+        noElementsTextView.isVisible = allRows.isEmpty()
+        noElementsTextView.setText(
+            when (kind) {
+                N9MusicViewModel.Kind.ARTISTS -> R.string.no_artists
+                N9MusicViewModel.Kind.ALBUMS -> R.string.no_albums
+                N9MusicViewModel.Kind.SONGS -> R.string.no_audios
+                N9MusicViewModel.Kind.PLAYLISTS -> R.string.no_playlists
+            }
+        )
+
+        // The search field hides above the top until the list is pulled down
+        if (!scrolledPastSearch && allRows.isNotEmpty()) {
+            scrolledPastSearch = true
+            (recyclerView.layoutManager as? LinearLayoutManager)?.scrollToPositionWithOffset(
+                1, 0
+            )
+        }
+    }
+
+    private fun onRowClicked(row: N9MusicViewModel.Row, rows: List<N9MusicViewModel.Row>) {
+        when (val item = row.item) {
+            is Artist -> findNavController().navigateSafe(
+                R.id.action_mainFragment_to_fragment_artist,
+                ArtistFragment.createBundle(item.uri)
+            )
+
+            is Album -> findNavController().navigateSafe(
+                R.id.action_mainFragment_to_fragment_album,
+                AlbumFragment.createBundle(item.uri)
+            )
+
+            is Audio -> {
+                val audios = rows.mapNotNull { it.item as? Audio }
+                viewModel.playAudio(audios, audios.indexOf(item).coerceAtLeast(0))
+                findNavController().navigate(R.id.fragment_now_playing)
+            }
+
+            is Playlist -> findNavController().navigateSafe(
+                R.id.action_mainFragment_to_fragment_playlist,
+                PlaylistFragment.createBundle(item.uri)
+            )
+
+            else -> {
+                // Not listed here
+            }
+        }
+    }
+
+    private fun onRowLongClicked(row: N9MusicViewModel.Row) {
+        findNavController().navigateSafe(
+            R.id.action_mainFragment_to_fragment_media_item_bottom_sheet_dialog,
+            MediaItemBottomSheetDialogFragment.createBundle(row.item.uri)
+        )
+    }
+
+    private fun shuffle() {
+        viewLifecycleOwner.lifecycleScope.launch {
+            viewModel.shuffleAll().onError {
+                Snackbar.make(recyclerView, it.toString(), Snackbar.LENGTH_SHORT).show()
+            }
+        }
+    }
+
+    /**
+     * Search field, Shuffle row, then the rows.
+     */
+    private inner class ListAdapter : RecyclerView.Adapter<RecyclerView.ViewHolder>() {
+        private var rows = listOf<N9MusicViewModel.Row>()
+        private var sections = listOf<String>()
+
+        init {
+            setHasStableIds(true)
+        }
+
+        @SuppressLint("NotifyDataSetChanged")
+        fun submitRows(rows: List<N9MusicViewModel.Row>) {
+            this.rows = rows
+            this.sections = rows.map { sectionOf(it.title) }
+            notifyDataSetChanged()
+        }
+
+        fun sectionFor(position: Int) = sections.getOrNull(position - HEADER_COUNT)
+
+        override fun getItemCount() = HEADER_COUNT + rows.size
+
+        override fun getItemViewType(position: Int) = when (position) {
+            0 -> VIEW_TYPE_SEARCH
+            1 -> VIEW_TYPE_SHUFFLE
+            else -> VIEW_TYPE_ROW
+        }
+
+        override fun getItemId(position: Int) = when (position) {
+            0 -> -1L
+            1 -> -2L
+            else -> rows[position - HEADER_COUNT].item.uri.hashCode().toLong() and 0xFFFFFFFFL
+        }
+
+        override fun onCreateViewHolder(
+            parent: ViewGroup,
+            viewType: Int,
+        ): RecyclerView.ViewHolder {
+            val inflater = LayoutInflater.from(parent.context)
+
+            return when (viewType) {
+                VIEW_TYPE_SEARCH -> SearchViewHolder(
+                    inflater.inflate(R.layout.item_n9_list_search, parent, false)
+                )
+
+                else -> RowViewHolder(inflater.inflate(R.layout.item_n9_list_row, parent, false))
+            }
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (holder) {
+                is SearchViewHolder -> {
+                    // The text stays as typed
+                }
+
+                is RowViewHolder -> when (position) {
+                    1 -> holder.bindShuffle()
+                    else -> {
+                        val index = position - HEADER_COUNT
+                        val section = sections[index]
+                        holder.bind(
+                            rows[index],
+                            section.takeIf { index == 0 || sections[index - 1] != it },
+                            rows,
+                        )
+                    }
+                }
+            }
+        }
+    }
+
+    private inner class SearchViewHolder(view: View) : RecyclerView.ViewHolder(view) {
+        private val searchEditText = view.findViewById<EditText>(R.id.searchEditText)
+
+        init {
+            searchEditText.addTextChangedListener { text ->
+                query = text?.toString().orEmpty()
+                updateRows()
+            }
+        }
+    }
+
+    private inner class RowViewHolder(view: View) : RecyclerView.ViewHolder(view) {
+        private val rowLinearLayout = view.findViewById<LinearLayout>(R.id.rowLinearLayout)
+        private val sectionFrameLayout = view.findViewById<View>(R.id.sectionFrameLayout)
+        private val sectionTextView = view.findViewById<TextView>(R.id.sectionTextView)
+        private val subtitleTextView = view.findViewById<TextView>(R.id.subtitleTextView)
+        private val thumbnailImageView = view.findViewById<ImageView>(R.id.thumbnailImageView)
+        private val titleTextView = view.findViewById<TextView>(R.id.titleTextView)
+        private val trailingTextView = view.findViewById<TextView>(R.id.trailingTextView)
+        private val titleColor = titleTextView.textColors
+        private val subtitleColor = subtitleTextView.textColors
+        private val trailingColor = trailingTextView.textColors
+
+        fun bindShuffle() {
+            sectionFrameLayout.isVisible = false
+            // The shuffle icon is a squircle; album art is square.
+            thumbnailImageView.clipToN9Squircle()
+
+            thumbnailImageView.isVisible = true
+            thumbnailImageView.background = null
+            thumbnailImageView.scaleType = ImageView.ScaleType.CENTER
+            thumbnailImageView.imageTintList = ColorStateList.valueOf(Color.WHITE)
+            thumbnailImageView.setImageResource(R.drawable.ic_shuffle)
+
+            titleTextView.setText(R.string.n9_music_shuffle)
+            subtitleTextView.isVisible = false
+            trailingTextView.isVisible = false
+
+            rowLinearLayout.setOnClickListener { shuffle() }
+            rowLinearLayout.setOnLongClickListener(null)
+            rowLinearLayout.isLongClickable = false
+        }
+
+        fun bind(
+            row: N9MusicViewModel.Row,
+            section: String?,
+            rows: List<N9MusicViewModel.Row>,
+        ) {
+            sectionFrameLayout.isVisible = section != null
+            sectionTextView.text = section
+
+            // N9 Songs have no artwork
+            thumbnailImageView.isVisible = kind != N9MusicViewModel.Kind.SONGS
+            if (thumbnailImageView.isVisible) {
+                // N9: album art square and as is; generated covers where there is none.
+                thumbnailImageView.clipToOutline = false
+                thumbnailImageView.setBackgroundColor(THUMBNAIL_BACKGROUND_COLOR)
+                thumbnailImageView.imageTintList = null
+                when (kind) {
+                    N9MusicViewModel.Kind.PLAYLISTS -> {
+                        thumbnailImageView.scaleType = ImageView.ScaleType.CENTER_CROP
+                        thumbnailImageView.loadThumbnail(row.thumbnail, placeholder = R.drawable.ic_playlist_play)
+                    }
+                    N9MusicViewModel.Kind.ARTISTS -> thumbnailImageView.loadArtOrCover(row.thumbnail, row.subtitle)
+                    else -> thumbnailImageView.loadArtOrCover(row.thumbnail, row.title)
+                }
+            }
+
+            // N9: the item playing now is magenta.
+            val playing = when (kind) {
+                N9MusicViewModel.Kind.SONGS -> playingUri != null && row.item.uri == playingUri
+                N9MusicViewModel.Kind.ALBUMS -> playingAlbum != null && row.title == playingAlbum
+                else -> false
+            }
+            titleTextView.setTextColor(if (playing) PLAYING_COLOR else titleColor)
+            subtitleTextView.setTextColor(if (playing) PLAYING_COLOR else subtitleColor)
+            trailingTextView.setTextColor(if (playing) PLAYING_COLOR else trailingColor)
+
+            row.title?.also {
+                titleTextView.text = it
+            } ?: titleTextView.setText(R.string.unknown)
+
+            subtitleTextView.isVisible = row.subtitle != null || row.trailing != null
+            subtitleTextView.text = row.subtitle
+
+            trailingTextView.isVisible = row.trailing != null
+            trailingTextView.text = row.trailing
+
+            rowLinearLayout.setOnClickListener { onRowClicked(row, rows) }
+            rowLinearLayout.setOnLongClickListener {
+                onRowLongClicked(row)
+                true
+            }
+        }
+    }
+
+    companion object {
+        private val LOG_TAG = N9LibraryListFragment::class.simpleName!!
+
+        private const val ARG_KIND = "kind"
+
+        private const val HEADER_COUNT = 2
+        private const val VIEW_TYPE_SEARCH = 0
+        private const val VIEW_TYPE_SHUFFLE = 1
+        private const val VIEW_TYPE_ROW = 2
+
+        private const val THUMBNAIL_BACKGROUND_COLOR = 0xFF262626.toInt()
+        private val PLAYING_COLOR = ColorStateList.valueOf(0xFFC4008F.toInt())
+
+        fun newInstance(kind: N9MusicViewModel.Kind) = N9LibraryListFragment().apply {
+            arguments = bundleOf(ARG_KIND to kind.ordinal)
+        }
+
+        /**
+         * The N9 section of a title: its first letter, or # for anything else.
+         */
+        private fun sectionOf(title: String?): String {
+            val first = title?.trim()?.firstOrNull { it.isLetterOrDigit() }
+                ?: return "#"
+
+            return when (first.isLetter()) {
+                true -> first.uppercaseChar().toString()
+                false -> "#"
+            }
+        }
+    }
+}
