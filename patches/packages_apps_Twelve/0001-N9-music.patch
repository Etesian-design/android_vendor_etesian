+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.launch
+import org.lineageos.twelve.R
+import org.lineageos.twelve.SettingsActivity
+import org.lineageos.twelve.ext.getViewProperty
+import org.lineageos.twelve.ext.navigateSafe
+import org.lineageos.twelve.ext.updatePadding
+import org.lineageos.twelve.ui.views.N9AlbumMosaic
+import org.lineageos.twelve.utils.PermissionsChecker
+import org.lineageos.twelve.utils.PermissionsUtils
+import org.lineageos.twelve.viewmodels.N9MusicViewModel
+
+/**
+ * N9 Music main view: a 3x3 mosaic of album covers over a plain list of the library views.
+ */
+class N9HomeFragment : Fragment(R.layout.fragment_n9_home) {
+    // View models
+    private val viewModel by viewModels<N9MusicViewModel>()
+
+    // Views
+    private val albumMosaic by getViewProperty<N9AlbumMosaic>(R.id.albumMosaic)
+    private val albumsTextView by getViewProperty<TextView>(R.id.albumsTextView)
+    private val artistsTextView by getViewProperty<TextView>(R.id.artistsTextView)
+    private val musicStoreTextView by getViewProperty<TextView>(R.id.musicStoreTextView)
+    private val nestedScrollView by getViewProperty<NestedScrollView>(R.id.nestedScrollView)
+    private val playlistsTextView by getViewProperty<TextView>(R.id.playlistsTextView)
+    private val songsTextView by getViewProperty<TextView>(R.id.songsTextView)
+
+    // Permissions
+    private val permissionsChecker = PermissionsChecker(
+        this, PermissionsUtils.mainPermissions
+    )
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+
+        // Insets
+        ViewCompat.setOnApplyWindowInsetsListener(nestedScrollView) { v, windowInsets ->
+            val insets = windowInsets.getInsets(
+                WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout()
+            )
+
+            v.updatePadding(
+                insets,
+                start = true,
+                top = true,
+                end = true,
+                bottom = true,
+            )
+
+            windowInsets
+        }
+
+        albumMosaic.setOnAlbumClickListener { album ->
+            findNavController().navigateSafe(
+                R.id.action_mainFragment_to_fragment_album,
+                AlbumFragment.createBundle(album.uri)
+            )
+        }
+
+        // The N9 has no settings button here: long press the covers
+        albumMosaic.setOnLongClickListener {
+            startActivity(Intent(requireContext(), SettingsActivity::class.java))
+            true
+        }
+
+        artistsTextView.setOnClickListener { showList(N9MusicViewModel.Kind.ARTISTS) }
+        albumsTextView.setOnClickListener { showList(N9MusicViewModel.Kind.ALBUMS) }
+        songsTextView.setOnClickListener { showList(N9MusicViewModel.Kind.SONGS) }
+        playlistsTextView.setOnClickListener { showList(N9MusicViewModel.Kind.PLAYLISTS) }
+
+        musicStoreTextView.setOnClickListener { openMusicStore() }
+        musicStoreTextView.setOnLongClickListener {
+            findNavController().navigateSafe(
+                R.id.action_mainFragment_to_fragment_provider_selector_dialog
+            )
+            true
+        }
+
+        viewLifecycleOwner.lifecycleScope.launch {
+            viewLifecycleOwner.repeatOnLifecycle(Lifecycle.State.STARTED) {
+                permissionsChecker.withPermissionsGranted {
+                    viewModel.mosaicAlbums.collectLatest {
+                        albumMosaic.setAlbums(it)
+                    }
+                }
+            }
+        }
+    }
+
+    private fun showList(kind: N9MusicViewModel.Kind) {
+        (parentFragment as? MainFragment)?.showList(kind)
+    }
+
+    private fun openMusicStore() {
+        val packageManager = requireContext().packageManager
+
+        val intent = packageManager.getLaunchIntentForPackage(STORE_PACKAGE_NAME)
+            ?: Intent(Intent.ACTION_VIEW, Uri.parse(STORE_SEARCH_URI))
+
+        try {
+            startActivity(intent)
+        } catch (e: ActivityNotFoundException) {
+            Log.w(LOG_TAG, "No music store", e)
+            Toast.makeText(
+                requireContext(), R.string.n9_music_store_unavailable, Toast.LENGTH_SHORT
+            ).show()
+        }
+    }
+
+    companion object {
+        private val LOG_TAG = N9HomeFragment::class.simpleName!!
+
+        private const val STORE_PACKAGE_NAME = "com.bompotis.etesian.store"
+        private const val STORE_SEARCH_URI = "market://search?q=music&c=music"
+    }
+}
