+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.twelve.ui.views
+
+import android.content.Context
+import android.util.AttributeSet
+import android.view.ViewGroup
+import android.widget.ImageView
+import org.lineageos.twelve.ext.loadArtOrCover
+import org.lineageos.twelve.models.Album
+import kotlin.math.roundToInt
+
+/**
+ * The N9 Music home mosaic: 3x3 square album covers with thin dark gaps, no corners, no labels.
+ */
+class N9AlbumMosaic @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0,
+) : ViewGroup(context, attrs, defStyleAttr) {
+    private val gap = (2 * resources.displayMetrics.density).roundToInt()
+
+    private val imageViews = List(COUNT) {
+        ImageView(context).apply {
+            scaleType = ImageView.ScaleType.CENTER_CROP
+            setBackgroundColor(TILE_COLOR)
+            importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+            // Long presses belong to the whole mosaic
+            setOnLongClickListener { this@N9AlbumMosaic.performLongClick() }
+        }.also { addView(it) }
+    }
+
+    private var onAlbumClickListener: ((Album) -> Unit)? = null
+
+    fun setOnAlbumClickListener(listener: ((Album) -> Unit)?) {
+        onAlbumClickListener = listener
+    }
+
+    fun setAlbums(albums: List<Album>) {
+        imageViews.forEachIndexed { index, imageView ->
+            val album = albums.getOrNull(index)
+
+            imageView.setImageDrawable(null)
+            // N9: generated covers for albums without artwork.
+            album?.let { imageView.loadArtOrCover(it.thumbnail, it.title) }
+
+            imageView.contentDescription = album?.title
+            album?.let {
+                imageView.setOnClickListener { _ -> onAlbumClickListener?.invoke(it) }
+            } ?: run {
+                imageView.setOnClickListener(null)
+                imageView.isClickable = false
+            }
+        }
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val width = MeasureSpec.getSize(widthMeasureSpec)
+        val tile = (width - gap * (COLUMNS - 1)) / COLUMNS
+        val tileSpec = MeasureSpec.makeMeasureSpec(tile, MeasureSpec.EXACTLY)
+
+        imageViews.forEach { it.measure(tileSpec, tileSpec) }
+
+        setMeasuredDimension(width, tile * COLUMNS + gap * (COLUMNS - 1))
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        val tile = (r - l - gap * (COLUMNS - 1)) / COLUMNS
+
+        imageViews.forEachIndexed { index, imageView ->
+            val left = (index % COLUMNS) * (tile + gap)
+            val top = (index / COLUMNS) * (tile + gap)
+            imageView.layout(left, top, left + tile, top + tile)
+        }
+    }
+
+    companion object {
+        private const val COLUMNS = 3
+        const val COUNT = COLUMNS * COLUMNS
+
+        private const val TILE_COLOR = 0xFF1A1A1A.toInt()
+    }
+}
