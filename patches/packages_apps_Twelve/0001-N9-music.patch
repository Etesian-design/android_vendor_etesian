+++ b/app/src/main/java/org/lineageos/twelve/viewmodels/N9MusicViewModel.kt
@@ -0,0 +1,177 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.twelve.viewmodels
+
+import android.app.Application
+import androidx.lifecycle.viewModelScope
+import androidx.core.net.toUri
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.filterNotNull
+import kotlinx.coroutines.flow.firstOrNull
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.flow.flowOn
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import org.lineageos.twelve.ext.mediaItemFlow
+import org.lineageos.twelve.models.Album
+import org.lineageos.twelve.models.Error
+import org.lineageos.twelve.models.FlowResult
+import org.lineageos.twelve.models.FlowResult.Companion.asFlowResult
+import org.lineageos.twelve.models.FlowResult.Companion.getOrNull
+import org.lineageos.twelve.models.FlowResult.Companion.mapLatestData
+import org.lineageos.twelve.models.MediaItem
+import org.lineageos.twelve.models.Result
+import org.lineageos.twelve.models.Result.Companion.map
+import org.lineageos.twelve.models.SortingRule
+import org.lineageos.twelve.models.SortingStrategy
+import org.lineageos.twelve.models.Thumbnail
+
+/**
+ * N9 Music: the home mosaic and the Artists/Albums/Songs/Playlists lists.
+ */
+class N9MusicViewModel(application: Application) : TwelveViewModel(application) {
+    enum class Kind {
+        ARTISTS,
+        ALBUMS,
+        SONGS,
+        PLAYLISTS,
+    }
+
+    /**
+     * One list row: bold [title], grey [subtitle], optional grey [trailing] text (duration).
+     */
+    data class Row(
+        val item: MediaItem<*>,
+        val title: String?,
+        val subtitle: String?,
+        val trailing: String?,
+        val thumbnail: Thumbnail?,
+    )
+
+    private val kind = MutableStateFlow<Kind?>(null)
+
+    /** The audio playing now and its album, for the magenta row. */
+    @OptIn(ExperimentalCoroutinesApi::class)
+    val playing = mediaControllerFlow
+        .flatMapLatest { it.mediaItemFlow(eventsFlow) }
+        .map { item ->
+            item?.let { runCatching { it.mediaId.toUri() }.getOrNull() } to
+                    item?.mediaMetadata?.albumTitle?.toString()
+        }
+        .flowOn(Dispatchers.Main)
+        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(), null to null)
+
+    /**
+     * The most recent albums for the home mosaic, the ones with artwork first.
+     */
+    val mosaicAlbums = mediaRepository.albums(
+        SortingRule(SortingStrategy.CREATION_DATE, true)
+    )
+        .asFlowResult()
+        .map { result ->
+            result.getOrNull().orEmpty()
+                .sortedByDescending { it.thumbnail != null }
+                .take(MOSAIC_SIZE)
+        }
+        .flowOn(Dispatchers.IO)
+        .stateIn(
+            viewModelScope,
+            SharingStarted.WhileSubscribed(),
+            listOf<Album>()
+        )
+
+    @OptIn(ExperimentalCoroutinesApi::class)
+    val rows = kind
+        .filterNotNull()
+        .flatMapLatest { rowsOf(it) }
+        .flowOn(Dispatchers.IO)
+        .stateIn(
+            viewModelScope,
+            SharingStarted.WhileSubscribed(),
+            FlowResult.Loading
+        )
+
+    fun setKind(kind: Kind) {
+        this.kind.value = kind
+    }
+
+    suspend fun shuffleAll() = mediaRepository.audios().firstOrNull()?.map { audios ->
+        playAudio(audios.shuffled(), 0)
+    } ?: Result.Failure(Error.INVALID_RESPONSE)
+
+    private fun rowsOf(kind: Kind): Flow<FlowResult<List<Row>, Error>> = when (kind) {
+        Kind.ARTISTS -> combine(
+            mediaRepository.artists(byName).asFlowResult(),
+            mediaRepository.albums(byName).asFlowResult(),
+        ) { artists, albums ->
+            when (artists) {
+                is FlowResult.Loading -> FlowResult.Loading
+                is FlowResult.Failure -> FlowResult.Failure(artists.error, artists.throwable)
+                is FlowResult.Success -> {
+                    val albumsByArtist = albums.getOrNull().orEmpty()
+                        .filter { it.artistUri != null }
+                        .groupBy { it.artistUri }
+
+                    FlowResult.Success(
+                        artists.data.map { artist ->
+                            val album = albumsByArtist[artist.uri]?.firstOrNull()
+
+                            Row(
+                                artist,
+                                artist.name,
+                                album?.title,
+                                null,
+                                album?.thumbnail ?: artist.thumbnail,
+                            )
+                        }
+                    )
+                }
+            }
+        }
+
+        Kind.ALBUMS -> mediaRepository.albums(byName).asFlowResult().mapLatestData {
+            it.map { album ->
+                Row(album, album.title, album.artistName, null, album.thumbnail)
+            }
+        }
+
+        Kind.SONGS -> mediaRepository.audios(byName).asFlowResult().mapLatestData {
+            it.map { audio ->
+                Row(
+                    audio,
+                    audio.title,
+                    listOfNotNull(audio.artistName, audio.albumTitle)
+                        .joinToString(" | ")
+                        .takeIf { subtitle -> subtitle.isNotEmpty() },
+                    audio.durationMs?.let { durationMs -> formatDuration(durationMs) },
+                    null,
+                )
+            }
+        }
+
+        Kind.PLAYLISTS -> mediaRepository.playlists(byName).asFlowResult().mapLatestData {
+            it.map { playlist ->
+                Row(playlist, playlist.name, null, null, playlist.thumbnail)
+            }
+        }
+    }
+
+    companion object {
+        const val MOSAIC_SIZE = 9
+
+        private val byName = SortingRule(SortingStrategy.NAME)
+
+        private fun formatDuration(durationMs: Long): String {
+            val totalSeconds = durationMs / 1000
+            return "%d:%02d".format(totalSeconds / 60, totalSeconds % 60)
+        }
+    }
+}
