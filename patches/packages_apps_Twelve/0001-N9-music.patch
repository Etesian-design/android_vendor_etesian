new file mode 100644
index 0000000..f886d65
--- /dev/null
+++ b/app/src/main/java/org/lineageos/twelve/ext/N9Cover.kt
@@ -0,0 +1,133 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.twelve.ext
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.Typeface
+import android.graphics.drawable.Drawable
+import android.widget.ImageView
+import coil3.asImage
+import coil3.dispose
+import coil3.request.error
+import coil3.request.placeholder
+
+/**
+ * N9 Music cover for an album without artwork (n9-music-noart*.png): the album name in heavy caps in
+ * a bright colour, then the name again without spaces in a dark shade of it, every line justified,
+ * on black, edge to edge. The colour is stable per album; an unknown album is always purple.
+ */
+class N9CoverDrawable(album: String?) : Drawable() {
+    private val name = album?.trim()?.uppercase()?.takeIf { it.isNotEmpty() && !isUnknown(it) }
+        ?: "UNKNOWN ALBUM"
+    val color = if (name == "UNKNOWN ALBUM") UNKNOWN else PALETTE[Math.floorMod(name.hashCode(), PALETTE.size)]
+    private val dark = Color.rgb(Color.red(color) / 3, Color.green(color) / 3, Color.blue(color) / 3)
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        typeface = Typeface.create(Typeface.create("etesian-text", Typeface.NORMAL), 800, false)
+    }
+
+    override fun draw(canvas: Canvas) {
+        val b = bounds
+        if (b.isEmpty) return
+        canvas.save()
+        canvas.clipRect(b)
+        canvas.drawColor(Color.BLACK)
+        val w = b.width().toFloat()
+        paint.textSize = w / 6.2f
+        val lineHeight = paint.textSize * 1.12f
+        val lines = (b.height() / lineHeight).toInt() + 1
+        // The name word-wrapped (bright), then its letters without spaces (dark) filling every line.
+        val bright = wrap(name, w)
+        val rest = name.replace(" ", "")
+        var restIndex = 0
+        for (i in 0 until lines) {
+            val chars = StringBuilder()
+            val colors = ArrayList<Int>()
+            bright.getOrNull(i)?.let { s -> s.forEach { chars.append(it); colors.add(color) } }
+            if (i >= bright.size - 1) {
+                if (chars.isNotEmpty()) { chars.append(' '); colors.add(color) }
+                while (paint.measureText(chars.toString() + rest[restIndex % rest.length]) <= w) {
+                    chars.append(rest[restIndex % rest.length]); colors.add(dark); restIndex++
+                }
+            }
+            justify(canvas, chars.toString(), colors, b.left.toFloat(), w,
+                b.top + i * lineHeight + paint.textSize * 0.92f)
+        }
+        canvas.restore()
+    }
+
+    /** Greedy word wrap; a word wider than the line is broken. */
+    private fun wrap(text: String, w: Float): List<String> {
+        val out = ArrayList<String>()
+        var line = ""
+        for (word in text.split(' ').filter { it.isNotEmpty() }) {
+            var wd = word
+            val tryLine = if (line.isEmpty()) wd else "$line $wd"
+            if (paint.measureText(tryLine) <= w) { line = tryLine; continue }
+            if (line.isNotEmpty()) { out.add(line); line = "" }
+            while (paint.measureText(wd) > w) {
+                var n = wd.length
+                while (n > 1 && paint.measureText(wd, 0, n) > w) n--
+                out.add(wd.substring(0, n)); wd = wd.substring(n)
+            }
+            line = wd
+        }
+        if (line.isNotEmpty()) out.add(line)
+        return out
+    }
+
+    /** Draws [s] spread across [w]: the leftover width shared between the characters. */
+    private fun justify(canvas: Canvas, s: String, colors: List<Int>, x0: Float, w: Float, y: Float) {
+        if (s.isEmpty()) return
+        val gaps = (s.length - 1).coerceAtLeast(1)
+        // A short line (the name ends early) stays as it is rather than spread thin.
+        val extra = ((w - paint.measureText(s)) / gaps).coerceAtLeast(0f)
+            .let { if (it > paint.textSize * 0.25f) 0f else it }
+        var x = x0
+        s.forEachIndexed { i, c ->
+            paint.color = colors[i]
+            canvas.drawText(c.toString(), x, y, paint)
+            x += paint.measureText(c.toString()) + extra
+        }
+    }
+
+    override fun setAlpha(alpha: Int) { paint.alpha = alpha }
+    override fun setColorFilter(colorFilter: ColorFilter?) { paint.colorFilter = colorFilter }
+    @Deprecated("Deprecated in Java")
+    override fun getOpacity() = PixelFormat.OPAQUE
+
+    companion object {
+        /** Unknown / missing album. */
+        const val UNKNOWN = 0xFF8E10C4.toInt()
+
+        /** Bright N9 colours. */
+        private val PALETTE = intArrayOf(
+            0xFFFF5A00.toInt(), 0xFFE5007E.toInt(), 0xFF00A5E5.toInt(), 0xFF7DC400.toInt(),
+            0xFFFFB400.toInt(), 0xFFE3001B.toInt(), 0xFF00B3A4.toInt(), 0xFF2F6BFF.toInt(),
+        )
+
+        fun isUnknown(s: String) = s.equals("unknown", true) || s.equals("unknown album", true)
+            || s.equals("<unknown>", true)
+    }
+}
+
+/** Loads [data] as album art, square and as is; without art (or on error) the N9 generated cover. */
+fun ImageView.loadArtOrCover(data: Any?, album: String?) {
+    scaleType = ImageView.ScaleType.CENTER_CROP
+    val cover = N9CoverDrawable(album)
+    if (data == null) {
+        dispose()
+        setImageDrawable(cover)
+        return
+    }
+    loadThumbnail(data) {
+        placeholder(cover.asImage())
+        error(cover.asImage())
+    }
+}
