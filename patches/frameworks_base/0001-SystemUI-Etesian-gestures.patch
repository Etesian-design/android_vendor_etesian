+/**
+ * Etesian (N9) screen frame: the status bar is always a solid black strip and every
+ * application sits under it as a card with rounded corners. Two untouchable overlays above
+ * applications (below the status bar icons, keyboard, status menu and lock screen) draw the
+ * black strip with corner fillets under it, and the fillets at the bottom of the screen.
+ * Hidden while an application hides the status bar (full screen video and the like).
+ */
+public final class EtesianScreenFrame implements CommandQueue.Callbacks {
+
+    private static final String SETTING = "etesian_gestures";
+    private static final int RADIUS_DP = 9;
+
+    /** Read by LightBarControllerImpl: on the black strip the status bar icons stay white. */
+    private static volatile boolean sActive;
+
+    public static boolean isActive() {
+        return sActive;
+    }
+
+    private final Context mContext;
+    private final WindowManager mWindowManager;
+    private final Edge mTop;
+    private final Edge mBottom;
+    private boolean mAdded;
+    private boolean mStatusBarVisible = true;
+
+    public EtesianScreenFrame(Context context, CommandQueue commandQueue) {
+        mContext = context;
+        mWindowManager = context.getSystemService(WindowManager.class);
+        mTop = new Edge(context, true);
+        mBottom = new Edge(context, false);
+        commandQueue.addCallback(this);
+        context.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(SETTING),
+                false, new ContentObserver(new Handler(Looper.getMainLooper())) {
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        update();
+                    }
+                }, UserHandle.USER_ALL);
+        update();
+    }
+
+    private boolean enabled() {
+        return Settings.Secure.getIntForUser(mContext.getContentResolver(), SETTING, 0,
+                UserHandle.USER_CURRENT) == 1;
+    }
+
+    private void update() {
+        final boolean enabled = enabled();
+        sActive = enabled;
+        if (enabled && !mAdded) {
+            mWindowManager.addView(mTop, mTop.layoutParams());
+            mWindowManager.addView(mBottom, mBottom.layoutParams());
+            mAdded = true;
+        } else if (!enabled && mAdded) {
+            mWindowManager.removeView(mTop);
+            mWindowManager.removeView(mBottom);
+            mAdded = false;
+        }
+        applyVisibility();
+    }
+
+    private void applyVisibility() {
+        final int v = mStatusBarVisible ? View.VISIBLE : View.GONE;
+        mTop.setVisibility(v);
+        mBottom.setVisibility(v);
+    }
+
+    @Override
+    public void onSystemBarAttributesChanged(int displayId, int appearance,
+            AppearanceRegion[] appearanceRegions, boolean navbarColorManagedByIme, int behavior,
+            int requestedVisibleTypes, String packageName,
+            com.android.internal.statusbar.LetterboxDetails[] letterboxDetails) {
+        if (displayId != Display.DEFAULT_DISPLAY) return;
+        final boolean visible = (requestedVisibleTypes & WindowInsets.Type.statusBars()) != 0;
+        if (visible != mStatusBarVisible) {
+            mStatusBarVisible = visible;
+            applyVisibility();
+        }
+    }
+
+    /** One overlay: the top strip with fillets under it, or the bottom fillets. */
+    private static final class Edge extends View {
+        private final boolean mIsTop;
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path mPath = new Path();
+        private final int mRadius;
+        private int mStatusBarHeight;
+
+        Edge(Context context, boolean top) {
+            super(context);
+            mIsTop = top;
+            mPaint.setColor(Color.BLACK);
+            mRadius = (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, RADIUS_DP,
+                    context.getResources().getDisplayMetrics());
+            mStatusBarHeight = SystemBarUtils.getStatusBarHeight(context);
+        }
+
+        WindowManager.LayoutParams layoutParams() {
+            final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(
+                    WindowManager.LayoutParams.MATCH_PARENT,
+                    mIsTop ? mStatusBarHeight + mRadius : mRadius,
+                    // Above applications, below the keyboard, status bar and shade.
+                    WindowManager.LayoutParams.TYPE_SYSTEM_ALERT,
+                    WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
+                            | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                            | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+                    PixelFormat.TRANSLUCENT);
+            lp.gravity = mIsTop ? Gravity.TOP : Gravity.BOTTOM;
+            lp.setFitInsetsTypes(0);
+            lp.layoutInDisplayCutoutMode =
+                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS;
+            lp.setTrustedOverlay();
+            lp.setTitle(mIsTop ? "EtesianFrameTop" : "EtesianFrameBottom");
+            return lp;
+        }
+
+        @Override
+        protected void onConfigurationChanged(Configuration newConfig) {
+            super.onConfigurationChanged(newConfig);
+            final int height = SystemBarUtils.getStatusBarHeight(getContext());
+            if (mIsTop && height != mStatusBarHeight && isAttachedToWindow()) {
+                mStatusBarHeight = height;
+                getContext().getSystemService(WindowManager.class)
+                        .updateViewLayout(this, layoutParams());
+            }
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final int w = getWidth();
+            final float r = mRadius;
+            final float edge = mIsTop ? mStatusBarHeight : getHeight();
+            mPath.reset();
+            if (mIsTop) {
+                canvas.drawRect(0, 0, w, mStatusBarHeight, mPaint);
+                // Fillets hanging under the strip: the app card's rounded top corners.
+                mPath.moveTo(0, edge);
+                mPath.lineTo(r, edge);
+                mPath.arcTo(0, edge, 2 * r, edge + 2 * r, 270, -90, false);
+                mPath.close();
+                mPath.moveTo(w, edge);
+                mPath.lineTo(w, edge + r);
+                mPath.arcTo(w - 2 * r, edge, w, edge + 2 * r, 0, -90, false);
+                mPath.close();
+            } else {
+                // The card's rounded bottom corners.
+                mPath.moveTo(0, edge);
+                mPath.lineTo(0, edge - r);
+                mPath.arcTo(0, edge - 2 * r, 2 * r, edge, 180, -90, false);
+                mPath.close();
+                mPath.moveTo(w, edge);
+                mPath.lineTo(w - r, edge);
+                mPath.arcTo(w - 2 * r, edge - 2 * r, w, edge, 90, -90, false);
+                mPath.close();
+            }
+            canvas.drawPath(mPath, mPaint);
+        }
+    }
+}
