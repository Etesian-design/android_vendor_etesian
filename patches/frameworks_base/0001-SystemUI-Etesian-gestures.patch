+    private static final String ACTION_SET = "com.bompotis.etesian.toolbar.SET";
+    private static final String ACTION_CLEAR = "com.bompotis.etesian.toolbar.CLEAR";
+    /** The launcher asks for a task's toolbar, to show a small copy under a pop-up window. */
+    private static final String ACTION_QUERY = "com.bompotis.etesian.toolbar.QUERY";
+    private static final String ACTION_CHANGED = "com.bompotis.etesian.toolbar.CHANGED";
+    private static final String LAUNCHER = "com.bompotis.etesian.launcher";
+
+    /** One app screen's items, as sent through the toolbar API. */
+    private static final class Registration {
+        String component;
+        boolean back;
+        String style;
+        /** The app asked for no toolbar on this activity. */
+        boolean hidden;
+        ArrayList<Bundle> items;
+        PendingIntent callback;
+    }
+
+    /**
+     * By task id, then by activity: each screen keeps its own, so going Back shows the parent's
+     * bar at once instead of the default until the parent sends it again.
+     */
+    private static final SparseArray<java.util.HashMap<String, Registration>> sRegistrations =
+            new SparseArray<>();
+    /** By task id: the registration sent last (what the launcher draws on the task's card). */
+    private static final SparseArray<Registration> sLatest = new SparseArray<>();
+
+    private static Registration registration(int task, String component) {
+        final java.util.HashMap<String, Registration> m = sRegistrations.get(task);
+        return m == null || component == null ? null : m.get(component);
+    }
+
+    /** Packages that have used the toolbar API since SystemUI started. */
+    private static final java.util.HashSet<String> sApiPackages = new java.util.HashSet<>();
+
+    /** Whether [component]'s app uses the toolbar API (so its registration is coming). */
+    private static boolean usesApi(String component) {
+        if (component == null) return false;
+        return sApiPackages.contains(component.substring(0, Math.max(0, component.indexOf('/'))));
+    }
+
+    /** Colours for one theme. */
+    private static final class Theme {
+        final int top, bottom, edge, highlight, selected, icon, buttonTop, buttonBottom, stroke,
+                badge, badgeText;
+
+        Theme(int top, int bottom, int edge, int highlight, int selected, int icon,
+                int buttonTop, int buttonBottom, int stroke, int badge, int badgeText) {
+            this.top = top; this.bottom = bottom; this.edge = edge; this.highlight = highlight;
+            this.selected = selected; this.icon = icon; this.buttonTop = buttonTop;
+            this.buttonBottom = buttonBottom; this.stroke = stroke; this.badge = badge;
+            this.badgeText = badgeText;
+        }
+    }
+
+    /** N9: the Store/Calendar toolbar. */
+    private static final Theme N9_LIGHT = new Theme(0xFFD6D6D8, 0xFFADADB0, 0xFF8E8E90,
+            0xFFF4F4F4, 0x66FFFFFF, 0xFF262626, 0xFFF2F2F2, 0xFFCDCDCF, 0xFF9C9C9E,
+            0xFFF26B1D, Color.WHITE);
+    /** Symbian Belle: charcoal gradient, white glyphs, a soft highlight under the selection. */
+    private static final Theme BELLE_DARK = new Theme(0xFF3C3D40, 0xFF141416, 0xFF000000,
+            0xFF5C5E62, 0x30FFFFFF, Color.WHITE, 0xFF4A4B4F, 0xFF26272A, 0xFF66686C,
+            0xFF2A86D8, Color.WHITE);
+
+    private final Paint mFillPaint = new Paint();
+    private final int mButtonSize;
+    private Theme mTheme = N9_LIGHT;
+    /** The task and activity in front, to match against registrations. */
+    private int mTopTask = -1;
+    private String mTopComponent;
+
+    private final BroadcastReceiver mApiReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            final int task = intent.getIntExtra("task", -1);
+            if (ACTION_QUERY.equals(intent.getAction())) {
+                if (task >= 0) sendToLauncher(context, task);
+                return;
+            }
+            final String component = intent.getStringExtra("component");
+            if (task < 0 || component == null) return;
+            if (ACTION_CLEAR.equals(intent.getAction())) {
+                final ComponentName cleared = ComponentName.unflattenFromString(component);
+                final java.util.HashMap<String, Registration> m = sRegistrations.get(task);
+                if (m != null && cleared != null) m.remove(resolveAlias(context, cleared));
+            } else {
+                final PendingIntent callback = intent.getParcelableExtra("callback",
+                        PendingIntent.class);
+                final ComponentName cn = ComponentName.unflattenFromString(component);
+                // Only the app that owns the activity may set its toolbar.
+                if (callback == null || cn == null
+                        || !cn.getPackageName().equals(callback.getCreatorPackage())) {
+                    return;
+                }
+                final Registration r = new Registration();
+                r.component = resolveAlias(context, cn);
+                r.back = intent.getBooleanExtra("back", true);
+                r.style = intent.getStringExtra("style");
+                r.hidden = intent.getBooleanExtra("hidden", false);
+                r.items = intent.getParcelableArrayListExtra("items", Bundle.class);
+                r.callback = callback;
+                if (r.items == null) r.items = new ArrayList<>();
+                java.util.HashMap<String, Registration> m = sRegistrations.get(task);
+                if (m == null) sRegistrations.put(task, m = new java.util.HashMap<>());
+                m.put(r.component, r);
+                sApiPackages.add(cn.getPackageName());
+                sLatest.put(task, r);
+            }
+            rebuild();
+            if (!mVertical) sendToLauncher(context, task);
+        }
+    };
+
+    /** Only the launcher gets it; it only draws the items and sends taps to the app's callback. */
+    private static void sendToLauncher(Context context, int task) {
+        final Registration r = sLatest.get(task);
+        final Intent out = new Intent(ACTION_CHANGED).setPackage(LAUNCHER).putExtra("task", task)
+                .putExtra("height", barHeightPx(context));
+        if (r != null) {
+            out.putExtra("style", r.style)
+                    .putExtra("hidden", r.hidden)
+                    .putExtra("back", r.back)
+                    .putParcelableArrayListExtra("items", r.items)
+                    .putExtra("callback", r.callback);
+        }
+        context.sendBroadcastAsUser(out, UserHandle.CURRENT);
+    }
+
+    private final TaskStackChangeListener mTaskListener = new TaskStackChangeListener() {
+        @Override
+        public void onTaskStackChanged() {
+            updateTopTask();
+        }
+
+        @Override
+        public void onTaskRemoved(int taskId) {
+            sRegistrations.remove(taskId);
+            sLatest.remove(taskId);
+            updateTopTask();
+        }
+    };
+
+    /** Vertical: the side strip (cells stacked, Back on top). */
+    private final boolean mVertical;
+    /** Called after any button is used (the side strip hides then). */
+    private Runnable mOnUsed;
+
+    public EtesianBottomBar(Context context) {
+        this(context, false);
+    }
+
+    public EtesianBottomBar(Context context, boolean vertical) {
+        super(context);
+        mVertical = vertical;
+        setOrientation(vertical ? VERTICAL : HORIZONTAL);
+        setGravity(Gravity.CENTER_VERTICAL);
+        setWillNotDraw(false);
+        mButtonSize = dp(BUTTON_DP);
+        rebuild();
+    }
+
+    public void setOnUsed(Runnable onUsed) {
+        mOnUsed = onUsed;
+    }
+
+    private void used() {
+        if (mOnUsed != null) mOnUsed.run();
+    }
+
+    /** Whether the toolbar is on at all (bar or side strip; on by default in N9 mode). */
+    public static boolean isOn(Context context) {
+        return Settings.Secure.getIntForUser(context.getContentResolver(), SETTING_GESTURES, 1,
+                UserHandle.USER_CURRENT) == 1
+                && Settings.Secure.getIntForUser(context.getContentResolver(), SETTING_ENABLED, 1,
+                UserHandle.USER_CURRENT) == 1;
+    }
+
+    /** Side strip instead of the bottom bar. */
+    public static boolean isStrip(Context context) {
+        return Settings.Secure.getIntForUser(context.getContentResolver(), SETTING_MODE, 0,
+                UserHandle.USER_CURRENT) == 1;
+    }
+
+    /** True when the bar should replace the navigation bar contents. */
+    public static boolean isEnabled(Context context) {
+        return isOn(context) && !isStrip(context);
+    }
+
+    public static int barHeightPx(Context context) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, BAR_HEIGHT_DP,
+                context.getResources().getDisplayMetrics());
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        final IntentFilter filter = new IntentFilter(ACTION_SET);
+        filter.addAction(ACTION_CLEAR);
+        if (!mVertical) filter.addAction(ACTION_QUERY);
+        getContext().registerReceiverAsUser(mApiReceiver, UserHandle.ALL, filter, null, null,
+                Context.RECEIVER_EXPORTED);
+        TaskStackChangeListeners.getInstance().registerTaskStackListener(mTaskListener);
+        updateTopTask();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        TaskStackChangeListeners.getInstance().unregisterTaskStackListener(mTaskListener);
+        try {
+            getContext().unregisterReceiver(mApiReceiver);
+        } catch (IllegalArgumentException ignored) {
+        }
+        super.onDetachedFromWindow();
+    }
+
+    /** Whether the home screen is in front (the bar collapses there, as on the N9). */
+    /** No bar: home is in front, or the app in front asked for none. */
+    public boolean isHomeInFront() {
+        // A pinned app always has the bar: long-press Back is the way out (mock 10).
+        return !pinned() && (mHomeInFront || mAppHidden);
+    }
+
+    public void setOnHomeChanged(Runnable onHomeChanged) {
+        mOnHomeChanged = onHomeChanged;
+    }
+
+    private boolean mHomeInFront;
+    private boolean mAppHidden;
+    private Runnable mOnHomeChanged;
+
+    private final Runnable mRecheckTopTask = this::updateTopTask;
+
+    /** Re-reads the top task (e.g. when an app is pinned from home: the bar shows its Back). */
+    public void refreshTopTask() {
+        removeCallbacks(mRecheckTopTask);
+        if (pinned()) {
+            mTopTask = -1; mTopComponent = null; mHomeInFront = false; mAppHidden = false;
+            if (mOnHomeChanged != null) mOnHomeChanged.run();
+        }
+        postDelayed(mRecheckTopTask, 300);
+    }
+
+    private void updateTopTask() {
+        final ActivityManager.RunningTaskInfo top =
+                ActivityManagerWrapper.getInstance().getRunningTask();
+        // During the N9 swipe home is transiently launched on top while the app is still being
+        // dragged (WM attaches this bar to the app's surface meanwhile). Keep the app's items
+        // until the transition settles; the next task-stack change reports the final state.
+        if (top != null && mTopTask != -1 && top.taskId != mTopTask
+                && top.getActivityType() == android.app.WindowConfiguration.ACTIVITY_TYPE_HOME
+                && isTaskStillVisible(mTopTask)) {
+            return;
+        }
+        final boolean home = top != null
+                && top.getActivityType() == android.app.WindowConfiguration.ACTIVITY_TYPE_HOME;
+        // N9 launch: an application starting over home has no splash, so it isn't on screen
+        // until it has drawn and slides in. Stay collapsed until then, or the bar would show
+        // over the app grid while the icon's loading ring runs.
+        if (top != null && !home && mHomeInFront && !pinned() && !isTaskStillVisible(top.taskId)) {
+            removeCallbacks(mRecheckTopTask);
+            postDelayed(mRecheckTopTask, 100);
+            return;
+        }
+        // Rebuild for the new app before the bar is resized for it, so the frame drawn at the
+        // new size never shows the previous app's items.
+        final int task = top != null ? top.taskId : -1;
+        final String component = top != null && top.topActivity != null
+                ? top.topActivity.flattenToString() : null;
+        if (task != mTopTask || !TextUtils.equals(component, mTopComponent)) {
+            // A new page in the same task: its items slide in with it (from the right going
+            // forward, from the left going back to a page already seen).
+            final boolean samePage = task == mTopTask && mTopTask != -1;
+            final boolean goingBack = registration(task, component) != null;
+            mTopTask = task;
+            mTopComponent = component;
+            removeCallbacks(mPendingRebuild);
+            if (registration(task, component) == null && usesApi(component)) {
+                // Its registration is on its way: keep the bar as it is until it lands, rather
+                // than flashing the default bar for a frame.
+                mSlideFrom = samePage ? 1 : 0;
+                postDelayed(mPendingRebuild, 500);
+            } else {
+                mSlideFrom = samePage ? (goingBack ? -1 : 1) : 0;
+                rebuild();
+            }
+        }
+        if (home != mHomeInFront) {
+            mHomeInFront = home;
+            if (mOnHomeChanged != null) mOnHomeChanged.run();
+        }
+    }
+
+    private static boolean isTaskStillVisible(int taskId) {
+        try {
+            final java.util.List<ActivityManager.RunningTaskInfo> tasks =
+                    android.app.ActivityTaskManager.getService().getTasks(3, false, false,
+                            android.view.Display.INVALID_DISPLAY);
+            for (ActivityManager.RunningTaskInfo t : tasks) {
+                if (t.taskId == taskId) return t.isVisible && t.isVisibleRequested;
+            }
+        } catch (Exception e) {
+            // Fall through: treat as gone.
+        }
+        return false;
+    }
+
+    /** An activity-alias's target, as the task stack reports it, so the two names match. */
+    private static String resolveAlias(Context context, ComponentName cn) {
+        try {
+            final android.content.pm.ActivityInfo info = context.getPackageManager()
+                    .getActivityInfo(cn, 0);
+            if (info.targetActivity != null) {
+                return new ComponentName(cn.getPackageName(), info.targetActivity)
+                        .flattenToString();
+            }
+        } catch (Exception e) {
+            // Not resolvable; keep the name the app gave.
+        }
+        return cn.flattenToString();
+    }
+
+    /** The front app's registration, if it is the activity in front. */
+    private Registration current() {
+        return registration(mTopTask, mTopComponent);
+    }
+
+    /** 1: the next build slides in from the right, -1: from the left, 0: no slide. */
+    private int mSlideFrom;
+    private final Runnable mPendingRebuild = this::rebuild;
+
+    private final java.util.HashMap<String, Boolean> mLightThemes = new java.util.HashMap<>();
+
+    /** Whether [component]'s theme is a light one (a dark page gets the dark bar). */
+    private boolean isLightActivity(String component) {
+        if (component == null) return true;
+        final Boolean known = mLightThemes.get(component);
+        if (known != null) return known;
+        boolean light = true;
+        try {
+            final ComponentName cn = ComponentName.unflattenFromString(component);
+            final android.content.pm.ActivityInfo info =
+                    getContext().getPackageManager().getActivityInfo(cn, 0);
+            final Context app = getContext().createPackageContext(cn.getPackageName(), 0);
+            final android.content.res.Resources.Theme theme = app.getResources().newTheme();
+            theme.applyStyle(info.getThemeResource(), true);
+            final android.content.res.TypedArray a = theme.obtainStyledAttributes(
+                    new int[] {android.R.attr.isLightTheme});
+            light = a.getBoolean(0, true);
+            a.recycle();
+        } catch (Exception e) {
+            // Unknown: the N9's light bar.
+        }
+        mLightThemes.put(component, light);
+        return light;
+    }
+
+    /** Re-reads the settings and recreates the buttons. */
+    public void rebuild() {
+        removeCallbacks(mPendingRebuild);
+        final int slide = mSlideFrom;
+        mSlideFrom = 0;
+        removeAllViews();
+        mTheme = Settings.Secure.getIntForUser(getContext().getContentResolver(), SETTING_STYLE,
+                0, UserHandle.USER_CURRENT) == 1 ? BELLE_DARK : N9_LIGHT;
+        final boolean backRight = Settings.Secure.getIntForUser(getContext().getContentResolver(),
+                SETTING_BACK_SIDE, 0, UserHandle.USER_CURRENT) == 1;
+        final Registration api = current();
+        final boolean hidden = api != null && api.hidden;
+        if (hidden != mAppHidden) {
+            mAppHidden = hidden;
+            if (mOnHomeChanged != null) post(mOnHomeChanged);
+        }
+        // An app may ask for a dark or light bar whatever the user's theme (the N9's Gallery
+        // has a black bar while the other apps' are light).
+        if (api != null && "dark".equals(api.style)) mTheme = BELLE_DARK;
+        if (api != null && "light".equals(api.style)) mTheme = N9_LIGHT;
+        // Without a say from the app, a dark page gets the dark bar so it never shows white.
+        if ((api == null || api.style == null) && mTheme == N9_LIGHT && !mHomeInFront
+                && !isLightActivity(mTopComponent)) {
+            mTheme = BELLE_DARK;
+        }
+        invalidate();
+        if (slide != 0 && getWidth() > 0) post(() -> {
+            for (int i = 0; i < getChildCount(); i++) {
+                final View c = getChildAt(i);
+                c.setTranslationX(slide * getWidth() * 0.3f);
+                c.setAlpha(0f);
+                c.animate().translationX(0f).alpha(1f).setDuration(300)
+                        .setInterpolator(new android.view.animation.DecelerateInterpolator(1.5f))
+                        .start();
+            }
+        });
+
+        final List<View> buttons = new ArrayList<>();
+        // A pinned app always offers Back: long-press it to unpin (mock 10).
+        final boolean back = pinned() || api == null || api.back;
+        if (api != null) {
+            // The app's own items, as equal N9 cells.
+            setPadding(0, mVertical ? dp(4) : 0, 0, mVertical ? dp(4) : 0);
+            for (Bundle item : api.items) buttons.add(apiCell(item, api.callback));
+        } else {
+            if (mVertical) setPadding(0, dp(4), 0, dp(4)); else setPadding(dp(8), 0, dp(8), 0);
+            buttons.addAll(customButtons());
+        }
+
+        final View backButton = back ? backButton() : null;
+        if (mVertical) {
+            // Side strip: Back on top, the rest below it.
+            if (backButton != null) addView(backButton);
+            for (View b : buttons) addView(b);
+            return;
+        }
+        // N9 (measured, 480 px wide): the first and last button centres sit 44 px from the
+        // edges whatever the count, the others evenly between them; a lone one sits at its side
+        // (Back on its side, an app item by its "align", default end). Tabs fill equal cells.
+        setPadding(0, getPaddingTop(), 0, getPaddingBottom());
+        final List<View> all = new ArrayList<>();
+        if (backButton != null && !backRight) all.add(backButton);
+        for (View b : buttons) {
+            if (b instanceof FrameLayout) { all.add(b); continue; }
+            // a bare squircle button keeps its size, centred in its cell
+            final FrameLayout slot = new FrameLayout(getContext());
+            slot.addView(b, new FrameLayout.LayoutParams(mButtonSize, mButtonSize, Gravity.CENTER));
+            all.add(slot);
+        }
+        if (backButton != null && backRight) all.add(backButton);
+        boolean tabs = false;
+        if (api != null) for (Bundle item : api.items) tabs |= item.getBoolean("tab");
+        if (tabs) {
+            for (View v : all) {
+                v.setLayoutParams(new LayoutParams(0, LayoutParams.MATCH_PARENT, 1f));
+                addView(v);
+            }
+            return;
+        }
+        final int cell = Math.round(getResources().getDisplayMetrics().widthPixels * 88f / 480f);
+        if (all.size() == 1) {
+            final View only = all.get(0);
+            final boolean start = only == backButton ? !backRight
+                    : api != null && api.items.size() == 1
+                            && "start".equals(api.items.get(0).getString("align"));
+            only.setLayoutParams(new LayoutParams(cell, LayoutParams.MATCH_PARENT));
+            if (start) addView(only);
+            addView(new View(getContext()), new LayoutParams(0, LayoutParams.MATCH_PARENT, 1f));
+            if (!start) addView(only);
+            return;
+        }
+        // Equal cells 88/480 wide at both edges with equal gaps: centres evenly spaced from 44.
+        for (int i = 0; i < all.size(); i++) {
+            if (i > 0) addView(new View(getContext()), new LayoutParams(0, LayoutParams.MATCH_PARENT, 1f));
+            all.get(i).setLayoutParams(new LayoutParams(cell, LayoutParams.MATCH_PARENT));
+            addView(all.get(i));
+        }
+    }
+
+    /** Back: the N9's rounded button, in a fixed cell. */
+    private View backButton() {
+        final ImageView back = makeButton(new ArrowDrawable(mTheme.icon));
+        back.setContentDescription("Back");
+        back.setOnTouchListener((v, ev) -> {
+            switch (ev.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    v.setPressed(true);
+                    v.setAlpha(0.6f);
+                    mBackDownTime = SystemClock.uptimeMillis();
+                    mUnpinned = false;
+                    if (pinned()) postDelayed(mUnpin, 1000);
+                    sendBack(KeyEvent.ACTION_DOWN, 0);
+                    v.performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+                    return true;
+                case MotionEvent.ACTION_UP:
+                    v.setPressed(false);
+                    v.setAlpha(1f);
+                    removeCallbacks(mUnpin);
+                    sendBack(KeyEvent.ACTION_UP, mUnpinned ? KeyEvent.FLAG_CANCELED : 0);
+                    used();
+                    return true;
+                case MotionEvent.ACTION_CANCEL:
+                    removeCallbacks(mUnpin);
+                    v.setPressed(false);
+                    v.setAlpha(1f);
+                    sendBack(KeyEvent.ACTION_UP, KeyEvent.FLAG_CANCELED);
+                    return true;
+            }
+            return true;
+        });
+        final FrameLayout cell = new FrameLayout(getContext());
+        cell.addView(back, new FrameLayout.LayoutParams(mButtonSize, mButtonSize, Gravity.CENTER));
+        cell.setLayoutParams(mVertical ? new LayoutParams(LayoutParams.MATCH_PARENT, dp(72))
+                : new LayoutParams(dp(72), LayoutParams.MATCH_PARENT));
+        return cell;
+    }
+
+    /** One API item: an icon-only cell; a selected tab is the N9's lighter block. */
+    private View apiCell(Bundle item, PendingIntent callback) {
+        final String id = item.getString("id");
+        final boolean enabled = item.getBoolean("enabled", true);
+        final FrameLayout cell = new FrameLayout(getContext());
+        final ImageView icon = new ImageView(getContext());
+        final Icon ic = item.getParcelable("icon", Icon.class);
+        Drawable d = null;
+        if (ic != null) {
+            try {
+                d = ic.loadDrawable(getContext());
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Bad toolbar icon for " + id, e);
+            }
+        }
+        icon.setImageDrawable(d);
+        if (item.getBoolean("tint", true)) icon.setImageTintList(ColorStateList.valueOf(mTheme.icon));
+        icon.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        icon.setAlpha(enabled ? 1f : 0.35f);
+        final boolean tab = item.getBoolean("tab");
+        // An action is only its squircle (hit and pressed area); a tab is its whole slot.
+        final FrameLayout target = tab ? cell : new FrameLayout(getContext());
+        if (!tab) {
+            cell.addView(target, new FrameLayout.LayoutParams(mButtonSize, mButtonSize, Gravity.CENTER));
+            final android.graphics.drawable.StateListDrawable press = new android.graphics.drawable.StateListDrawable();
+            press.addState(new int[] {android.R.attr.state_pressed},
+                    new SquircleDrawable(new int[] {mTheme.selected, mTheme.selected}, 0, 0, mButtonSize));
