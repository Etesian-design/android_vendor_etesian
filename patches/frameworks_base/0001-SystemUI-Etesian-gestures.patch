+                ? ambientState.getShelf().getViewState() : null;
+        if (!EtesianLockList.getMoreLabel()) {
+            layoutCarouselForEtesian(ambientState, shown, more, shelf, areaBottom);
+            return;
+        }
+        if (EtesianLockList.getExpanded()) {
+            layoutOpenListForEtesian(shown, more, shelf, areaBottom);
+            return;
+        }
+        float contentBottom = -1;
+        for (ExpandableView v : shown) {
+            final ExpandableViewState st = v.getViewState();
+            contentBottom = Math.max(contentBottom, st.getYTranslation() + st.height);
+        }
