+import android.widget.FrameLayout
+import kotlin.math.abs
+
+/**
+ * Etesian (Android extras → "Notification bubbles over apps", etesian_extra_bubbles): instead
+ * of the Android heads-up, the lock screen's notification card floats just below the status bar.
+ * Tap opens it, a swipe up dismisses it; it has no buttons. Also used for "Screenshot saved" and
+ * "App pinned". Off (the default): the stock behaviour everywhere.
+ */
+object EtesianBubble {
+    const val SETTING = "etesian_extra_bubbles"
+    private const val SHOW_MS = 5000L
+
+    private val main = Handler(Looper.getMainLooper())
+    private var window: FrameLayout? = null
+    private var wm: WindowManager? = null
+    private val hide = Runnable { dismiss(animate = true) }
+
+    /** The lock screen is up (and not covered by an app such as the camera). */
+    @JvmStatic
+    fun onLockScreen(context: Context): Boolean {
+        val km = context.getSystemService(android.app.KeyguardManager::class.java) ?: return false
+        if (!km.isKeyguardLocked) return false
+        val pm = context.getSystemService(android.os.PowerManager::class.java)
+        // Screen off counts too: the card is waiting in the stack when it wakes.
+        return pm?.isInteractive == false || !occluded(context)
+    }
+
+    /** An activity shows over the lock screen (camera, alarm, call). */
+    private fun occluded(context: Context): Boolean = runCatching {
+        val atm = android.app.ActivityTaskManager.getService()
+        atm.getRootTaskInfoOnDisplay(android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN,
+            android.app.WindowConfiguration.ACTIVITY_TYPE_STANDARD, Display.DEFAULT_DISPLAY)?.let { it.visible } ?: false
+    }.getOrDefault(false)
+
+    @JvmStatic
+    fun enabled(context: Context): Boolean =
+        Settings.Secure.getInt(context.contentResolver, SETTING, 0) == 1
+
+    /** A notification's bubble; tapping sends its content intent. */
+    @JvmStatic
+    fun show(context: Context, sbn: StatusBarNotification) {
+        // On the lock screen the notification only joins the card stack there: no bubble over it.
+        if (onLockScreen(context)) return
+        main.post {
+            val card = EtesianLockCard(windowContext(context))
+            card.bind(sbn, 1)
+            val intent = sbn.notification.contentIntent
+            present(context, card, "Notification bubble") {
+                runCatching {
+                    intent?.send(null, 0, null, null, null, null,
+                        ActivityOptions.makeBasic().setPendingIntentBackgroundActivityStartMode(
+                            ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOWED).toBundle())
+                }
+            }
+        }
+    }
+
+    /** Something else's bubble (screenshot, pinning); [onTap] null = tap only dismisses. */
+    @JvmStatic
+    fun showCustom(context: Context, picture: Drawable?, asIs: Boolean, title: String,
+            line: String, time: Long, onTap: Runnable?) {
+        main.post {
+            val card = EtesianLockCard(windowContext(context))
+            card.bindCustom(picture, asIs, title, line, time)
+            present(context, card, title) { onTap?.run() }
+        }
+    }
+
+    /** [glyph] in white on a lit squircle tile of colours [top]→[bottom] (the clip shapes it). */
+    @JvmStatic
+    fun litTile(context: Context, glyph: Int, top: Int, bottom: Int): Drawable? {
+        val g = runCatching { context.getDrawable(glyph) }.getOrNull()?.mutate() ?: return null
+        g.setTint(0xFFFFFFFF.toInt())
+        val tile = android.graphics.drawable.GradientDrawable(
+            android.graphics.drawable.GradientDrawable.Orientation.TOP_BOTTOM, intArrayOf(top, bottom))
+        val inset = (11 * context.resources.displayMetrics.density).toInt()
+        return android.graphics.drawable.LayerDrawable(arrayOf(tile, g)).apply {
+            setLayerInset(1, inset, inset, inset, inset)
+        }
+    }
+
+    /** "App pinned · Long-press Back to unpin" with a lit blue lock. */
+    @JvmStatic
+    fun showPinned(context: Context) = showCustom(context,
+        litTile(context, com.android.internal.R.drawable.ic_lock, 0xFF2A86D8.toInt(), 0xFF0B3F9E.toInt()),
+        false, "App pinned", "Long-press Back to unpin", 0L, null)
+
+    /** Android extras → "Copied" bubble (etesian_extra_copied). */
+    @JvmStatic
+    fun copiedEnabled(context: Context): Boolean =
+        Settings.Secure.getInt(context.contentResolver, "etesian_extra_copied", 0) == 1
+
+    /** "Copied · Text copied to clipboard" with a lit green check (story Phone v2, state copied). */
+    @JvmStatic
+    fun showCopied(context: Context, clip: android.content.ClipData?) {
+        val item = clip?.takeIf { it.itemCount > 0 }?.getItemAt(0)
+        val what = when {
+            item?.uri != null && clip.description?.hasMimeType("image/*") == true -> "Image"
+            item?.uri != null -> "Item"
+            else -> "Text"
+        }
+        showCustom(context,
+            litTile(context, com.android.systemui.res.R.drawable.ic_check, 0xFF5CC27A.toInt(), 0xFF2E8A47.toInt()),
+            false, "Copied", "$what copied to clipboard", 0L, null)
+    }
+
+    private fun windowContext(context: Context): Context {
+        val display = context.getSystemService(DisplayManager::class.java).getDisplay(Display.DEFAULT_DISPLAY)
+        return context.createWindowContext(display, WindowManager.LayoutParams.TYPE_STATUS_BAR_SUB_PANEL, null)
+    }
+
+    private fun statusBarHeight(context: Context): Int {
+        val id = context.resources.getIdentifier("status_bar_height", "dimen", "android")
+        return if (id > 0) context.resources.getDimensionPixelSize(id) else 0
+    }
+
+    private fun present(context: Context, card: EtesianLockCard, label: String, onTap: () -> Unit) {
+        dismiss(animate = false)
+        val ctx = card.context
+        val d = ctx.resources.displayMetrics.density
+        card.asBubble()
+        card.contentDescription = "Notification bubble: ${card.contentDescription}"
+        val frame = object : FrameLayout(ctx) {
+            private var downY = 0f
+            private var downX = 0f
+            private var dragging = false
+            private val slop = ViewConfiguration.get(ctx).scaledTouchSlop
+
+            override fun dispatchTouchEvent(e: MotionEvent): Boolean {
+                when (e.actionMasked) {
+                    MotionEvent.ACTION_DOWN -> {
+                        downY = e.rawY; downX = e.rawX; dragging = false
+                        main.removeCallbacks(hide)
+                    }
+                    MotionEvent.ACTION_MOVE -> {
+                        val dy = e.rawY - downY
+                        if (!dragging && (abs(dy) > slop || abs(e.rawX - downX) > slop)) dragging = true
+                        if (dragging) card.translationY = dy.coerceAtMost(0f)
+                    }
+                    MotionEvent.ACTION_UP -> {
+                        if (!dragging) {
+                            dismiss(animate = false)
+                            onTap()
+                        } else if (card.translationY < -card.height / 3f) {
+                            dismiss(animate = true)
+                        } else {
+                            card.animate().translationY(0f).setDuration(150).start()
+                            main.postDelayed(hide, SHOW_MS)
+                        }
+                    }
+                    MotionEvent.ACTION_CANCEL -> {
+                        card.animate().translationY(0f).setDuration(150).start()
+                        main.postDelayed(hide, SHOW_MS)
+                    }
+                }
+                return true
+            }
+        }
+        val pad = (12 * d).toInt()
+        frame.setPadding(pad, (6 * d).toInt(), pad, (12 * d).toInt())
+        frame.clipToPadding = false
+        frame.addView(card, FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT,
+            FrameLayout.LayoutParams.WRAP_CONTENT))
+        val lp = WindowManager.LayoutParams(
+            WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.WRAP_CONTENT,
+            WindowManager.LayoutParams.TYPE_STATUS_BAR_SUB_PANEL,
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT).apply {
+            gravity = Gravity.TOP
+            y = statusBarHeight(ctx)
+            title = "EtesianBubble"
+            layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+            setFitInsetsTypes(0)
+        }
+        val manager = ctx.getSystemService(WindowManager::class.java)
+        runCatching { manager.addView(frame, lp) }.onFailure { return }
+        window = frame; wm = manager
+        frame.accessibilityPaneTitle = label
+        card.alpha = 0f
+        card.translationY = -40 * d
+        card.animate().alpha(1f).translationY(0f).setDuration(200).start()
+        main.postDelayed(hide, SHOW_MS)
+    }
+
+    /** Hides the bubble (if any), sliding it up when [animate]. */
+    @JvmStatic
+    fun dismiss(animate: Boolean) {
+        main.removeCallbacks(hide)
+        val w = window ?: return
+        val m = wm
+        window = null; wm = null
+        val card = if (w.childCount > 0) w.getChildAt(0) else null
+        if (animate && card != null) {
+            card.animate().translationY(-card.height.toFloat() - card.top).alpha(0f).setDuration(180)
+                .withEndAction { runCatching { m?.removeView(w) } }.start()
+        } else {
+            runCatching { m?.removeView(w) }
+        }
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/EtesianLockCard.kt b/packages/SystemUI/src/com/android/systemui/statusbar/notification/row/EtesianLockCard.kt
