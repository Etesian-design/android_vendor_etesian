+
+    /**
+     * The user's own buttons for the app in front (its set, else the default set), set up in
+     * the launcher's Toolbar buttons screen; the launcher runs them when tapped.
+     */
+    private List<View> configButtons(String config) {
+        final List<View> out = new ArrayList<>();
+        try {
+            final org.json.JSONObject root = new org.json.JSONObject(config);
+            final String pkg = mTopComponent != null
+                    ? ComponentName.unflattenFromString(mTopComponent).getPackageName() : null;
+            final org.json.JSONObject apps = root.optJSONObject("apps");
+            org.json.JSONArray set = pkg != null && apps != null ? apps.optJSONArray(pkg) : null;
+            if (set == null) set = root.optJSONArray("default");
+            if (set == null) return out;
+            for (int i = 0; i < set.length(); i++) {
+                final org.json.JSONObject b = set.getJSONObject(i);
+                final ImageView icon = new ImageView(getContext());
+                final byte[] png = android.util.Base64.decode(b.optString("icon"),
+                        android.util.Base64.DEFAULT);
+                icon.setImageBitmap(android.graphics.BitmapFactory.decodeByteArray(png, 0,
+                        png.length));
+                final boolean tint = b.optBoolean("tint", true);
+                if (tint) icon.setImageTintList(ColorStateList.valueOf(mTheme.icon));
+                icon.setScaleType(ImageView.ScaleType.FIT_CENTER);
+                final FrameLayout cell = new FrameLayout(getContext());
+                final int size = tint ? dp(30) : dp(36);
+                // Only the squircle reacts, not the whole slot.
+                final FrameLayout target = new FrameLayout(getContext());
+                cell.addView(target, new FrameLayout.LayoutParams(mButtonSize, mButtonSize, Gravity.CENTER));
+                final android.graphics.drawable.StateListDrawable press = new android.graphics.drawable.StateListDrawable();
+                press.addState(new int[] {android.R.attr.state_pressed},
+                        new SquircleDrawable(new int[] {mTheme.selected, mTheme.selected}, 0, 0, mButtonSize));
+                target.setBackground(press);
+                target.addView(icon, new FrameLayout.LayoutParams(size, size, Gravity.CENTER));
+                target.setContentDescription(b.optString("label"));
+                final String action = b.optJSONObject("action") != null
+                        ? b.optJSONObject("action").toString() : "{}";
+                target.setOnClickListener(v -> {
+                    v.performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+                    getContext().sendBroadcastAsUser(
+                            new Intent("com.bompotis.etesian.launcher.TOOLBAR_RUN")
+                                    .setPackage("com.bompotis.etesian.launcher")
+                                    .putExtra("action", action),
+                            UserHandle.CURRENT);
+                    used();
+                });
+                cell.setLayoutParams(mVertical
+                        ? new LayoutParams(LayoutParams.MATCH_PARENT, dp(64))
+                        : new LayoutParams(dp(64), LayoutParams.MATCH_PARENT));
+                out.add(cell);
+            }
+        } catch (org.json.JSONException | RuntimeException e) {
+            Log.w(TAG, "Bad toolbar config", e);
+        }
+        return out;
+    }
+
+    /** The user's shortcut buttons, from Settings. */
+    private List<View> customButtons() {
+        final String config = Settings.Secure.getStringForUser(getContext().getContentResolver(),
+                SETTING_CONFIG, UserHandle.USER_CURRENT);
+        if (!TextUtils.isEmpty(config)) return configButtons(config);
+        final List<View> out = new ArrayList<>();
+        String list = Settings.Secure.getStringForUser(getContext().getContentResolver(),
+                SETTING_BUTTONS, UserHandle.USER_CURRENT);
+        if (TextUtils.isEmpty(list)) return out;
+        PackageManager pm = getContext().getPackageManager();
+        for (String raw : list.split(",")) {
+            final String entry = raw.trim();
+            if (entry.isEmpty()) continue;
+            final Intent intent = intentFor(entry);
+            if (intent == null) continue;
+            Drawable icon = null;
+            try {
+                icon = intent.getComponent() != null
+                        ? pm.getActivityIcon(intent.getComponent())
+                        : pm.getApplicationIcon("com.android.settings");
+            } catch (PackageManager.NameNotFoundException e) {
+                Log.w(TAG, "No icon for " + entry);
+                if (intent.getComponent() != null) continue; // app uninstalled
+            }
+            ImageView b = makeButton(icon);
+            b.setPadding(dp(8), dp(8), dp(8), dp(8));
+            b.setContentDescription(entry);
+            b.setOnClickListener(v -> {
+                v.performHapticFeedback(HapticFeedbackConstants.VIRTUAL_KEY);
+                try {
+                    getContext().startActivityAsUser(intent, UserHandle.CURRENT);
+                } catch (ActivityNotFoundException | SecurityException e) {
+                    Log.w(TAG, "Cannot launch " + entry, e);
+                }
+                used();
+            });
+            final LayoutParams lp = new LayoutParams(mButtonSize, mButtonSize);
+            if (mVertical) {
+                lp.topMargin = dp(8);
+                lp.gravity = Gravity.CENTER_HORIZONTAL;
+            } else {
+                lp.leftMargin = dp(8);
+            }
+            b.setLayoutParams(lp);
+            out.add(b);
+        }
+        return out;
+    }
+
+    /** "pkg/cls" -> component; "settings:ACTION" -> action intent. */
+    static Intent intentFor(String entry) {
+        Intent i;
+        if (entry.startsWith("settings:")) {
+            i = new Intent(entry.substring("settings:".length()));
+        } else {
+            ComponentName cn = ComponentName.unflattenFromString(entry);
+            if (cn == null) return null;
+            i = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
+                    .setComponent(cn);
+        }
+        i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED);
+        return i;
+    }
+
+
+    private ImageView makeButton(Drawable content) {
+        ImageView b = new ImageView(getContext());
+        b.setBackground(new SquircleDrawable(new int[] {mTheme.buttonTop, mTheme.buttonBottom},
+                Math.max(1, dp(1)), mTheme.stroke, 0));
+        b.setScaleType(ImageView.ScaleType.FIT_CENTER);
+        b.setImageDrawable(content);
+        b.setClickable(true);
+        return b;
+    }
+
+    private long mBackDownTime;
+    private boolean mUnpinned;
+
+    /** Android extras → App pinning (mock 10): an app is pinned (screen pinning). */
+    private boolean pinned() {
+        try {
+            return getContext().getSystemService(android.app.ActivityManager.class).getLockTaskModeState()
+                    == android.app.ActivityManager.LOCK_TASK_MODE_PINNED;
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    /** Long-press Back unpins; with "ask for the code" on, the system locks the phone on exit. */
+    private final Runnable mUnpin = () -> {
+        if (!pinned()) return;
+        mUnpinned = true;
+        performHapticFeedback(HapticFeedbackConstants.LONG_PRESS);
+        try {
+            android.app.ActivityTaskManager.getService().stopSystemLockTaskMode();
+        } catch (Exception e) {
+            android.util.Log.w("EtesianBottomBar", "unpin", e);
+        }
+    };
+
+    private void sendBack(int action, int flags) {
+        long now = SystemClock.uptimeMillis();
+        KeyEvent ev = new KeyEvent(mBackDownTime, now, action, KeyEvent.KEYCODE_BACK, 0, 0,
+                KeyCharacterMap.VIRTUAL_KEYBOARD, 0,
+                flags | KeyEvent.FLAG_FROM_SYSTEM | KeyEvent.FLAG_VIRTUAL_HARD_KEY,
+                InputDevice.SOURCE_KEYBOARD);
+        Display d = getDisplay();
+        if (d != null) ev.setDisplayId(d.getDisplayId());
+        InputManagerGlobal.getInstance().injectInputEvent(ev,
+                InputManager.INJECT_INPUT_EVENT_MODE_ASYNC);
+    }
+
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        final int line = Math.max(1, dp(1));
+        if (mVertical) {
+            // The strip: the same colours, running across it.
+            mFillPaint.setShader(new LinearGradient(0, 0, getWidth(), 0, mTheme.top,
+                    mTheme.bottom, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, getWidth(), getHeight(), mFillPaint);
+            mFillPaint.setShader(null);
+            super.onDraw(canvas);
+            return;
+        }
+        // The bar: a vertical gradient, a dark edge over a light line at the top.
+        mFillPaint.setShader(new LinearGradient(0, 0, 0, getHeight(), mTheme.top, mTheme.bottom,
+                Shader.TileMode.CLAMP));
+        canvas.drawRect(0, 0, getWidth(), getHeight(), mFillPaint);
+        mFillPaint.setShader(null);
+        mFillPaint.setColor(mTheme.edge);
+        canvas.drawRect(0, 0, getWidth(), line, mFillPaint);
+        mFillPaint.setColor(mTheme.highlight);
+        canvas.drawRect(0, line, getWidth(), 2 * line, mFillPaint);
+        super.onDraw(canvas);
+    }
+
+    /** Left arrow, drawn centred in the button. */
+    private static class ArrowDrawable extends Drawable {
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path mPath = new Path();
+
+        ArrowDrawable(int color) {
+            mPaint.setColor(color);
+            mPaint.setStyle(Paint.Style.FILL);
+        }
+
+        @Override
+        public void draw(Canvas c) {
+            float w = getBounds().width(), h = getBounds().height();
+            float l = getBounds().left, t = getBounds().top;
+            float s = Math.min(w, h);
+            float cx = l + w / 2f, cy = t + h / 2f;
+            float half = s * 0.22f;
+            mPath.reset();
+            // Arrow head
+            mPath.moveTo(cx - half, cy);
+            mPath.lineTo(cx - half * 0.1f, cy - half * 0.8f);
+            mPath.lineTo(cx - half * 0.1f, cy - half * 0.3f);
+            // Shaft
+            mPath.lineTo(cx + half, cy - half * 0.3f);
+            mPath.lineTo(cx + half, cy + half * 0.3f);
+            mPath.lineTo(cx - half * 0.1f, cy + half * 0.3f);
+            mPath.lineTo(cx - half * 0.1f, cy + half * 0.8f);
+            mPath.close();
+            c.drawPath(mPath, mPaint);
+        }
+
+        @Override public void setAlpha(int alpha) { mPaint.setAlpha(alpha); }
+        @Override public void setColorFilter(ColorFilter cf) { mPaint.setColorFilter(cf); }
+        @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+    }
+
+    /**
+     * A button or highlight in the N9 squircle (superellipse, n = 2.8, measured from its icons),
+     * never a rounded rectangle. [size] > 0 centres a square of that size; 0 fills the bounds.
+     */
+    private static final class SquircleDrawable extends Drawable {
+        private static final double N = 2.8;
+        private final int[] mColors;
+        private final int mStrokeWidth;
+        private final int mSize;
+        private final Paint mFill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint mStroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path mPath = new Path();
+
+        SquircleDrawable(int[] colors, int strokeWidth, int strokeColor, int size) {
+            mColors = colors;
+            mStrokeWidth = strokeWidth;
+            mSize = size;
+            mStroke.setStyle(Paint.Style.STROKE);
+            mStroke.setStrokeWidth(strokeWidth);
+            mStroke.setColor(strokeColor);
+        }
+
+        @Override
+        protected void onBoundsChange(android.graphics.Rect b) {
+            float w = mSize > 0 ? Math.min(mSize, Math.min(b.width(), b.height())) : b.width();
+            float h = mSize > 0 ? w : b.height();
+            float inset = mStrokeWidth / 2f;
+            float rx = w / 2f - inset, ry = h / 2f - inset;
+            float cx = b.exactCenterX(), cy = b.exactCenterY();
+            mPath.reset();
+            final int steps = 64;
+            for (int i = 0; i <= steps; i++) {
+                double t = 2 * Math.PI * i / steps, c = Math.cos(t), s = Math.sin(t);
+                float x = cx + rx * (float) (Math.signum(c) * Math.pow(Math.abs(c), 2 / N));
+                float y = cy + ry * (float) (Math.signum(s) * Math.pow(Math.abs(s), 2 / N));
+                if (i == 0) mPath.moveTo(x, y); else mPath.lineTo(x, y);
+            }
+            mPath.close();
+            mFill.setShader(new LinearGradient(0, cy - ry, 0, cy + ry, mColors[0], mColors[1],
+                    Shader.TileMode.CLAMP));
+        }
+
+        @Override
+        public void draw(Canvas canvas) {
+            canvas.drawPath(mPath, mFill);
+            if (mStrokeWidth > 0) canvas.drawPath(mPath, mStroke);
+        }
+
+        @Override public void setAlpha(int alpha) { mFill.setAlpha(alpha); mStroke.setAlpha(alpha); }
+        @Override public void setColorFilter(ColorFilter cf) { mFill.setColorFilter(cf); }
+        @Override public int getOpacity() { return PixelFormat.TRANSLUCENT; }
+    }
+}
