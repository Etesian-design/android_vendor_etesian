--- /dev/null
+++ b/packages/SystemUI/src/com/android/keyguard/EtesianBouncer.java
@@ -0,0 +1,112 @@
+/*
+ * Etesian (Nokia N9) security screen styling. Only applied while Settings.Secure
+ * "etesian_gestures" is 1; otherwise the stock bouncer is untouched.
+ */
+package com.android.keyguard;
+
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.android.systemui.res.R;
+
+/** N9 look for the PIN, password and pattern bouncers. */
+public final class EtesianBouncer {
+
+    public static final String SETTING = "etesian_gestures";
+
+    public static final int BACKGROUND = Color.BLACK;
+    public static final int KEY = 0xFF2A2A2A;
+    public static final int KEY_PRESSED = 0xFF4A4A4A;
+    public static final int DELETE = 0xFF3A3A3A;
+    public static final int DELETE_PRESSED = 0xFF5A5A5A;
+    public static final int DONE = 0xFF62AE2E;
+    public static final int DONE_PRESSED = 0xFF7BC548;
+    public static final int ENTRY_BOX = 0xFF1C1C1C;
+    /** Key corner radius as a fraction of the key's shorter side (N9 squircle). */
+    public static final float KEY_RADIUS = 0.28f;
+
+    private static final String TITLE_TAG = "etesian_bouncer_title";
+
+    private EtesianBouncer() {}
+
+    public static boolean isEnabled(Context context) {
+        return Settings.Secure.getIntForUser(context.getContentResolver(), SETTING, 0,
+                UserHandle.USER_CURRENT) == 1;
+    }
+
+    /** A squircle key background; its radius is set from the size in {@link #layoutKey}. */
+    public static GradientDrawable keyBackground(int color, int pressed) {
+        GradientDrawable d = new GradientDrawable();
+        d.setShape(GradientDrawable.RECTANGLE);
+        d.setColor(new ColorStateList(
+                new int[][] {new int[] {android.R.attr.state_pressed}, new int[] {}},
+                new int[] {pressed, color}));
+        return d;
+    }
+
+    /** Keeps the key's corners at 28% of its shorter side. */
+    public static void layoutKey(View key, boolean pill) {
+        if (key.getBackground() instanceof GradientDrawable) {
+            float side = Math.min(key.getWidth(), key.getHeight());
+            ((GradientDrawable) key.getBackground()).setCornerRadius(
+                    pill ? side / 2f : side * KEY_RADIUS);
+        }
+    }
+
+    /** White light digits, 32sp. */
+    public static void styleDigit(TextView digit, TextView letters) {
+        digit.setTextColor(Color.WHITE);
+        digit.setTypeface(Typeface.create("sans-serif-light", Typeface.NORMAL));
+        digit.setTextSize(TypedValue.COMPLEX_UNIT_SP, 32);
+        if (letters != null) letters.setVisibility(View.GONE);
+    }
+
+    /** Dark rounded box behind the code entry. */
+    public static void styleEntry(View entry) {
+        GradientDrawable box = new GradientDrawable();
+        box.setColor(ENTRY_BOX);
+        box.setCornerRadius(dp(entry.getContext(), 14));
+        entry.setBackground(box);
+    }
+
+    /**
+     * Black page with the N9 title, "Enter security code", white light 28sp at the top left.
+     * Safe to call more than once.
+     */
+    public static void styleSecurityView(ViewGroup root) {
+        Context ctx = root.getContext();
+        root.setBackgroundColor(BACKGROUND);
+        if (root.findViewWithTag(TITLE_TAG) != null) return;
+        TextView title = new TextView(ctx);
+        title.setTag(TITLE_TAG);
+        title.setText(R.string.etesian_bouncer_title);
+        title.setTextColor(Color.WHITE);
+        title.setTypeface(Typeface.create("sans-serif-light", Typeface.NORMAL));
+        title.setTextSize(TypedValue.COMPLEX_UNIT_SP, 28);
+        title.setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
+        title.setTextAlignment(View.TEXT_ALIGNMENT_VIEW_START);
+        int pad = dp(ctx, 16);
+        title.setPadding(pad, dp(ctx, 24), pad, dp(ctx, 16));
+        ViewGroup.LayoutParams lp = root instanceof LinearLayout
+                ? new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT)
+                : new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                        ViewGroup.LayoutParams.WRAP_CONTENT);
+        root.addView(title, 0, lp);
+    }
+
+    public static int dp(Context ctx, float dp) {
+        return Math.round(dp * ctx.getResources().getDisplayMetrics().density);
+    }
+}
