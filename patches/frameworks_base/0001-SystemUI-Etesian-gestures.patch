+
+package com.android.systemui.globalactions;
+
+import android.content.Context;
+import android.graphics.drawable.GradientDrawable;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/**
+ * Etesian (N9): the power-key menu as stacked dark lit N9 buttons over a 90% black backdrop:
+ * Power off, Restart, Lock now, Emergency call. Tapping outside or Back closes it.
+ */
+public final class EtesianPowerMenu {
+    private final WindowManager mWm;
+    private final FrameLayout mRoot;
+    private final Runnable mOnHidden;
+    private boolean mShowing;
+
+    private EtesianPowerMenu(Context ctx, String[] labels, Runnable[] actions, Runnable onHidden) {
+        mOnHidden = onHidden;
+        // Not the dialog-themed context: its WindowManager turns the overlay into an attached dialog.
+        mWm = ctx.getApplicationContext().getSystemService(WindowManager.class);
+        float d = ctx.getResources().getDisplayMetrics().density;
+        LinearLayout col = new LinearLayout(ctx);
+        col.setOrientation(LinearLayout.VERTICAL);
+        col.setGravity(Gravity.CENTER_HORIZONTAL);
+        col.setContentDescription("Power menu");
+        for (int i = 0; i < labels.length; i++) {
+            final Runnable r = actions[i];
+            TextView b = new TextView(ctx);
+            b.setText(labels[i]);
+            b.setTextColor(0xFFFFFFFF);
+            b.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18);
+            b.setTypeface(android.graphics.Typeface.create("sans-serif", android.graphics.Typeface.BOLD));
+            b.setGravity(Gravity.CENTER);
+            int h = (int) (52 * d);
+            GradientDrawable bg = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                    new int[] {0xFF1C1C1C, 0xFF101010, 0xFF080808});
+            bg.setCornerRadius(0.21f * h);
+            bg.setStroke(Math.max(1, (int) d), 0xFF393839);
+            b.setBackground(bg);
+            b.setOnClickListener(v -> { dismiss(); r.run(); });
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams((int) (280 * d), h);
+            lp.topMargin = i == 0 ? 0 : (int) (14 * d);
+            col.addView(b, lp);
+        }
+        mRoot = new FrameLayout(ctx) {
+            @Override
+            public boolean dispatchKeyEvent(android.view.KeyEvent e) {
+                if (e.getKeyCode() == android.view.KeyEvent.KEYCODE_BACK) {
+                    if (e.getAction() == android.view.KeyEvent.ACTION_UP) dismiss();
+                    return true;
+                }
+                return super.dispatchKeyEvent(e);
+            }
+        };
+        mRoot.setBackgroundColor(0xE6000000);
+        mRoot.setFocusable(true);
+        mRoot.setFocusableInTouchMode(true);
+        mRoot.setOnClickListener(v -> dismiss());
+        mRoot.addView(col, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER));
+    }
+
+    /** Shows the menu; [actions] run on tap, [onHidden] when it goes away. */
+    public static EtesianPowerMenu show(Context ctx, String[] labels, Runnable[] actions, Runnable onHidden) {
+        EtesianPowerMenu m = new EtesianPowerMenu(ctx, labels, actions, onHidden);
+        WindowManager.LayoutParams a = new WindowManager.LayoutParams(
+                WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
+                WindowManager.LayoutParams.TYPE_VOLUME_OVERLAY,
+                WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM,
+                android.graphics.PixelFormat.TRANSLUCENT);
+        a.setTitle("EtesianPowerMenu");
+        a.layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS;
+        a.setFitInsetsTypes(0);
+        m.mWm.addView(m.mRoot, a);
+        m.mShowing = true;
+        m.mRoot.post(m.mRoot::requestFocus);
+        // Back also arrives through the window's back dispatcher (predictive back).
+        m.mRoot.post(() -> {
+            android.window.OnBackInvokedDispatcher bd = m.mRoot.findOnBackInvokedDispatcher();
+            if (bd != null) bd.registerOnBackInvokedCallback(
+                    android.window.OnBackInvokedDispatcher.PRIORITY_OVERLAY, m::dismiss);
+        });
+        return m;
+    }
+
+    public boolean isShowing() { return mShowing; }
+
+    public void dismiss() {
+        if (!mShowing) return;
+        mShowing = false;
+        try { mWm.removeView(mRoot); } catch (Exception ignored) { }
+        mOnHidden.run();
+    }
+}
