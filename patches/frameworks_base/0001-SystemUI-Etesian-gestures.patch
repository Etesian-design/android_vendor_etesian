diff --git a/packages/SystemUI/src/com/android/systemui/shade/EtesianKeyguardSwipe.kt b/packages/SystemUI/src/com/android/systemui/shade/EtesianKeyguardSwipe.kt
new file mode 100644
index 000000000000..f6d079a6f7d8
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/shade/EtesianKeyguardSwipe.kt
@@ -0,0 +1,577 @@
+/*
+ * Etesian (Nokia N9) unlock: the lock screen is swiped away sideways.
+ * Only active while Settings.Secure "etesian_gestures" is 1.
+ */
+package com.android.systemui.shade
+
+import android.animation.Animator
+import android.animation.AnimatorListenerAdapter
+import android.animation.ValueAnimator
+import android.graphics.Color
+import android.graphics.drawable.Drawable
+import android.os.UserHandle
+import android.provider.Settings
+import android.util.Log
+import android.view.MotionEvent
+import android.view.VelocityTracker
+import android.view.View
+import android.view.ViewConfiguration
+import android.view.ViewGroup
+import android.view.WindowManagerGlobal
+import android.view.animation.DecelerateInterpolator
+import com.android.systemui.statusbar.notification.stack.EtesianLockList
+import com.android.systemui.bouncer.domain.interactor.AlternateBouncerInteractor
+import com.android.systemui.bouncer.domain.interactor.PrimaryBouncerInteractor
+import com.android.systemui.keyguard.KeyguardUnlockAnimationController
+import com.android.systemui.plugins.statusbar.StatusBarStateController
+import com.android.systemui.res.R
+import com.android.systemui.shade.domain.interactor.PanelExpansionInteractor
+import com.android.systemui.statusbar.StatusBarState
+import com.android.systemui.statusbar.SysuiStatusBarStateController
+import kotlin.math.abs
+import kotlin.math.sign
+
+/**
+ * N9 swipe to unlock, run from [NotificationShadeWindowViewController]'s touch dispatch before any
+ * stock handler.
+ *
+ * A drag in any direction that starts anywhere on the lock screen moves the whole lock screen layer
+ * (wallpaper, clock, notifications; see [EtesianLockWallpaper]) with the finger along the drag's
+ * axis. Without a secure lock the phone in its last state (last app or launcher page) is revealed
+ * live underneath through the stock swipe-to-dismiss surface-behind machinery; with a PIN/password/
+ * pattern the layer slides off over black and the N9 security screen (restyled bouncer) appears.
+ * Released past 35% of the screen (or flung) it slides off and unlocks; otherwise it springs back.
+ * A horizontal drag that starts on a notification row is that row's swipe-to-open instead.
+ *
+ * Why the slide used to be inconsistent: the down was only taken when everything was already in
+ * the right state, a vertical drag was swallowed without moving anything, a drag starting on a
+ * notification row (in any direction) was left to the stock path (NSSL -> shade panel -> swipe up
+ * to bouncer), and moves below our slop were dispatched to the stock handlers (panel tracking,
+ * drag-down helper, status bar) which could claim the gesture first. Now every move before the
+ * decision is swallowed (the down still goes through, so taps and long presses work), and both
+ * axes slide the lock screen.
+ */
+class EtesianKeyguardSwipe(
+    private val root: ViewGroup,
+    private val statusBarState: SysuiStatusBarStateController,
+    private val primaryBouncer: PrimaryBouncerInteractor,
+    private val alternateBouncer: AlternateBouncerInteractor,
+    private val panelExpansion: PanelExpansionInteractor,
+    private val unlockAnimation: KeyguardUnlockAnimationController,
+) {
+    private val ctx = root.context
+    private val density = ctx.resources.displayMetrics.density
+    private val slop = ViewConfiguration.get(ctx).scaledTouchSlop * 0.8f
+    private val flingVelocity = 1000f * density
+
+    private var tracking = false
+    private var claimedHorizontal = false
+    private var claimedVertical = false
+    private var passthrough = false
+    /** The down landed on a notification row: a horizontal drag there is swipe-to-open. */
+    private var downOnRow = false
+    /** The down landed on the N9 overflow deck (shelf): sliding up there opens the full list. */
+    private var downShelf: com.android.systemui.statusbar.NotificationShelf? = null
+    private var downStack = false
+    /** Gesture already handled (deck opened); swallow the rest of it. */
+    private var swallowing = false
+    /** Up/down: opens, scrolls and closes the N9 notification list (never unlocks). */
+    private var listDrag = false
+    private var lastY = 0f
+    private var downX = 0f
+    private var downY = 0f
+    private var startOffset = 0f
+    private var velocity: VelocityTracker? = null
+    private var animator: ValueAnimator? = null
+
+    /** Axis of the current slide (also kept while animating after release). */
+    private var vertical = false
+
+    /** The app/launcher behind is being revealed live (no secure lock). */
+    private var revealing = false
+
+    /** Swiped away; waiting for the keyguard to go (or the security screen to be dismissed). */
+    private var committed = false
+    private var committedAt = 0L
+    private var sawBouncer = false
+    private var goneChecks = 0
+
+    private var originalBackground: Drawable? = null
+    private val veil = Backdrop()
+    private var veilInstalled = false
+    private val bg = java.util.concurrent.Executors.newSingleThreadExecutor()
+
+    /**
+     * Behind the sliding lock screen: black while nothing is behind it yet (secure lock, or the
+     * app surface not there yet); transparent once the app/launcher surface is on screen.
+     */
+    private inner class Backdrop : Drawable() {
+        var blackAlpha = 255
+            set(value) { if (field != value) { field = value; invalidateSelf() } }
+
+        override fun draw(canvas: android.graphics.Canvas) {
+            if (blackAlpha > 0) canvas.drawColor(Color.argb(blackAlpha, 0, 0, 0))
+        }
+
+        override fun setAlpha(alpha: Int) {}
+        override fun setColorFilter(colorFilter: android.graphics.ColorFilter?) {}
+        @Deprecated("Deprecated in Java")
+        override fun getOpacity() = android.graphics.PixelFormat.TRANSLUCENT
+    }
+
+    init {
+        // The app/launcher surface is on screen: fade our black away so it shows.
+        unlockAnimation.addKeyguardUnlockAnimationListener(
+            object : KeyguardUnlockAnimationController.KeyguardUnlockAnimationListener {
+                override fun onUnlockAnimationStarted(
+                    playingCannedAnimation: Boolean,
+                    isWakeAndUnlockNotFromDream: Boolean,
+                    unlockAnimationStartDelay: Long,
+                    unlockAnimationDuration: Long,
+                ) {
+                    if (committed || revealing) revealBehind()
+                }
+            })
+        statusBarState.addCallback(object : StatusBarStateController.StateListener {
+            override fun onStateChanged(newState: Int) {
+                EtesianLockList.reset()
+                if (newState == StatusBarState.KEYGUARD) {
+                    resetNow()
+                    if (n9Mode()) EtesianLockWallpaper.preload(root)
+                } else if (committed || offset() != 0f || veilInstalled) {
+                    // Unlocked: leave things as they are until the window is gone, then tidy up.
+                    root.postDelayed({
+                        if (statusBarState.state != StatusBarState.KEYGUARD) resetNow()
+                    }, 600)
+                }
+            }
+
+            override fun onDozingChanged(isDozing: Boolean) {
+                if (isDozing) {
+                    resetNow()
+                    EtesianLockList.reset()
+                    if (statusBarState.state == StatusBarState.KEYGUARD) EtesianLockList.collapseOpened()
+                }
+            }
+        })
+    }
+
+    private fun n9Mode() = Settings.Secure.getIntForUser(ctx.contentResolver,
+        "etesian_gestures", 0, UserHandle.USER_CURRENT) == 1
+
+    private fun keyguardRoot(): View? = root.findViewById(R.id.keyguard_root_view)
+
+    /**
+     * The lock screen layer that slides, as one surface: wallpaper/clock/indications,
+     * notifications and the lock screen's own status bar (N9: it has no clock, and it leaves
+     * with the lock screen; home's status bar is under it).
+     */
+    private fun movingViews(): List<View> = listOfNotNull(
+        keyguardRoot(),
+        root.findViewById<View>(R.id.shared_notification_container),
+        root.findViewById<View>(R.id.keyguard_header),
+    )
+
+    private fun offset(): Float {
+        val v = movingViews().firstOrNull() ?: return 0f
+        return if (vertical) v.translationY else v.translationX
+    }
+
+    private fun extent() = (if (vertical) root.height else root.width).toFloat().coerceAtLeast(1f)
+
+    /**
+     * Returns null to let the touch be dispatched normally, or the dispatch result when the
+     * gesture is ours.
+     */
+    fun onTouch(ev: MotionEvent): Boolean? {
+        if (passthrough) return null
+        when (ev.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                endTracking()
+                if (!n9Mode() || committed || statusBarState.state != StatusBarState.KEYGUARD ||
+                    bouncerShowing()) {
+                    return null
+                }
+                animator?.cancel()
+                tracking = true
+                downOnRow = isOnNotification(ev)
+                downShelf = shelfAt(ev)
+                downStack = !EtesianLockList.moreLabel && EtesianLockList.hasMore &&
+                    ev.rawY >= EtesianLockList.stackTopOnScreen + EtesianLockList.stripsTop
+                downX = ev.rawX
+                downY = ev.rawY
+                velocity = VelocityTracker.obtain().also { it.addMovement(ev) }
+                // The down itself goes through, so taps and long presses keep working.
+                return null
+            }
+            MotionEvent.ACTION_MOVE -> {
+                if (!tracking) return null
+                if (swallowing) return true
+                if (listDrag) {
+                    velocity?.addMovement(ev)
+                    dragList(ev)
+                    return true
+                }
+                velocity?.addMovement(ev)
+                val dx = ev.rawX - downX
+                val dy = ev.rawY - downY
+                if (!claimedHorizontal && !claimedVertical) {
+                    val horizontal = abs(dx) > slop && abs(dx) >= abs(dy)
+                    val vert = !horizontal && abs(dy) > slop
+                    if (!horizontal && !vert) {
+                        // Not decided yet. Keep the moves away from the stock handlers (panel
+                        // swipe up to bouncer, drag down, status bar) so they can't take the
+                        // gesture first; a row still needs them for its swipe-to-open.
+                        return if (downOnRow) null else true
+                    }
+                    if (horizontal && downOnRow) {
+                        // N9 swipe-to-open on the notification (NotificationSwipeHelper).
+                        endTracking()
+                        return null
+                    }
+                    if (!canStart()) {
+                        endTracking()
+                        return null
+                    }
+                    if (vert) {
+                        // N9: up and down only move the notifications; unlocking is sideways.
+                        cancelChildren(ev)
+                        listDrag = true
+                        lastY = ev.rawY
+                        if (EtesianLockList.moreLabel && dy < 0 && !EtesianLockList.expanded &&
+                            EtesianLockList.hasMore) {
+                            EtesianLockList.expand(keyguardRoot())
+                        }
+                        return true
+                    }
+                    claimedHorizontal = horizontal
+                    claimedVertical = vert
+                    cancelChildren(ev)
+                    beginSlide(vert)
+                }
+                apply(startOffset + if (claimedVertical) dy else dx)
+                return true
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                if (!tracking) return null
+                if (listDrag && !EtesianLockList.moreLabel) {
+                    // The carousel coasts on after the finger.
+                    velocity?.addMovement(ev)
+                    velocity?.computeCurrentVelocity(1000)
+                    EtesianLockList.fling(-(velocity?.yVelocity ?: 0f), keyguardRoot())
+                }
+                if (swallowing || listDrag) {
+                    endTracking()
+                    return true
+                }
+                if (!claimedHorizontal && !claimedVertical && (downShelf != null || downStack) &&
+                    ev.actionMasked == MotionEvent.ACTION_UP && EtesianLockList.hasMore) {
+                    // A tap on the peeking cards opens the list too (not the stock shade).
+                    cancelChildren(ev)
+                    endTracking()
+                    if (EtesianLockList.moreLabel) {
+                        EtesianLockList.expand(keyguardRoot())
+                    } else {
+                        // A tap on the stack brings the next cards up.
+                        EtesianLockList.fling(3000f, keyguardRoot())
+                    }
+                    return true
+                }
+                val claimed = claimedHorizontal || claimedVertical
+                if (claimed) {
+                    velocity?.addMovement(ev)
+                    velocity?.computeCurrentVelocity(1000)
+                    val v = (if (claimedVertical) velocity?.yVelocity else velocity?.xVelocity)
+                        ?: 0f
+                    val d = if (claimedVertical) ev.rawY - downY else ev.rawX - downX
+                    release(startOffset + d, v, ev.actionMasked == MotionEvent.ACTION_CANCEL)
+                }
+                endTracking()
+                return if (claimed) true else null
+            }
+            else -> return if (claimedHorizontal || claimedVertical || swallowing) true else null
+        }
+    }
+
+    private fun bouncerShowing() =
+        primaryBouncer.isBouncerShowing() || alternateBouncer.isVisibleState()
+
+    private fun isOnNotification(ev: MotionEvent): Boolean {
+        val nssl = root.findViewById<View>(R.id.notification_stack_scroller)
+            as? com.android.systemui.statusbar.notification.stack.NotificationStackScrollLayout
+            ?: return false
+        return nssl.isShown && nssl.getChildAtRawPosition(ev.rawX, ev.rawY) is
+            com.android.systemui.statusbar.notification.row.ExpandableNotificationRow
+    }
+
+    private fun shelfAt(ev: MotionEvent): com.android.systemui.statusbar.NotificationShelf? {
+        val nssl = root.findViewById<ViewGroup>(R.id.notification_stack_scroller) ?: return null
+        if (!nssl.isShown) return null
+        for (i in 0 until nssl.childCount) {
+            val shelf = nssl.getChildAt(i) as? com.android.systemui.statusbar.NotificationShelf
+                ?: continue
+            if (!shelf.isEtesianStack || !shelf.isClickable) return null
+            val loc = IntArray(2)
+            shelf.getLocationOnScreen(loc)
+            // The peeking cards (up to three 40dp strips) sit just above it and count too; the
+            // N9's "More" label is the shelf itself.
+            val extra = (if (EtesianLockList.moreLabel) 8 else 140) * density
+            val inside = ev.rawX >= loc[0] && ev.rawX <= loc[0] + shelf.width &&
+                ev.rawY >= loc[1] - extra && ev.rawY <= loc[1] + shelf.actualHeight
+            return if (inside) shelf else null
+        }
+        return null
+    }
+
+    /** Checked when the drag is recognised (not at the down, which can race screen-on). */
+    private fun canStart(): Boolean =
+        n9Mode() &&
+            !committed &&
+            statusBarState.state == StatusBarState.KEYGUARD &&
+            !statusBarState.isDozing &&
+            !bouncerShowing()
+
+    /** The children already saw the down (taps still work); now they lose the gesture. */
+    private fun cancelChildren(ev: MotionEvent) {
+        val cancel = MotionEvent.obtain(ev).apply { action = MotionEvent.ACTION_CANCEL }
+        passthrough = true
+        try {
+            root.dispatchTouchEvent(cancel)
+        } finally {
+            passthrough = false
+            cancel.recycle()
+        }
+    }
+
+    private fun dragList(ev: MotionEvent) {
+        val step = lastY - ev.rawY
+        lastY = ev.rawY
+        if (!EtesianLockList.moreLabel) {
+            EtesianLockList.scrollBy(step, keyguardRoot())
+            return
+        }
+        if (!EtesianLockList.expanded) {
+            if (ev.rawY - downY < -slop * 2 && EtesianLockList.hasMore) {
+                EtesianLockList.expand(keyguardRoot())
+            }
+            return
+        }
+        if (!EtesianLockList.scrollBy(step) && step < 0 && EtesianLockList.scroll == 0f &&
+            ev.rawY - downY > CLOSE_PULL * density) {
+            // Pulled down at the top of the list: back to the lock screen.
+            EtesianLockList.collapse()
+            swallowing = true
+        }
+    }
+
+    private fun endTracking() {
+        listDrag = false
+        tracking = false
+        claimedHorizontal = false
+        claimedVertical = false
+        downOnRow = false
+        downShelf = null
+        downStack = false
+        swallowing = false
+        velocity?.recycle()
+        velocity = null
+    }
+
+    /** A new slide along one axis; a running spring-back on the other axis is finished first. */
+    private fun beginSlide(vert: Boolean) {
+        if (vert != vertical) {
+            movingViews().forEach { it.translationX = 0f; it.translationY = 0f }
+        }
+        vertical = vert
+        startOffset = offset()
+        if (!revealing && unlockAnimation.etesianCanRevealSurfaceBehind()) {
+            // Ask for the app/launcher surface now (stock swipe threshold), so it's there while
+            // the lock screen follows the finger.
+            revealing = true
+            EtesianLockWallpaper.holdLockscreenOpaque = true
+            unlockAnimation.etesianSetDismissAmount(REVEAL_START, true)
+        }
+    }
+
+    private fun apply(d: Float) {
+        movingViews().forEach {
+            if (vertical) it.translationY = d else it.translationX = d
+        }
+        setVeil(d)
+        // Home's surface is on screen behind the lock screen: let it show (checked every frame;
+        // the start callback can arrive before the backdrop is installed).
+        if (revealing && veilInstalled && veil.blackAlpha == 255 &&
+            unlockAnimation.isAnimatingBetweenKeyguardAndSurfaceBehind()) revealBehind()
+        if (revealing && !committed) {
+            // Grow the surface behind with the drag, staying below the stock exit threshold
+            // (0.3) so the keyguard only goes on release.
+            val p = (abs(d) / (extent() * COMMIT_FRACTION)).coerceIn(0f, 1f)
+            unlockAnimation.etesianSetDismissAmount(REVEAL_START + REVEAL_RANGE * p, true)
+        }
+        // Home comes out of the dark with the slide, exactly as behind an application being
+        // swiped away; it reaches full size and brightness as the lock screen leaves the screen.
+        if (revealing) unlockAnimation.etesianSetLauncherUnlockAmount((abs(d) / extent()).coerceIn(0f, 1f))
+    }
+
+    /** The backdrop and the moving wallpaper; removed again at offset 0. */
+    private fun setVeil(d: Float) {
+        if (d != 0f && !veilInstalled) {
+            originalBackground = root.background
+            veil.blackAlpha =
+                if (revealing && unlockAnimation.isAnimatingBetweenKeyguardAndSurfaceBehind()) 0
+                else 255
+            root.background = veil
+            keyguardRoot()?.let { EtesianLockWallpaper.install(it) }
+            veilInstalled = true
+        }
+        if (d == 0f && veilInstalled) {
+            root.background = originalBackground
+            originalBackground = null
+            keyguardRoot()?.let { EtesianLockWallpaper.remove(it) }
+            veilInstalled = false
+        }
+    }
+
+    private fun release(d: Float, v: Float, cancelled: Boolean) {
+        val size = extent()
+        val fling = abs(v) > flingVelocity && (d == 0f || sign(v) == sign(d))
+        val againstFling = abs(v) > flingVelocity && d != 0f && sign(v) != sign(d)
+        if (!cancelled && !againstFling && (abs(d) > size * COMMIT_FRACTION || fling)) {
+            val direction = if (d != 0f) sign(d) else sign(v)
+            // Unlock right away; the lock screen finishes sliding off while the phone comes up.
+            commit()
+            animateTo(direction * size, if (fling) 160L else 220L) {}
+        } else {
+            springBack()
+        }
+    }
+
+    /** Something is on screen behind the lock screen: let it show through. */
+    private fun revealBehind() {
+        if (!veilInstalled || veil.blackAlpha == 0) return
+        ValueAnimator.ofInt(veil.blackAlpha, 0).apply {
+            duration = 120L
+            addUpdateListener { veil.blackAlpha = it.animatedValue as Int }
+            start()
+        }
+    }
+
+    private fun springBack() {
+        animateTo(0f, 260L) { stopRevealing() }
+    }
+
+    /** Back in place: hide the app surface again (stock swipe cancel path). */
+    private fun stopRevealing() {
+        if (!revealing || committed) return
+        revealing = false
+        EtesianLockWallpaper.holdLockscreenOpaque = false
+        unlockAnimation.etesianSetDismissAmount(0f, false)
+    }
+
+    private fun animateTo(target: Float, duration: Long, end: () -> Unit) {
+        animator?.cancel()
+        val from = offset()
+        animator = ValueAnimator.ofFloat(from, target).apply {
+            this.duration = duration
+            interpolator = DecelerateInterpolator(1.5f)
+            addUpdateListener { apply(it.animatedValue as Float) }
+            addListener(object : AnimatorListenerAdapter() {
+                private var wasCancelled = false
+                override fun onAnimationCancel(animation: Animator) { wasCancelled = true }
+                override fun onAnimationEnd(animation: Animator) {
+                    if (animator === animation) animator = null
+                    if (!wasCancelled) end()
+                }
+            })
+            start()
+        }
+    }
+
+    /** Lock screen is gone: dismiss the keyguard, back to the phone as it was left. */
+    private fun commit() {
+        committed = true
+        committedAt = android.os.SystemClock.uptimeMillis()
+        sawBouncer = false
+        goneChecks = 0
+        if (revealing) {
+            // Stock swipe-to-dismiss end: the surface behind animates in and the keyguard exits.
+            unlockAnimation.etesianSetDismissAmount(1f, true)
+            revealBehind()
+            // If the surface-behind path didn't take (e.g. state changed under us), fall back.
+            root.postDelayed({
+                if (committed && statusBarState.state == StatusBarState.KEYGUARD &&
+                    !unlockAnimation.isAnimatingBetweenKeyguardAndSurfaceBehind() &&
+                    !unlockAnimation.etesianSurfaceBehindRequested()) {
+                    dismissKeyguard()
+                }
+            }, 500)
+        } else {
+            dismissKeyguard()
+        }
+        root.postDelayed(watchdog, 300)
+    }
+
+    /** Unlocks when there's no secure lock; otherwise brings up the security screen. */
+    private fun dismissKeyguard() {
+        // Binder call off the UI thread, so the lock screen keeps sliding smoothly.
+        bg.execute {
+            runCatching { WindowManagerGlobal.getWindowManagerService()?.dismissKeyguard(null, null) }
+                .onFailure { Log.w(TAG, "dismissKeyguard", it) }
+        }
+    }
+
+    /**
+     * While committed: if the security screen was closed without unlocking (or nothing happened
+     * at all), the lock screen slides back in.
+     */
+    private val watchdog: Runnable = object : Runnable {
+        override fun run() {
+            if (!committed) return
+            if (statusBarState.state != StatusBarState.KEYGUARD ||
+                unlockAnimation.isAnimatingBetweenKeyguardAndSurfaceBehind()) {
+                return // unlocking; onStateChanged tidies up
+            }
+            val bouncer = bouncerShowing()
+            if (bouncer) { sawBouncer = true; goneChecks = 0 } else goneChecks++
+            val waited = android.os.SystemClock.uptimeMillis() - committedAt
+            // Two checks in a row without the security screen, so a successful code entry
+            // (bouncer hides just before the keyguard starts going away) doesn't bounce back.
+            if (!bouncer && goneChecks >= 2 && (sawBouncer || waited > 1500)) {
+                committed = false
+                veil.blackAlpha = 255
+                springBack()
+                return
+            }
+            root.postDelayed(this, 300)
+        }
+    }
+
+    private fun resetNow() {
+        root.removeCallbacks(watchdog)
+        animator?.cancel()
+        animator = null
+        committed = false
+        sawBouncer = false
+        endTracking()
+        movingViews().forEach { it.translationX = 0f; it.translationY = 0f }
+        setVeil(0f)
+        EtesianLockWallpaper.holdLockscreenOpaque = false
+        if (revealing) {
+            revealing = false
+            if (statusBarState.state == StatusBarState.KEYGUARD) {
+                unlockAnimation.etesianSetDismissAmount(0f, false)
+            }
+        }
+    }
+
+    private companion object {
+        const val TAG = "EtesianUnlock"
+        /** How far to pull down at the top of the open list to close it, in dp. */
+        const val CLOSE_PULL = 64f
+        const val COMMIT_FRACTION = 0.35f
+        /** Stock DISMISS_AMOUNT_SHOW_SURFACE_THRESHOLD: the surface behind is requested here. */
+        const val REVEAL_START = 0.15f
+        /** Up to just under DISMISS_AMOUNT_EXIT_KEYGUARD_THRESHOLD (0.3) while dragging. */
+        const val REVEAL_RANGE = 0.14f
+    }
+}
