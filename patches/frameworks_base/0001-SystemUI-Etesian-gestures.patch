+        // N9 style has no cards: the shelf below reads "More".
+        final int peeks = EtesianLockList.getMoreLabel() ? 0
+                : Math.min(ETESIAN_PEEKS, more.size());
+        final float strip = mEtesianPeekStrip;
+        final float step = strip + mPaddingBetweenElements;
+        final float shift = Math.max(0f,
+                areaBottom - mPaddingBetweenElements - (contentBottom + peeks * step));
+        for (ExpandableView v : shown) {
+            final ExpandableViewState st = v.getViewState();
+            st.setYTranslation(st.getYTranslation() + shift, "etesian bottom align");
+        }
+        final float lastBottom = contentBottom + shift;
+        for (int k = 0; k < peeks; k++) {
