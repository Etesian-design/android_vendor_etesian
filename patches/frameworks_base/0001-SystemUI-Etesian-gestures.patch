+
+    fun askToStop(ctx: Context) {
+        val d = com.android.systemui.statusbar.phone.SystemUIDialog(ctx)
+        d.setTitle(com.android.systemui.res.R.string.screenrecord_stop_dialog_title)
+        d.setPositiveButton(com.android.systemui.res.R.string.screenrecord_stop_dialog_button) { _, _ ->
