+    /**
+     * Etesian, stacked style: one list the finger scrolls like a carousel. At rest the newest
+     * notifications sit in full at the bottom with the rest stacked under them as strips; sliding
+     * up moves the list up, each card in the stack unfolding to full size as it rises, while the
+     * ones reaching the top shrink and fade under the status bar.
+     */
+    private void layoutCarouselForEtesian(AmbientState ambientState,
+            java.util.List<ExpandableView> shown, java.util.List<ExpandableView> more,
+            ExpandableViewState shelf, float areaBottom) {
+        final java.util.ArrayList<ExpandableView> all = new java.util.ArrayList<>(shown);
+        all.addAll(more);
+        final int n = all.size();
+        final float pad = mPaddingBetweenElements;
+        final float strip = mEtesianPeekStrip;
+        final float step = strip + pad;
+        final float bottom = areaBottom - pad;
+        final float top = mStatusBarHeight + pad - EtesianLockList.getStackTopOnScreen();
+        // At rest the full cards end where the stack (up to three strips) begins.
+        // (Accordion: no strips; the rest wait hidden behind the last full card.)
+        final float restLimit = bottom;
+        // Each card's place in the unscrolled list; everything moves up with the finger.
+        final float[] y = new float[n];
+        float cursor = restLimit + pad;
+        for (int i = shown.size() - 1; i >= 0; i--) {
+            cursor -= shown.get(i).getIntrinsicHeight() + pad;
+            y[i] = cursor;
+        }
+        cursor = restLimit + pad;
+        for (int i = shown.size(); i < n; i++) {
+            y[i] = cursor;
+            cursor += all.get(i).getIntrinsicHeight() + pad;
+        }
