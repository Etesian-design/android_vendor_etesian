+        // it, bottom-aligned at the stack's foot. As the list moves up, the waiting card's lower
+        // part is uncovered as the one in front leaves; once fully uncovered it is carried up too.
+        // At the top the reverse: a card reaching the clock block folds away under its edge, so
+        // the clock and date always stay visible and are never covered.
+        final float limit = Math.max(top, EtesianLockList.clockBottomInStack(mPaddingBetweenElements));
