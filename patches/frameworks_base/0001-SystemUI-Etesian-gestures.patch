@@ -0,0 +1,119 @@
+package com.android.systemui.keyguard.ui.view.layout.sections
+
+import android.content.Context
+import android.content.Intent
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.provider.Settings
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.TextUtils
+import android.text.style.ForegroundColorSpan
+import android.util.TypedValue
+import android.widget.LinearLayout
+import android.widget.TextView
+
+/**
+ * Etesian, Android extras → Emergency information on the lock screen (design A2): in the empty
+ * space left of the right-aligned clock, a red rule, "✚ owner", the facts the user chose and
+ * "Emergency info ›". Tap opens the launcher's full-screen emergency card over the lock screen.
+ * The data lives in Settings.Secure etesian_emergency_* (written by Etesian settings).
+ * Text in sp and spacing in dp, so it follows font and display size.
+ */
+class EtesianEmergencyBlock(context: Context) : LinearLayout(context) {
+    private val owner = text(13f, true, 0xFFFFFFFF.toInt())
+    private val facts = text(12f, false, 0xFFFFFFFF.toInt()).apply { maxLines = 3 }
+    private val more = text(12f, true, 0xFFFF8A84.toInt()).apply { text = "Emergency info ›" }
+    private val rule = Paint().apply { color = RED }
+    private val observer = object : android.database.ContentObserver(android.os.Handler(android.os.Looper.getMainLooper())) {
+        override fun onChange(selfChange: Boolean) = refresh()
+    }
+
+    init {
+        orientation = VERTICAL
+        tag = "etesian_lock_emergency"
+        contentDescription = "Emergency information"
+        setWillNotDraw(false)
+        val d = resources.displayMetrics.density
+        setPadding((11 * d).toInt(), (2 * d).toInt(), 0, (2 * d).toInt())
+        addView(owner); addView(facts); addView(more)
+        isClickable = true
+        setOnClickListener {
+            runCatching {
+                context.startActivity(Intent().setClassName(LAUNCHER, "$LAUNCHER.EmergencyCardActivity")
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_CLEAR_TASK))
+            }
+        }
+        refresh()
+    }
+
+    private fun text(sp: Float, bold: Boolean, color: Int) = TextView(context).apply {
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        setTextColor(color)
+        typeface = android.graphics.Typeface.create("etesian-text", if (bold) android.graphics.Typeface.BOLD else android.graphics.Typeface.NORMAL)
+        ellipsize = TextUtils.TruncateAt.END
+        maxLines = 2
+        setLineSpacing(0f, 1.1f)
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        (KEYS + listOf(EXTRA, SHOW, "etesian_gestures")).forEach {
+            context.contentResolver.registerContentObserver(Settings.Secure.getUriFor(it), false, observer)
+        }
+        refresh()
+    }
+
+    override fun onDetachedFromWindow() {
+        context.contentResolver.unregisterContentObserver(observer)
+        super.onDetachedFromWindow()
+    }
+
+    /** Font and display size: sp/dp were resolved when set, so set them again. */
+    override fun onConfigurationChanged(newConfig: android.content.res.Configuration?) {
+        super.onConfigurationChanged(newConfig)
+        val d = resources.displayMetrics.density
+        owner.setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+        facts.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        more.setTextSize(TypedValue.COMPLEX_UNIT_SP, 12f)
+        setPadding((11 * d).toInt(), (2 * d).toInt(), 0, (2 * d).toInt())
+        invalidate()
+    }
+
+    override fun onDraw(c: Canvas) {
+        super.onDraw(c)
+        c.drawRect(0f, 0f, 3 * resources.displayMetrics.density, height.toFloat(), rule)
+    }
+
+    private fun get(k: String) = Settings.Secure.getString(context.contentResolver, "etesian_emergency_$k")?.trim().orEmpty()
+
+    fun refresh() {
+        val cr = context.contentResolver
+        val on = Settings.Secure.getInt(cr, EXTRA, 0) == 1 && Settings.Secure.getInt(cr, "etesian_gestures", 0) == 1
+        visibility = if (on) VISIBLE else GONE
+        if (!on) return
+        val show = (Settings.Secure.getString(cr, SHOW) ?: "name,blood,allergies").split(',').map { it.trim() }.toSet()
+        val name = get("name").takeIf { "name" in show && it.isNotEmpty() } ?: "Emergency"
+        owner.text = SpannableStringBuilder("✚ ").apply {
+            setSpan(ForegroundColorSpan(RED), 0, 1, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            append(name)
+        }
+        val parts = mutableListOf<String>()
+        if ("blood" in show) get("blood").takeIf { it.isNotEmpty() }?.let { parts += "Blood $it" }
+        if ("allergies" in show) get("allergies").takeIf { it.isNotEmpty() }?.let { parts += it }
+        if ("medication" in show) get("medication").takeIf { it.isNotEmpty() }?.let { parts += it }
+        if ("notes" in show) get("notes").takeIf { it.isNotEmpty() }?.let { parts += it }
+        if ("donor" in show && get("donor").equals("yes", true)) parts += "Organ donor"
+        facts.text = parts.joinToString(" · ")
+        facts.visibility = if (parts.isEmpty()) GONE else VISIBLE
+        invalidate()
+    }
+
+    companion object {
+        const val LAUNCHER = "com.bompotis.etesian.launcher"
+        const val EXTRA = "etesian_extra_emergency"
+        const val SHOW = "etesian_emergency_show"
+        const val RED = 0xFFE8463F.toInt()
+        val KEYS = listOf("name", "blood", "allergies", "medication", "notes", "donor").map { "etesian_emergency_$it" }
+    }
+}
