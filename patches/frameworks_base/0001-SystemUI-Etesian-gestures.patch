+/**
+ * Etesian (N9) volume indicator: white label on the left ("Volume" / "Ringing" / "Silent") and
+ * a continuous magenta fill bar on a dark grey track, square corners. Tap or drag to set volume.
+ */
+@Composable
+private fun EtesianVolumeBar(
+    viewModel: VolumeDialogSliderViewModel,
+    overscrollViewModel: VolumeDialogOverscrollViewModel,
+) {
+    val collectedSliderStateModel by viewModel.state.collectAsStateWithLifecycle(null)
+    val sliderStateModel = collectedSliderStateModel ?: return
+    val range = sliderStateModel.valueRange
+    val span = range.endInclusive - range.start
+    val fraction =
+        if (span > 0f) ((sliderStateModel.value - range.start) / span).coerceIn(0f, 1f) else 0f
+    val stream = viewModel.audioStream
+    val label =
+        stringResource(
+            when {
+                fraction <= 0f -> R.string.n9_volume_label_silent
+                stream == AudioManager.STREAM_RING ||
+                    stream == AudioManager.STREAM_NOTIFICATION ->
+                    R.string.n9_volume_label_ringing
+                else -> R.string.n9_volume_label_volume
+            }
+        )
+    val enabled = !sliderStateModel.isDisabled
+
+    fun valueAt(x: Float, width: Int): Float {
+        val f = if (width > 0) (x / width).coerceIn(0f, 1f) else 0f
+        return range.start + f * span
+    }
+
+    fun setValue(value: Float) {
+        overscrollViewModel.setSlider(
+            value = value,
+            min = range.start,
+            max = range.endInclusive,
+        )
+        viewModel.setStreamVolume(value, true)
+    }
+
+    Row(
+        modifier =
+            Modifier.fillMaxSize()
+                .padding(horizontal = 12.dp)
+                .pointerInput(Unit) {
+                    coroutineScope {
+                        val currentContext = currentCoroutineContext()
+                        awaitPointerEventScope {
+                            while (currentContext.isActive) {
+                                viewModel.onTouchEvent(awaitPointerEvent())
+                            }
+                        }
+                    }
+                },
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Text(
+            text = label,
+            color = colorResource(R.color.n9_volume_bar_label),
+            fontSize = 14.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.width(80.dp),
+        )
+        Box(
+            modifier =
+                Modifier.weight(1f)
+                    .height(8.dp)
+                    .background(colorResource(R.color.n9_volume_bar_track))
+                    .semantics {
+                        contentDescription = sliderStateModel.label
+                        progressBarRangeInfo =
+                            ProgressBarRangeInfo(sliderStateModel.value, range)
+                        if (enabled) {
+                            setProgress { target ->
+                                setValue(target.coerceIn(range.start, range.endInclusive))
+                                viewModel.onSliderChangeFinished(target)
+                                true
+                            }
+                        }
+                    }
+                    .pointerInput(enabled, range) {
+                        if (!enabled) return@pointerInput
+                        detectTapGestures { offset ->
+                            val v = valueAt(offset.x, size.width)
+                            setValue(v)
+                            viewModel.onSliderChangeFinished(v)
+                        }
+                    }
+                    .pointerInput(enabled, range) {
+                        if (!enabled) return@pointerInput
+                        var last = range.start
+                        detectHorizontalDragGestures(
+                            onDragStart = { offset ->
+                                viewModel.onSliderDragStarted()
+                                last = valueAt(offset.x, size.width)
+                                setValue(last)
+                            },
+                            onDragEnd = {
+                                viewModel.onSliderDragFinished()
+                                viewModel.onSliderChangeFinished(last)
+                            },
+                            onDragCancel = { viewModel.onSliderDragFinished() },
+                        ) { change, _ ->
+                            change.consume()
+                            last = valueAt(change.position.x, size.width)
+                            setValue(last)
+                        }
+                    }
+        ) {
+            Box(
+                modifier =
+                    Modifier.fillMaxHeight()
+                        .fillMaxWidth(fraction)
+                        .background(colorResource(R.color.n9_volume_bar_fill))
+            )
+        }
+    }
+}
