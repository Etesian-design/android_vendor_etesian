+        // Wait for audioserver (not system_server's "audio" service: bootanim may not look that
+        // one up, SELinux). The player must be made early: once the phone has booted, audioserver
+        // refuses tracks for bootanim's uid (it has no package), and the part with the startup
+        // sound plays only then. Bounded wait so a missing audioserver never holds anything up.
+        for (int i = 0; i < 200 && defaultServiceManager()->checkService(
+                String16("media.audio_flinger")) == nullptr; i++) {
+            usleep(100 * 1000);
+        }
+        if (defaultServiceManager()->checkService(String16("media.audio_flinger")) == nullptr) {
