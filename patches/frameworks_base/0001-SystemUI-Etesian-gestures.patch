+package com.android.systemui.statusbar.notification.row
+
+import android.app.Notification
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Path
+import android.graphics.drawable.AdaptiveIconDrawable
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.os.UserHandle
+import android.service.notification.StatusBarNotification
+import android.text.TextUtils
+import android.text.format.DateFormat
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.LinearLayout
+import android.widget.TextView
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.pow
+import kotlin.math.sign
+import kotlin.math.sin
+
+/**
+ * Etesian (N9): a notification as the N9 lock screen shows it. A dark translucent tile with the
+ * contact's photo or the app's icon on the left (a squircle), the message in large type, and who
+ * or what it's from and the time underneath. No app header, no buttons. Shown by
+ * [ExpandableNotificationRow] in place of its own content while on the lock screen.
+ */
+class EtesianLockCard(context: Context) : LinearLayout(context) {
+    // Read live: the card follows Android's display size (density) and font size changes.
+    private val density get() = resources.displayMetrics.density
+    private val icon = SquircleIcon(context)
+    private val primary = text(18f, 0xFFFFFFFF.toInt(), 2)
+    private val secondary = text(14f, 0xCCFFFFFF.toInt(), 1)
+    private val time = text(14f, 0x99FFFFFF.toInt(), 1)
+    private var boundKey: String? = null
+    private var boundWhen = 0L
+    private var boundCount = 0
+
+    init {
+        orientation = HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        isClickable = false
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO_HIDE_DESCENDANTS
+        addView(icon, LayoutParams(0, 0))
+        addView(LinearLayout(context).apply {
+            orientation = VERTICAL
+            addView(primary)
+            addView(secondary)
+            addView(time)
+        }, LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
+        applySizes()
+    }
+
+    /** Sizes in dp and sp, re-applied when the font size or display size changes. */
+    private fun applySizes() {
+        val h = (16 * density).toInt()
+        val v = (12 * density).toInt()
+        setPadding(h, v, h, v)
+        background = GradientDrawable().apply {
+            // Bubbles over apps are solid (the mocks): nothing of the app shows through.
+            setColor(if (bubble) 0xFF15181C.toInt() else 0xB30C0F12.toInt())
+            cornerRadius = (if (bubble) 10 else 8) * density
+        }
+        if (bubble) elevation = 8 * density
+        val size = (44 * density).toInt()
+        icon.layoutParams = (icon.layoutParams as LayoutParams).apply {
+            width = size; height = size; marginEnd = (16 * density).toInt()
+        }
+        primary.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18f)
+        secondary.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        time.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14f)
+        for (t in listOf(primary, secondary, time)) t.setPadding(0, (1 * density).toInt(), 0, (2 * density).toInt())
+        requestLayout()
+    }
+
+    override fun onConfigurationChanged(newConfig: android.content.res.Configuration?) {
+        super.onConfigurationChanged(newConfig)
+        applySizes()
+    }
+
+    private fun text(sp: Float, color: Int, lines: Int) = TextView(context).apply {
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        setTextColor(color)
+        maxLines = lines
+        ellipsize = TextUtils.TruncateAt.END
+        includeFontPadding = false
+        setPadding(0, (1 * density).toInt(), 0, (2 * density).toInt())
+    }
+
+    /** Shows [sbn]; [count] > 1 for a collapsed group, which shows its newest notification. */
+    fun bind(sbn: StatusBarNotification, count: Int) {
+        if (sbn.key == boundKey && sbn.postTime == boundWhen && count == boundCount) return
+        boundKey = sbn.key
+        boundWhen = sbn.postTime
+        boundCount = count
+        val n = sbn.notification
+        val extras = n.extras
+        val title = extras.getCharSequence(Notification.EXTRA_TITLE)?.toString()?.trim().orEmpty()
+        val body = (extras.getCharSequence(Notification.EXTRA_BIG_TEXT)
+            ?: extras.getCharSequence(Notification.EXTRA_TEXT))?.toString()?.trim().orEmpty()
+        val app = appName(sbn)
+        // As on the N9: what it says in large type, who or what it's from underneath.
+        val big = body.ifEmpty { title.ifEmpty { app } }
+        var from = if (body.isEmpty()) app else title.ifEmpty { app }
+        if (count > 1) from = "$from · ${count - 1} more"
+        primary.text = big
+        secondary.text = from
+        secondary.visibility = if (from.isEmpty()) GONE else VISIBLE
+        val shown = if (n.`when` != 0L) n.`when` else sbn.postTime
+        time.text = DateFormat.getTimeFormat(context).format(shown)
+        icon.drawable = picture(sbn)
+        contentDescription = "$from, $big"
+    }
+
+    /**
+     * Shows content that is not a notification (the screenshot or pinning bubbles): [picture] as
+     * a squircle, or as it is ([asIs], e.g. a screenshot thumbnail); [when] 0 hides the time.
+     */
+    fun bindCustom(picture: Drawable?, asIs: Boolean, big: String, from: String, `when`: Long) {
+        boundKey = null
+        primary.text = big
+        secondary.text = from
+        secondary.visibility = if (from.isEmpty()) GONE else VISIBLE
+        time.text = if (`when` != 0L) DateFormat.getTimeFormat(context).format(`when`) else ""
+        time.visibility = if (`when` != 0L) VISIBLE else GONE
+        icon.asIs = asIs
+        icon.drawable = picture
+        contentDescription = "$big, $from"
+    }
+
+    /** The bubble over apps: the same card, ~92% dark, a touch more rounded. */
+    private var bubble = false
+
+    fun asBubble() {
+        bubble = true
+        applySizes()
+    }
+
+    private fun appName(sbn: StatusBarNotification): String = runCatching {
+        val pm = context.packageManager
+        val info = pm.getApplicationInfoAsUser(sbn.packageName, 0, sbn.user.identifier)
+        pm.getApplicationLabel(info).toString()
+    }.getOrDefault(sbn.packageName)
+
+    /** The contact's photo (the large icon) when there is one, otherwise the app's icon. */
+    internal fun picture(sbn: StatusBarNotification): Drawable? {
+        sbn.notification.getLargeIcon()?.let { large ->
+            runCatching { large.loadDrawable(sbn.getPackageContext(context)) }.getOrNull()
+                ?.let { return it }
+        }
+        // The system's own notifications (USB, keyboard, Trust...) have no real app icon: the
+        // android package's is a legacy gear in a circle. Their small icon on a lit tile instead.
+        if (sbn.packageName in SYSTEM_PACKAGES) return systemTile(sbn)
+        // Notifications for all users (-1) are looked up as the current user.
+        val user = sbn.user.identifier.takeIf { it >= 0 } ?: UserHandle.myUserId()
+        return runCatching {
+            val pm = context.packageManager
+            val info = pm.getApplicationInfoAsUser(sbn.packageName, 0, user)
+            val plain = pm.getApplicationIcon(info)
+            // Badged icons wrap the adaptive icon (and its system mask); only badge work apps.
+            if (user == UserHandle.myUserId()) plain
+            else pm.getUserBadgedIcon(plain, UserHandle.of(user))
+        }.getOrNull() ?: systemTile(sbn)
+    }
+
+    /** [sbn]'s small icon in white on the N9's lit grey tile; the squircle clip shapes it. */
+    private fun systemTile(sbn: StatusBarNotification): Drawable? {
+        val glyph = runCatching { sbn.notification.smallIcon?.loadDrawable(sbn.getPackageContext(context)) }
+            .getOrNull()?.mutate() ?: return null
+        glyph.setTint(0xFFFFFFFF.toInt())
+        val tile = GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+            intArrayOf(0xFF8A8D93.toInt(), 0xFF55585E.toInt(), 0xFF3A3C41.toInt()))
+        return android.graphics.drawable.LayerDrawable(arrayOf(tile, glyph)).apply {
+            val inset = (11 * density).toInt()
+            setLayerInset(1, inset, inset, inset, inset)
+        }
+    }
+
+    /** An image clipped to the N9 squircle (superellipse), never a circle or rounded square. */
+    private class SquircleIcon(context: Context) : View(context) {
+        /** Content (a screenshot) is shown as it is, square, never clipped. */
+        var asIs = false
+        var drawable: Drawable? = null
+            set(value) {
+                field = value
+                invalidate()
+            }
+        private val clip = Path()
+
+        override fun onSizeChanged(w: Int, h: Int, oldw: Int, oldh: Int) {
+            clip.reset()
+            val rx = w / 2f
+            val ry = h / 2f
+            val steps = 64
+            for (i in 0..steps) {
+                val t = 2 * Math.PI * i / steps
+                val c = cos(t)
+                val s = sin(t)
+                // |x|^n + |y|^n = 1, n = 2.8: the N9 icon shape, measured from its own icons.
+                val x = rx + rx * sign(c) * abs(c).pow(2.0 / SQUIRCLE_N)
+                val y = ry + ry * sign(s) * abs(s).pow(2.0 / SQUIRCLE_N)
+                if (i == 0) clip.moveTo(x.toFloat(), y.toFloat()) else clip.lineTo(x.toFloat(), y.toFloat())
+            }
+            clip.close()
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            val d = drawable ?: return
+            canvas.save()
+            if (!asIs) canvas.clipPath(clip)
+            if (d is AdaptiveIconDrawable) {
+                // Its layers, not the drawable itself: that would bring the system's own icon
+                // mask (a circle) inside the squircle. The visible part is the middle 2/3.
+                val e = width / 4
+                for (layer in listOf(d.background, d.foreground)) {
+                    layer ?: continue
+                    layer.setBounds(-e, -e, width + e, height + e)
+                    layer.draw(canvas)
+                }
+            } else if (asIs && d.intrinsicWidth > 0 && d.intrinsicHeight > 0) {
+                // Fit inside the square, keeping its proportions (content is never cropped).
+                val k = minOf(width.toFloat() / d.intrinsicWidth, height.toFloat() / d.intrinsicHeight)
+                val w = (d.intrinsicWidth * k).toInt()
+                val h = (d.intrinsicHeight * k).toInt()
+                d.setBounds((width - w) / 2, (height - h) / 2, (width + w) / 2, (height + h) / 2)
+                d.draw(canvas)
+            } else {
+                d.setBounds(0, 0, width, height)
+                d.draw(canvas)
+            }
+            canvas.restore()
+        }
+    }
+
+    companion object {
+        private const val SQUIRCLE_N = 2.8
+        private val SYSTEM_PACKAGES = setOf("android", "com.android.systemui")
+
+        /** [sbn]'s picture (contact photo or app icon) as an N9 squircle, [px] square. */
+        @JvmStatic
+        fun squircleIcon(context: Context, sbn: StatusBarNotification, px: Int): android.graphics.Bitmap {
+            val card = EtesianLockCard(context)
+            val view = SquircleIcon(context)
+            view.drawable = card.picture(sbn)
+            view.layout(0, 0, px, px)
+            val bmp = android.graphics.Bitmap.createBitmap(px, px, android.graphics.Bitmap.Config.ARGB_8888)
+            view.draw(Canvas(bmp))
+            return bmp
+        }
+    }
+}
