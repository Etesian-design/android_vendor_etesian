+                com.android.systemui.common.shared.model.Icon.Resource(com.android.systemui.res.R.drawable.etesian_rec_dot, desc)),
+            content = com.android.systemui.statusbar.chips.ui.model.OngoingActivityChipModel.Content.IconOnly,
