+package com.android.systemui.statusbar.chips.screenrecord.ui.viewmodel
+
+import android.content.Context
+import android.provider.Settings
+import kotlinx.coroutines.channels.awaitClose
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.callbackFlow
+
+/**
+ * Etesian: the screen recording started from the launcher's status-menu strip
+ * (ScreenRecordingCoreStartable publishes its start time in Settings.Secure
+ * etesian_screen_recording, 0 = none) and its red status-bar dot's "Stop recording?".
+ */
+object EtesianRecording {
+    private const val STATE = "etesian_screen_recording"
+
+    fun on(ctx: Context) =
+        Settings.Secure.getInt(ctx.contentResolver, "etesian_gestures", 0) == 1
+
+    fun since(ctx: Context): Flow<Long> = callbackFlow {
+        val cr = ctx.contentResolver
+        fun read() = runCatching { Settings.Secure.getLong(cr, STATE, 0L) }.getOrDefault(0L)
+        val o = object : android.database.ContentObserver(
+            android.os.Handler(android.os.Looper.getMainLooper())) {
+            override fun onChange(selfChange: Boolean) { trySend(read()) }
+        }
+        cr.registerContentObserver(Settings.Secure.getUriFor(STATE), false, o)
+        trySend(read())
+        awaitClose { cr.unregisterContentObserver(o) }
+    }
+
+    /** Casting and screen sharing chips as the same red dot (their tap still asks to stop). */
+    fun dot(m: com.android.systemui.statusbar.chips.ui.model.OngoingActivityChipModel):
+        com.android.systemui.statusbar.chips.ui.model.OngoingActivityChipModel {
+        if (m !is com.android.systemui.statusbar.chips.ui.model.OngoingActivityChipModel.Active) return m
+        val app = android.app.ActivityThread.currentApplication() ?: return m
+        if (!on(app)) return m
+        val desc = ((m.icon as? com.android.systemui.statusbar.chips.ui.model.OngoingActivityChipModel.ChipIcon.SingleColorIcon)
+            ?.impl as? com.android.systemui.common.shared.model.Icon.Resource)?.contentDescription
+        return m.copy(
