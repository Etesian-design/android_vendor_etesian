+public class EtesianBottomBar extends LinearLayout {
+    private static final String TAG = "EtesianBottomBar";
+    public static final String SETTING_ENABLED = "etesian_bottom_bar";
+    public static final String SETTING_BUTTONS = "etesian_bottom_bar_buttons";
+    public static final String SETTING_GESTURES = "etesian_gestures";
+    /** 0: N9 light grey, as the N9 Store's toolbar (default); 1: Symbian Belle dark. */
+    public static final String SETTING_STYLE = "etesian_toolbar_style";
+    /** 0: Back on the left (default); 1: on the right. */
+    public static final String SETTING_BACK_SIDE = "etesian_toolbar_back_side";
+    /** 0: bar at the bottom (default); 1: side strip on the Back side. */
+    public static final String SETTING_MODE = "etesian_toolbar_mode";
+    /** The user's buttons, default and per app (JSON, written by the launcher). */
+    public static final String SETTING_CONFIG = "etesian_toolbar_config";
+    public static final int BAR_HEIGHT_DP = 64;
+    private static final int BUTTON_DP = 48;
