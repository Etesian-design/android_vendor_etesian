diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/ui/view/layout/sections/EtesianEmergencyBlock.kt b/packages/SystemUI/src/com/android/systemui/keyguard/ui/view/layout/sections/EtesianEmergencyBlock.kt
