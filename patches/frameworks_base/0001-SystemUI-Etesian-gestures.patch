+package com.android.systemui.statusbar.notification.stack
+
+import android.view.View
+
+/**
+ * Etesian (N9): the lock screen notification list. Collapsed, the newest notifications sit at
+ * the bottom with the next few peeking out behind them as real cards. Sliding up on those opens
+ * every notification right there on the lock screen (over the clock), scrollable; sliding down
+ * at the top of the list closes it again. [StackScrollAlgorithm] does the layout from this state.
+ */
+object EtesianLockList {
+    /** The whole list is open on the lock screen. */
+    @JvmStatic
+    var expanded = false
+        private set
+
+    /** How far the open list is scrolled, in px (0 = newest at the top). */
+    @JvmStatic
+    var scroll = 0f
+        private set
+
+    /** The furthest [scroll] can go; set by the layout. */
+    @JvmStatic
+    var maxScroll = 0f
+
+    /** How far [scroll] can go the other way (<= 0), when a card opened past the top. */
+    @JvmStatic
+    var minScroll = 0f
+
+    /** There are notifications past the lock screen's limit (peeking, or in the open list). */
+    @JvmStatic
+    var hasMore = false
+
+    /** Sideways offset of the peeking cards, following a notification being swiped. */
+    @JvmStatic
+    var peekOffset = 0f
+
+    /** Stacked style: where the stack's strips start, in stack coordinates; set by the layout. */
+    @JvmStatic
