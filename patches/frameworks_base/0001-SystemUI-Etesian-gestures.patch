+package com.android.systemui.volume;
+
+import android.content.Context;
+import android.media.AudioAttributes;
+import android.media.AudioManager;
+import android.media.SoundPool;
+import android.os.VibrationEffect;
+import android.os.Vibrator;
+import android.provider.Settings;
+import android.util.Log;
+
+import java.io.File;
+
+/**
+ * The N9's volume-key sounds (its ngfd events): a ringer step plays the ringer-level tone at the
+ * new level, the ringer reaching silent gives a short buzz, and pressing past the top or bottom
+ * of the media volume plays the max / min tone. Only when the user's N9 tones are installed
+ * (/product/media/audio/ui/n9, from vendor/etesian/n9-files); "etesian_volume_tones" = 0
+ * turns them off (the decision is still logged, which the tests read).
+ */
+final class N9VolumeTones {
+    private static final String TAG = "N9VolumeTones";
+    private static final String DIR = "/product/media/audio/ui/n9/";
+    private static final String SETTING = "etesian_volume_tones";
+
+    private final Context mContext;
+    private SoundPool mPool;
+    private int mRinger, mMax, mMin;
+
+    N9VolumeTones(Context context) {
+        mContext = context;
+    }
+
+    private static boolean has(String f) {
+        return new File(DIR + f).exists();
+    }
+
+    private void load() {
+        if (mPool != null) return;
+        mPool = new SoundPool.Builder().setMaxStreams(2).setAudioAttributes(new AudioAttributes.Builder()
+                .setUsage(AudioAttributes.USAGE_ASSISTANCE_SONIFICATION)
+                .setContentType(AudioAttributes.CONTENT_TYPE_SONIFICATION).build()).build();
+        mRinger = has("profile_ringer_level.wav") ? mPool.load(DIR + "profile_ringer_level.wav", 1) : 0;
+        mMax = has("volume_max.wav") ? mPool.load(DIR + "volume_max.wav", 1) : 0;
+        mMin = has("volume_min.wav") ? mPool.load(DIR + "volume_min.wav", 1) : 0;
+    }
+
+    /** After a volume key changed (or tried to change) [stream] from [before] to [level] of [max]. */
+    void onKey(int stream, int before, int level, int max) {
+        final String what;
+        float gain = 1f;
+        if (stream == AudioManager.STREAM_RING || stream == AudioManager.STREAM_NOTIFICATION) {
+            if (level == before) return;
+            if (level == 0) what = "silent";
+            else { what = "ringer"; gain = level / (float) Math.max(1, max); }
+        } else if (stream == AudioManager.STREAM_MUSIC && level == before) {
+            if (level >= max) what = "max";
+            else if (level == 0) { what = "min"; gain = 0.1f; }   // ngfd: volume_min fixed:10
+            else return;
+        } else {
+            return;
+        }
+        final boolean on = Settings.Secure.getInt(mContext.getContentResolver(), SETTING, 1) == 1;
+        Log.i(TAG, "tone " + what + " stream=" + stream + " level=" + level + "/" + max + (on ? "" : " (off)"));
+        if (!on) return;
+        if (what.equals("silent")) {
+            final Vibrator v = mContext.getSystemService(Vibrator.class);
+            if (v != null) v.vibrate(VibrationEffect.createPredefined(VibrationEffect.EFFECT_HEAVY_CLICK));
+            return;
+        }
+        if (!has("profile_ringer_level.wav")) return;
+        load();
+        final int id = what.equals("ringer") ? mRinger : what.equals("max") ? mMax : mMin;
+        if (id != 0) mPool.play(id, gain, gain, 1, 0, 1f);
+    }
+}
