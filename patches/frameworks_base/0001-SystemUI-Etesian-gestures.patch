@@ -0,0 +1,166 @@
+/*
+ * Etesian (Nokia N9) lock screen: the wallpaper is part of the lock screen layer.
+ * Only used while Settings.Secure "etesian_gestures" is 1.
+ */
+package com.android.systemui.shade
+
+import android.app.WallpaperManager
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.Point
+import android.graphics.Rect
+import android.graphics.RectF
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.Drawable
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.view.View
+import java.util.concurrent.Executors
+
+/**
+ * On the keyguard the wallpaper is drawn by the wallpaper window behind SystemUI, so moving
+ * keyguard_root_view (N9 unlock slide, swipe-to-open parallax) leaves it standing still. While the
+ * lock screen moves, a copy of the lock screen wallpaper (center-cropped like the system shows it)
+ * is installed as keyguard_root_view's background so the whole layer, background included, moves
+ * with the finger. It is removed again as soon as the layer is back in place, so AOD and the normal
+ * lock screen are untouched.
+ */
+object EtesianLockWallpaper {
+    private const val TAG = "EtesianLockWallpaper"
+
+    /**
+     * True while the N9 slide reveals the app/launcher behind the lock screen. Asking for that
+     * surface marks the keyguard as going away, which starts the stock LOCKSCREEN->GONE transition
+     * and fades the lock screen and notifications to alpha 0 right away; while this is set those
+     * transition view models keep them opaque so the layer only translates with the finger.
+     */
+    @JvmStatic @Volatile var holdLockscreenOpaque = false
+
+    private val bg = Executors.newSingleThreadExecutor()
+    private val main = Handler(Looper.getMainLooper())
+
+    /** Cached wallpaper; reloaded when the wallpaper id changes. */
+    @Volatile private var cached: Pair<Bitmap, Rect>? = null
+    @Volatile private var cachedKey = ""
+
+    /** keyguard_root_view's own background while ours is installed. */
+    private val originals = java.util.WeakHashMap<View, Drawable?>()
+
+    /** Loads the wallpaper ahead of time (keyguard shown), so the first drag has it. */
+    @JvmStatic
+    fun preload(view: View) {
+        val ctx = view.context.applicationContext
+        val size = screenSize(view)
+        bg.execute { load(ctx, size) }
+    }
+
+    /** Window root backgrounds replaced by black while the parallax layer moves. */
+    private val parentOriginals = java.util.WeakHashMap<View, Drawable?>()
+
+    /**
+     * Puts the wallpaper layer into [keyguardRoot] (no-op when already there). With [blackBehind]
+     * the window root behind it is painted black, so the edge the layer uncovers is black (N9)
+     * instead of the still system wallpaper.
+     */
+    @JvmStatic
+    @JvmOverloads
+    fun install(keyguardRoot: View, blackBehind: Boolean = false) {
+        if (blackBehind) {
+            val parent = keyguardRoot.parent as? View
+            if (parent != null && !parentOriginals.containsKey(parent)) {
+                parentOriginals[parent] = parent.background
+                parent.background = android.graphics.drawable.ColorDrawable(
+                    android.graphics.Color.BLACK)
+            }
+        }
+        if (originals.containsKey(keyguardRoot)) return
+        val wp = cached
+        val layer = Layer(keyguardRoot, wp)
+        originals[keyguardRoot] = keyguardRoot.background
+        keyguardRoot.background = layer
+        if (wp == null) {
+            // First drag before the preload finished: load now, show when ready.
+            val ctx = keyguardRoot.context.applicationContext
+            val size = screenSize(keyguardRoot)
+            bg.execute {
+                val loaded = load(ctx, size)
+                main.post { layer.wallpaper = loaded }
+            }
+        }
+    }
+
+    /** Restores [keyguardRoot]'s background (layer back in place). */
+    @JvmStatic
+    fun remove(keyguardRoot: View) {
+        val parent = keyguardRoot.parent as? View
+        if (parent != null && parentOriginals.containsKey(parent)) {
+            parent.background = parentOriginals.remove(parent)
+        }
+        if (!originals.containsKey(keyguardRoot)) return
+        keyguardRoot.background = originals.remove(keyguardRoot)
+    }
+
+    /** Full window size (the wallpaper covers the whole display, nav bar included). */
+    private fun screenSize(view: View): Point = runCatching {
+        val b = view.context.getSystemService(android.view.WindowManager::class.java)!!
+            .currentWindowMetrics.bounds
+        Point(b.width(), b.height())
+    }.getOrElse {
+        val dm = view.resources.displayMetrics
+        Point(dm.widthPixels, dm.heightPixels)
+    }
+
+    private fun load(ctx: android.content.Context, size: Point): Pair<Bitmap, Rect>? =
+        runCatching {
+            val wm = WallpaperManager.getInstance(ctx)
+            // A live wallpaper has no bitmap; the lock screen layer then moves without it.
+            if (wm.wallpaperInfo != null) return@runCatching null
+            val which = if (wm.getWallpaperId(WallpaperManager.FLAG_LOCK) > 0)
+                WallpaperManager.FLAG_LOCK else WallpaperManager.FLAG_SYSTEM
+            val key = "$which:${wm.getWallpaperId(which)}:${size.x}x${size.y}"
+            if (key == cachedKey && cached != null) return@runCatching cached
+            val bitmap = (wm.getDrawable(which) as? BitmapDrawable)?.bitmap
+                ?: return@runCatching null
+            val shown = runCatching { wm.getBitmapCrops(listOf(size), which, false).firstOrNull() }
+                .getOrNull() ?: Rect(0, 0, bitmap.width, bitmap.height)
+            // The crop can be wider than the screen (parallax); the lock screen shows its middle.
+            val aspect = size.x.toFloat() / size.y.coerceAtLeast(1)
+            val w = minOf(shown.width(), (shown.height() * aspect).toInt())
+            val h = minOf(shown.height(), (w / aspect).toInt())
+            val left = shown.left + (shown.width() - w) / 2
+            val top = shown.top + (shown.height() - h) / 2
+            val result = bitmap to Rect(left, top, left + w, top + h)
+            cached = result
+            cachedKey = key
+            result
+        }.onFailure { Log.w(TAG, "wallpaper", it) }.getOrNull()
+
+    /** The wallpaper, drawn at the screen position keyguard_root_view occupies when at rest. */
+    private class Layer(private val owner: View, wp: Pair<Bitmap, Rect>?) : Drawable() {
+        var wallpaper = wp
+            set(value) { field = value; invalidateSelf() }
+        private val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+        private val dst = RectF()
+        private val loc = IntArray(2)
+
+        override fun draw(canvas: Canvas) {
+            val (bitmap, src) = wallpaper ?: return
+            val size = screenSize(owner)
+            // Location on screen without the current drag translation.
+            owner.getLocationOnScreen(loc)
+            val x = loc[0] - owner.translationX
+            val y = loc[1] - owner.translationY
+            dst.set(-x, -y, -x + size.x, -y + size.y)
+            canvas.drawBitmap(bitmap, src, dst, paint)
+        }
+
+        override fun setAlpha(alpha: Int) {}
+        override fun setColorFilter(colorFilter: ColorFilter?) {}
+        @Deprecated("Deprecated in Java")
+        override fun getOpacity() = PixelFormat.TRANSLUCENT
+    }
+}
