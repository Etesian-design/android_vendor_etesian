+            // once more now. Still no player: stay silent.
+            if (!engineCreated) {
+                audioplay::destroy();
+                engineCreated = audioplay::create(part.audioData, part.audioLength);
+                if (!engineCreated) {
+                    audioplay::destroy();
+                    return;
+                }
+            }
             audioplay::playClip(part.audioData, part.audioLength);
         }
     };
@@ -388,6 +414,7 @@ public:
 
 private:
     sp<InitAudioThread> initAudioThread = nullptr;
+    bool soundsAllowed = false;
 };
 
