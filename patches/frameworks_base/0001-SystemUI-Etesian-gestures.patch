+        float prevBottom = -Float.MAX_VALUE;
+        float contentTop = Float.MAX_VALUE;
+        for (int i = 0; i < n; i++) {
+            final ExpandableView v = all.get(i);
+            final ExpandableViewState st = v.getViewState();
+            final int h = v.getIntrinsicHeight();
+            final float parked = bottom - h;
+            final float cy = Math.min(y[i] - scroll, parked);
+            st.hidden = false;
+            st.inShelf = false;
+            st.clipBottomAmount = 0;
+            st.height = h;
+            // Flat N9 tiles: they're translucent, so any shadow under them would show through.
+            st.setZTranslation(0f);
+            st.setXTranslation(cy >= parked - 0.5f && i >= shown.size()
+                    ? EtesianLockList.getPeekOffset() : 0f);
+            st.setYTranslation(cy, "etesian accordion");
+            // Covered by the card in front (still parked behind it) and folded under the clock.
+            final float coveredTop = Math.max(0f, prevBottom + pad - cy);
+            final float foldedTop = Math.max(0f, limit - cy);
+            final int clip = (int) Math.min(h, Math.max(coveredTop, foldedTop));
+            st.clipTopAmount = clip;
+            if (clip >= h - 0.5f) {
+                st.hidden = true;
+                st.setAlpha(0f, "etesian accordion hidden");
+            } else if (foldedTop > 0f) {
+                // Folding away: it fades and narrows a little as it goes under the clock's edge.
+                final float f = 1f - foldedTop / h;
+                st.setAlpha(Math.max(0f, f), "etesian accordion fold");
+                st.setScaleX(0.94f + 0.06f * f);
+            } else {
+                st.setAlpha(1f, "etesian accordion");
+                st.setScaleX(1f);
+            }
+            if (!st.hidden) contentTop = Math.min(contentTop, cy + clip);
+            prevBottom = Math.max(prevBottom, cy + h);
+        }
+        EtesianLockList.logLayout(all, limit);
+        // The clock never fades: nothing ever goes over it.
+        EtesianLockList.setContentTop(Float.MAX_VALUE);
+        if (shelf != null) {
+            // Not drawn (the cards are the stack). Below every card: it clips whatever reaches it.
+            shelf.hidden = true;
+            shelf.setYTranslation(areaBottom, "etesian carousel");
+        }
+        if (ambientState.getShelf() != null) {
+            ambientState.getShelf().setEtesianPeeking(true);
+            ambientState.getShelf().setEtesianMore(false);
+        }
+    }
+
+    /**
+     * Etesian: every notification on the lock screen, newest at the top, from the status bar
+     * down to the bottom edge; bottom-aligned when it fits, scrolled by EtesianLockList when not.
+     */
+    private void layoutOpenListForEtesian(java.util.List<ExpandableView> shown,
+            java.util.List<ExpandableView> more, ExpandableViewState shelf, float areaBottom) {
+        final java.util.ArrayList<ExpandableView> all = new java.util.ArrayList<>(shown);
+        all.addAll(more);
+        float total = 0;
+        for (ExpandableView v : all) total += v.getViewState().height + mPaddingBetweenElements;
+        final float top = mStatusBarHeight + mPaddingBetweenElements
+                - EtesianLockList.getStackTopOnScreen();
+        final float bottom = areaBottom - mPaddingBetweenElements;
+        final float space = bottom - top;
+        EtesianLockList.setMaxScroll(Math.max(0f, total - space));
+        float y = total <= space ? bottom - total : top - EtesianLockList.getScroll();
+        for (ExpandableView v : all) {
+            final ExpandableViewState st = v.getViewState();
+            st.hidden = false;
+            st.inShelf = false;
+            st.clipTopAmount = 0;
+            st.clipBottomAmount = 0;
+            st.setXTranslation(0f);
+            st.setScaleX(1f);
+            st.setYTranslation(y, "etesian open list");
+            // Fade out what scrolls past either end.
+            final float over = Math.max(top - y, y + st.height - bottom);
+            st.setAlpha(over <= 0 ? 1f : Math.max(0f, 1f - over / st.height), "etesian list");
+            y += st.height + mPaddingBetweenElements;
+        }
+        if (shelf != null) {
+            // Hidden, but rows are still clipped at its top: keep it below the list.
+            shelf.hidden = true;
+            shelf.setYTranslation(areaBottom, "etesian open list");
+        }
+    }
+
     private static boolean isEmptyShadeView(ExpandableView v) {
         return v instanceof EmptyShadeView || v instanceof EmptyShadeIconView;
     }
