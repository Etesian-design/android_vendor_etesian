+package com.android.systemui.statusbar.phone;
+
+import android.content.Context;
+import android.database.ContentObserver;
+import android.graphics.Canvas;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.RectF;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.FrameLayout;
+
+import com.android.systemui.navigationbar.views.EtesianBottomBar;
+
+/**
+ * Etesian toolbar as a side strip (like Sony's Side Sense), instead of the bar at the bottom:
+ * a slim handle on the Back side of the screen; tapping it slides in a vertical strip with the
+ * same buttons as the bar (Back and the user's buttons, or the app's own). The strip hides again
+ * after a button is used, a tap outside it, or a few seconds.
+ *
+ * <p>The handle is tap-only: a swipe in from that edge is the N9 minimise gesture.
+ */
+public final class EtesianSideStrip {
+
+    private static final long AUTO_HIDE_MS = 4000;
+    private static final int STRIP_DP = 76;
+
+    private final Context mContext;
+    private final WindowManager mWindowManager;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final View mHandle;
+    private final FrameLayout mStripFrame;
+    private final EtesianBottomBar mStrip;
+    private boolean mAdded;
+    private boolean mShown;
+    private boolean mRight = true;
+
+    private final Runnable mAutoHide = this::hide;
+
+    public EtesianSideStrip(Context context) {
+        mContext = context;
+        mWindowManager = context.getSystemService(WindowManager.class);
+        mHandle = new Handle(context);
+        mHandle.setOnClickListener(v -> show());
+        mStrip = new EtesianBottomBar(context, true);
+        mStrip.setOnUsed(() -> mHandler.postDelayed(this::hide, 120));
+        mStripFrame = new FrameLayout(context) {
+            @Override
+            public boolean dispatchTouchEvent(MotionEvent ev) {
+                if (ev.getActionMasked() == MotionEvent.ACTION_OUTSIDE) {
+                    hide();
+                    return true;
+                }
+                // Any use keeps it open a while longer.
+                mHandler.removeCallbacks(mAutoHide);
+                mHandler.postDelayed(mAutoHide, AUTO_HIDE_MS);
+                return super.dispatchTouchEvent(ev);
+            }
+        };
+        mStripFrame.addView(mStrip, new FrameLayout.LayoutParams(
+                FrameLayout.LayoutParams.MATCH_PARENT, FrameLayout.LayoutParams.WRAP_CONTENT,
+                Gravity.CENTER_VERTICAL));
+        final ContentObserver observer = new ContentObserver(mHandler) {
+            @Override
+            public void onChange(boolean selfChange) {
+                update();
+            }
+        };
+        for (String key : new String[] {EtesianBottomBar.SETTING_GESTURES,
+                EtesianBottomBar.SETTING_ENABLED, EtesianBottomBar.SETTING_MODE,
+                EtesianBottomBar.SETTING_BACK_SIDE}) {
+            context.getContentResolver().registerContentObserver(Settings.Secure.getUriFor(key),
+                    false, observer, UserHandle.USER_ALL);
+        }
+        update();
+    }
+
+    private int dp(float v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                mContext.getResources().getDisplayMetrics());
+    }
+
+    private void update() {
+        final boolean want = EtesianBottomBar.isOn(mContext)
+                && EtesianBottomBar.isStrip(mContext);
+        // The strip goes on the Back side.
+        mRight = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                EtesianBottomBar.SETTING_BACK_SIDE, 0, UserHandle.USER_CURRENT) != 0;
+        if (want && !mAdded) {
+            mWindowManager.addView(mHandle, handleParams());
+            // Always attached (it keeps up with the app in front); untouchable until shown.
+            mStripFrame.setVisibility(View.INVISIBLE);
+            mWindowManager.addView(mStripFrame, stripParams(false));
+            mAdded = true;
+        } else if (!want && mAdded) {
+            mWindowManager.removeView(mHandle);
+            mWindowManager.removeView(mStripFrame);
+            mAdded = false;
+            mShown = false;
+        } else if (mAdded) {
+            mWindowManager.updateViewLayout(mHandle, handleParams());
+            mWindowManager.updateViewLayout(mStripFrame, stripParams(mShown));
+        }
+        mStrip.rebuild();
+    }
+
+    private WindowManager.LayoutParams base(int w, int h, boolean touchable) {
+        final WindowManager.LayoutParams lp = new WindowManager.LayoutParams(w, h,
+                // Above applications, below the keyboard, status bar, shade and lock screen.
+                WindowManager.LayoutParams.TYPE_SYSTEM_ALERT,
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                        | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                        | (touchable ? WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH
+                                : WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE),
+                PixelFormat.TRANSLUCENT);
+        lp.gravity = (mRight ? Gravity.RIGHT : Gravity.LEFT) | Gravity.CENTER_VERTICAL;
+        lp.setFitInsetsTypes(0);
+        lp.setTrustedOverlay();
+        return lp;
+    }
+
+    private WindowManager.LayoutParams handleParams() {
+        final WindowManager.LayoutParams lp = base(dp(16), dp(120), true);
+        lp.flags &= ~WindowManager.LayoutParams.FLAG_WATCH_OUTSIDE_TOUCH;
+        lp.y = dp(140); // below the middle, within reach of the thumb
+        lp.setTitle("EtesianStripHandle");
+        return lp;
+    }
+
+    private WindowManager.LayoutParams stripParams(boolean touchable) {
+        final WindowManager.LayoutParams lp = base(dp(STRIP_DP),
+                WindowManager.LayoutParams.WRAP_CONTENT, touchable);
+        lp.setTitle("EtesianStrip");
+        return lp;
+    }
+
+    private void show() {
+        if (!mAdded || mShown) return;
+        mShown = true;
+        mStrip.rebuild();
+        mWindowManager.updateViewLayout(mStripFrame, stripParams(true));
+        mHandle.setVisibility(View.INVISIBLE);
+        mStripFrame.setVisibility(View.VISIBLE);
+        final float from = (mRight ? 1 : -1) * dp(STRIP_DP);
+        mStripFrame.setTranslationX(from);
+        mStripFrame.animate().translationX(0).setDuration(180).start();
+        mHandler.removeCallbacks(mAutoHide);
+        mHandler.postDelayed(mAutoHide, AUTO_HIDE_MS);
+    }
+
+    private void hide() {
+        if (!mAdded || !mShown) return;
+        mShown = false;
+        mHandler.removeCallbacks(mAutoHide);
+        mStripFrame.animate().translationX((mRight ? 1 : -1) * dp(STRIP_DP)).setDuration(160)
+                .withEndAction(() -> {
+                    if (mShown) return;
+                    mStripFrame.setVisibility(View.INVISIBLE);
+                    if (mAdded) mWindowManager.updateViewLayout(mStripFrame, stripParams(false));
+                    mHandle.setVisibility(View.VISIBLE);
+                }).start();
+    }
+
+    /** The slim handle on the screen edge. */
+    private final class Handle extends View {
+        private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF mRect = new RectF();
+
+        Handle(Context context) {
+            super(context);
+            mPaint.setColor(0x99A0A0A0);
+            setContentDescription("Toolbar");
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            final float w = dp(4);
+            final float x = EtesianSideStrip.this.mRight ? getWidth() - w - dp(2) : dp(2);
+            mRect.set(x, 0, x + w, getHeight());
+            canvas.drawRoundRect(mRect, w / 2, w / 2, mPaint);
+        }
+    }
+}
