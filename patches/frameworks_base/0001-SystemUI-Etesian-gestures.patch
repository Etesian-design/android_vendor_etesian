+    private void alignToBottomForEtesian(StackScrollAlgorithmState algorithmState,
+            AmbientState ambientState) {
+        if (!mEtesian || SceneContainerFlag.isEnabled() || !ambientState.isOnKeyguard()) {
+            EtesianLockList.setHasMore(false);
