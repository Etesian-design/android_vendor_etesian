     private void handleShow(@Nullable Expandable expandable, int displayId) {
+        // Etesian (N9): the power menu is four stacked N9 buttons.
+        if (mEtesianMenu != null && mEtesianMenu.isShowing()) {
+            // A second long press: report it shown (or the framework falls back to its own menu).
+            mWindowManagerFuncs.onGlobalActionsShown();
+            return;
+        }
+        // Every option the stock menu would offer (config_globalActionsList, the user's Lineage
+        // power menu choices, advanced restart), in its order, as N9 buttons. The four from the
+        // mock keep their N9 names.
+        createActionItems();
+        List<Action> stock = new ArrayList<>();
+        List<Action> listed = new ArrayList<>(mItems);
+        listed.addAll(mOverflowItems);
+        for (Action a : listed) {
+            if (a instanceof PowerOptionsAction) {
+                stock.addAll(mPowerItems);
+            } else {
+                stock.add(a);
+            }
+        }
+        int ri = -1;
+        for (int i = 0; i < stock.size(); i++) if (stock.get(i) instanceof RestartAction) ri = i;
+        if (ri >= 0 && shouldShowRestartSubmenu()) {
+            List<Action> extra = new ArrayList<>();
+            for (Action a : mRestartItems) if (!(a instanceof RestartSystemAction)) extra.add(a);
+            stock.addAll(ri + 1, extra);
+        }
+        // The mock's four first, in its order (Power off, Restart, Lock now, Emergency call); Lock
+        // now is the stock Lock action when lockdown is not offered. Then the rest, in stock order.
+        boolean hasLock = false;
