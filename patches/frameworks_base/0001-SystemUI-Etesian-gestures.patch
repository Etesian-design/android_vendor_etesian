+                    : a instanceof LockDownAction || a instanceof LockAction ? "Lock now"
+                    : a instanceof EmergencyDialerAction ? "Emergency call"
+                    : a.getLabelForAccessibility(mContext);
+            labels[i] = l == null ? "" : l.toString();
