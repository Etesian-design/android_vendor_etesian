diff --git a/src/com/android/calculator2/Calculator.java b/src/com/android/calculator2/Calculator.java
index 6551570..50aa3b7 100644
--- a/src/com/android/calculator2/Calculator.java
+++ b/src/com/android/calculator2/Calculator.java
@@ -302,6 +302,9 @@ public class Calculator extends AppCompatActivity
         }
     }
 
+    /** Etesian: the menu lives on the system bottom toolbar instead of the top bar. */
+    private boolean mEtesianToolbar;
+
     @Override
     protected void onCreate(Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
@@ -312,6 +315,18 @@ public class Calculator extends AppCompatActivity
 
         // Hide all default options in the ActionBar.
         getSupportActionBar().setDisplayOptions(0);
+        // Etesian: as on the N9, nothing on top. The menu (history, full result, fraction, licences) is on the
+        // bottom toolbar, as the N9 menu sheet. The app's only screen: no Back (rule 2).
+        if (com.bompotis.etesian.toolbar.EtesianToolbar.isAvailable(this)) {
+            mEtesianToolbar = true;
+            com.bompotis.etesian.toolbar.EtesianToolbar.of(this).setBack(false).setItems(id -> {
+                if ("menu".equals(id)) {
+                    com.bompotis.etesian.toolbar.EtesianMenu.show(this, R.menu.activity_calculator,
+                            this::onPrepareOptionsMenu, this::onOptionsItemSelected);
+                }
+            }, com.bompotis.etesian.toolbar.EtesianToolbar.Item.action("menu", R.drawable.n9_tb_menu,
+                    getString(R.string.n9_menu)));
+        }
 
         mMainCalculator = findViewById(R.id.main_calculator);
         mModeView = findViewById(R.id.mode);
@@ -1041,6 +1056,7 @@ public class Calculator extends AppCompatActivity
     @Override
     public boolean onCreateOptionsMenu(Menu menu) {
         super.onCreateOptionsMenu(menu);
+        if (mEtesianToolbar) return true; // the menu is on the bottom toolbar
 
         getMenuInflater().inflate(R.menu.activity_calculator, menu);
         return true;
@@ -1049,6 +1065,8 @@ public class Calculator extends AppCompatActivity
     @Override
     public boolean onPrepareOptionsMenu(Menu menu) {
         super.onPrepareOptionsMenu(menu);
+        // Etesian: the top menu is empty when the menu is on the bottom toolbar (the N9 sheet prepares its own).
+        if (menu.findItem(R.id.menu_leading) == null) return false;
 
         // Show the leading option when displaying a result.
         menu.findItem(R.id.menu_leading).setVisible(mCurrentState == CalculatorState.RESULT);
