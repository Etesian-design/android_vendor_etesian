+        if (com.bompotis.etesian.toolbar.EtesianToolbar.isAvailable(this)) {
+            com.bompotis.etesian.toolbar.EtesianToolbar.of(this).setHidden(true).setItems(java.util.Collections.emptyList(), id -> { });
+        }
         mMainCalculator = findViewById(R.id.main_calculator);
         mModeView = findViewById(R.id.mode);
+        setupN9Buttons();
         mFormulaText = findViewById(R.id.formula);
         mDeleteButton = findViewById(R.id.del);
         mResultText = findViewById(R.id.result);
@@ -1041,14 +1073,14 @@ public class Calculator extends AppCompatActivity
