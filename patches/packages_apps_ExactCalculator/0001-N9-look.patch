@@ -302,6 +302,33 @@ public class Calculator extends AppCompatActivity
         }
     }
 
+    /** Etesian: the menu's actions as buttons in the display's top row. */
+    private TextView mN9Full, mN9Fraction;
+
+    private void setupN9Buttons() {
+        mN9Full = findViewById(R.id.n9_full);
+        mN9Fraction = findViewById(R.id.n9_fraction);
+        findViewById(R.id.n9_history).setOnClickListener(v -> mMainCalculator.transitionToEnd());
+        mN9Full.setOnClickListener(v -> displayFull());
+        mN9Fraction.setOnClickListener(v -> displayFraction());
+    }
+
+    /** Full result and Fraction show when the menu would have offered them. */
+    private void updateN9Buttons() {
+        if (mN9Full == null || mEvaluator == null) return;
+        final boolean result = mCurrentState == CalculatorState.RESULT;
+        final UnifiedReal mainResult = mEvaluator.getResult(Evaluator.MAIN_INDEX);
+        mN9Full.setVisibility(result ? View.VISIBLE : View.GONE);
+        mN9Fraction.setVisibility(result && mainResult != null && mainResult.exactlyDisplayable()
+                ? View.VISIBLE : View.GONE);
+    }
+
+    @Override
+    public void invalidateOptionsMenu() {
+        super.invalidateOptionsMenu();
+        updateN9Buttons();
+    }
+
     @Override
     protected void onCreate(Bundle savedInstanceState) {
         super.onCreate(savedInstanceState);
@@ -312,9 +339,14 @@ public class Calculator extends AppCompatActivity
 
