// Generated by vendor/etesian/n9-files/import.sh; holds the user's own N9 files.

runtime_resource_overlay {
    name: "FontNokiaPureOverlay",
    resource_dirs: ["overlay/res"],
    manifest: "overlay/AndroidManifest.xml",
    product_specific: true,
}

runtime_resource_overlay {
    name: "N9SoundsOverlay",
    resource_dirs: ["sounds-overlay/res"],
    manifest: "sounds-overlay/AndroidManifest.xml",
    product_specific: true,
}

// The "N9 icons" pack, generated by make-iconpack.sh (installed only when it has icons; see n9.mk).
android_app {
    name: "N9IconPack",
    resource_dirs: ["iconpack/res"],
    manifest: "iconpack/AndroidManifest.xml",
    sdk_version: "current",
    certificate: "platform",
    product_specific: true,
}
